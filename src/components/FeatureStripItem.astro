---
interface Props {
  title: string;
  subtitle: string;
  icon: "sparkles" | "clock" | "check" | "chat" | "pin" | "globe";
  class?: string;
}

const { title, subtitle, icon, class: className } = Astro.props;

const iconPaths = {
  sparkles: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
  clock: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  check: "M5 13l4 4L19 7",
  chat: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
  pin: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
  globe: "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
} as const;
---

<div class:list={["flex items-start gap-3 lg:px-6", className]}>
  <div class="trust-strip-item__icon-wrap shrink-0 w-9 h-9 rounded-full flex items-center justify-center mt-0.5">
    <svg class="trust-strip-item__icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[icon]} />
    </svg>
  </div>
  <div>
    <p class="text-sm font-semibold text-white leading-tight">{title}</p>
    <p class="trust-strip-item__subtitle text-xs mt-0.5">{subtitle}</p>
  </div>
</div>

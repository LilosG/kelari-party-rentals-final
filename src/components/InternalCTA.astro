---
interface Props {
  heading?: string;
  body?: string;
  buttonText?: string;
  buttonHref?: string;
  variant?: "primary" | "dark";
}

const {
  heading = "Ready to Plan Your Party?",
  body = "Get a free, no-obligation quote for your next event. We'll handle delivery, setup, and pickup — you enjoy the celebration.",
  buttonText = "Get a Free Quote",
  buttonHref = "/quote/",
  variant = "primary",
} = Astro.props;

const isDark = variant === "dark";
---

<section class={isDark ? "bg-brand-dark" : "bg-brand-pink"}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 text-center">
    <h2 class="font-display text-3xl md:text-[2.75rem] font-semibold text-white leading-tight">
      {heading}
    </h2>
    <p class="mt-4 text-lg text-white/90 max-w-2xl mx-auto">
      {body}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href={buttonHref}
        class={
          isDark
            ? "bg-brand-pink text-white font-semibold px-7 py-3.5 rounded-lg hover:bg-brand-pink-dark transition-colors"
            : "bg-white text-brand-pink font-semibold px-7 py-3.5 rounded-lg hover:bg-neutral-50 transition-colors"
        }
      >
        {buttonText}
      </a>
      <a
        href="tel:7600000000"
        class="border-2 border-white text-white font-semibold px-7 py-3.5 rounded-lg hover:bg-white/10 transition-colors"
      >
        (760) 000-0000
      </a>
    </div>
  </div>
</section>

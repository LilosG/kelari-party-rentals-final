---
export interface Props {
  bg?: "white" | "light" | "dark" | "pink-light";
  spacing?: "default" | "compact" | "featured" | "none";
  width?: "default" | "narrow" | "wide" | "full";
  id?: string;
  class?: string;
}

const {
  bg = "white",
  spacing = "default",
  width = "default",
  id,
  class: className,
} = Astro.props;

const bgClass = {
  white: "bg-white",
  light: "bg-[#fdf8f9]",
  dark: "bg-[#222222] text-white",
  "pink-light": "bg-brand-pink-light/20",
}[bg];

const spacingClass = {
  default: "py-12 lg:py-16",
  compact: "py-8 lg:py-10",
  featured: "py-14 lg:py-18",
  none: "py-0",
}[spacing];

const widthClass = {
  narrow: "max-w-4xl",
  default: "max-w-6xl",
  wide: "max-w-7xl",
  full: "max-w-none",
}[width];
---

<section id={id} class:list={[bgClass, spacingClass, className]}>
  <div class:list={["mx-auto px-4 sm:px-6 lg:px-8", widthClass]}>
    <slot />
  </div>
</section>

---
export interface Props {
  bg?: "white" | "light" | "dark" | "pink-light";
  spacing?: "default" | "compact" | "featured" | "none";
  width?: "default" | "narrow" | "wide" | "full";
  id?: string;
  class?: string;
}

const {
  bg = "white",
  spacing = "default",
  width = "default",
  id,
  class: className,
} = Astro.props;

const bgClass = {
  white: "bg-white",
  light: "bg-neutral-50",
  dark: "bg-[#222222] text-white",
  "pink-light": "bg-brand-pink-light/20",
}[bg];

const spacingClass = {
  default: "py-20 lg:py-28",
  compact: "py-12 lg:py-16",
  featured: "py-24 lg:py-32",
  none: "py-0",
}[spacing];

const widthClass = {
  narrow: "max-w-4xl",
  default: "max-w-6xl",
  wide: "max-w-7xl",
  full: "max-w-none",
}[width];
---

<section id={id} class:list={[bgClass, spacingClass, className]}>
  <div class:list={["mx-auto px-4 sm:px-6 lg:px-8", widthClass]}>
    <slot />
  </div>
</section>

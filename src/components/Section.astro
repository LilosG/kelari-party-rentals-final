---
export interface Props {
  bg?: "white" | "light" | "dark" | "pink-light" | "gradient";
  padding?: "default" | "compact" | "featured" | "none";
  spacing?: "default" | "compact" | "featured" | "none";
  width?: "default" | "narrow" | "wide" | "full";
  id?: string;
  class?: string;
  contentClass?: string;
}

const {
  bg = "white",
  padding,
  spacing = padding ?? "default",
  width = "default",
  id,
  class: className,
  contentClass,
} = Astro.props;

const bgClass = {
  white: "bg-white",
  light: "bg-neutral-50",
  dark: "bg-brand-dark text-white",
  "pink-light": "bg-brand-pink-light/20",
  gradient: "bg-linear-to-b from-white via-brand-pink-light/20 to-white",
}[bg];

const spacingClass = {
  default: "py-20 lg:py-28",
  compact: "py-14 lg:py-18",
  featured: "py-24 lg:py-32",
  none: "py-0",
}[spacing];

const widthClass = {
  narrow: "max-w-4xl",
  default: "max-w-6xl",
  wide: "max-w-7xl",
  full: "max-w-none",
}[width];
---

<section
  id={id}
  class:list={[bgClass, spacingClass, className]}
>
  <div class:list={["mx-auto px-4 sm:px-6 lg:px-8", widthClass, contentClass]}>
    <slot />
  </div>
</section>

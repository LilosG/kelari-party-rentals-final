---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface FAQ {
  question: string;
  answer: string;
}

export interface Props {
  faqs: FAQ[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "featured" | "none";
  /** @deprecated Use title */
  heading?: string;
  /** @deprecated Use eyebrow */
  overline?: string;
}

const {
  faqs,
  eyebrow,
  title,
  subtitle,
  bg = "white",
  padding = "default",
  heading,
  overline,
} = Astro.props;

const resolvedEyebrow = eyebrow ?? overline ?? "FAQs";
const resolvedTitle = title ?? heading ?? "Frequently Asked Questions";
const isDark = bg === "dark";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Section {bg} {padding}>
  <div class="max-w-3xl mx-auto">
    <div class="mb-10 md:mb-12">
      <SectionHeader
        eyebrow={resolvedEyebrow}
        title={resolvedTitle}
        {subtitle}
        dark={isDark}
      />
    </div>

    <div>
      {faqs.map((faq) => (
        <details class="group border-b border-neutral-200 py-5">
          <summary class:list={[
            "w-full flex justify-between items-center text-left font-semibold text-lg cursor-pointer hover:text-brand-pink transition-colors list-none [&::-webkit-details-marker]:hidden",
            isDark ? "text-white" : "text-neutral-800",
          ]}>
            <span>{faq.question}</span>
            <svg
              class:list={[
                "w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180",
                isDark ? "text-neutral-400" : "text-neutral-500",
              ]}
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class:list={[
            "leading-relaxed mt-3 pb-2",
            isDark ? "text-neutral-300" : "text-neutral-600",
          ]}>
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</Section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

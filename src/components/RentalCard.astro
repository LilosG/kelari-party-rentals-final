---
import { Image } from 'astro:assets';
import type { CategoryItem } from '../data/categories';

interface Props {
  item: CategoryItem;
  icon: string;
}

const { item, icon } = Astro.props;
---

<div class="bg-white rounded-2xl border border-neutral-200 shadow-sm p-6 flex flex-col">
  {item.image ? (
    <div class="aspect-[4/3] rounded-xl overflow-hidden mb-4 bg-white">
      <Image
        src={item.image}
        alt={item.name}
        width={400}
        height={300}
        class="w-full h-full object-contain"
      />
    </div>
  ) : (
    <div class="aspect-[4/3] rounded-xl bg-brand-pink-light mb-4 flex items-center justify-center">
      <span class="text-5xl" aria-hidden="true">{icon}</span>
    </div>
  )}
  <h3 class="font-display text-lg font-bold text-neutral-800">{item.name}</h3>
  <p class="mt-1.5 text-sm text-neutral-600 leading-relaxed flex-1">
    {item.description}
  </p>
  {(item.sizes && item.sizes.length > 0 || item.colors && item.colors.length > 0) && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {item.sizes && item.sizes.map((size) => (
        <span class="text-xs px-2.5 py-1 bg-brand-pink-light text-brand-pink rounded-full font-medium border border-brand-pink/20">
          {size}
        </span>
      ))}
      {item.colors && item.colors.map((color) => (
        <span class="text-xs px-2.5 py-1 bg-neutral-100 text-neutral-600 rounded-full font-medium border border-neutral-200">
          {color}
        </span>
      ))}
    </div>
  )}
  {item.bookingUrl && (
    <a
      href={item.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center justify-center gap-1.5 w-full rounded-xl bg-brand-pink px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-pink/90 transition-colors duration-200"
    >
      Book Now
      <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true" class="flex-shrink-0">
        <path d="M2 9L9 2M9 2H4.5M9 2V6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  )}
</div>

---
interface Props {
  heading?: string;
  body?: string;
  buttonText?: string;
  buttonHref?: string;
  variant?: "primary" | "dark";
}

const {
  heading = "Ready to Plan Your Party?",
  body = "Get a free, no-obligation quote for your next event. We'll handle delivery, setup, and pickup — you enjoy the celebration.",
  buttonText = "Get a Free Quote",
  buttonHref = "/quote/",
  variant = "primary",
} = Astro.props;

const isDark = variant === "dark";
---

<section class:list={["py-16 md:py-20", isDark ? "bg-[#222222]" : "bg-brand-pink"]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-display font-bold text-3xl md:text-4xl text-white leading-tight">
      {heading}
    </h2>
    <p class="mt-4 text-lg text-white/90 max-w-2xl mx-auto leading-relaxed">
      {body}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href={buttonHref}
        class:list={[
          "inline-flex items-center justify-center font-semibold px-7 py-3.5 rounded-lg transition-colors",
          isDark
            ? "bg-brand-pink text-white hover:bg-brand-pink-dark"
            : "bg-white text-brand-pink hover:bg-neutral-50",
        ]}
      >
        {buttonText}
      </a>
      <a
        href="tel:7600000000"
        class="inline-flex items-center justify-center border-2 border-white text-white font-semibold px-7 py-3.5 rounded-lg hover:bg-white/10 transition-colors"
      >
        (760) 000-0000
      </a>
    </div>
  </div>
</section>

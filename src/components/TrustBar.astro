---
import { nap } from "../data/site";

export interface Props {
  address?: string;
  phone?: string;
  phoneHref?: string;
  hours?: string;
  deliveryBadge?: string;
  variant?: "light" | "dark";
}

const {
  address,
  phone,
  phoneHref,
  hours,
  deliveryBadge = "Free Delivery & Setup",
  variant = "light",
} = Astro.props;

const isDark = variant === "dark";

const resolvedPhone = phone ?? nap.contact.phone;
const resolvedPhoneHref = phoneHref ?? `tel:${(phone ?? nap.contact.phone).replace(/\D/g, "")}`;

const items = [
  {
    path: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
    label: address ?? nap.address.full,
  },
  {
    path: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
    label: resolvedPhone,
    href: resolvedPhoneHref,
  },
  {
    path: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    label: hours ?? nap.contact.hours,
  },
  {
    path: "M5 13l4 4L19 7",
    label: deliveryBadge,
  },
];
---

<div style="background: #1a1a1a; border-bottom: 1px solid rgba(255,255,255,0.05);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <div class="flex flex-wrap justify-center gap-2">
      {items.map((item) => (
        <div class="flex items-center gap-2 px-4 py-1.5 rounded-full" style="border: 1px solid rgba(255,255,255,0.10); background: rgba(255,255,255,0.05);">
          <svg class="w-3.5 h-3.5 shrink-0" style="color: #E8356D;" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.path} />
          </svg>
          {item.href ? (
            <a href={item.href} class="text-xs font-medium transition-colors hover:text-white" style="color: rgba(255,255,255,0.70);">
              {item.label}
            </a>
          ) : (
            <span class="text-xs font-medium" style="color: rgba(255,255,255,0.70);">
              {item.label}
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

---
import { cities, type City } from "../data/cities";

interface Props {
  currentSlug?: string;
  serviceSlug?: string;
  heading?: string;
  overline?: string;
}

const {
  currentSlug,
  serviceSlug,
  heading = "We Also Serve",
  overline = "Nearby Cities",
} = Astro.props;

const relatedCities: City[] = currentSlug
  ? cities.filter((c) => c.slug !== currentSlug)
  : cities;

function getHref(city: City): string {
  if (serviceSlug) {
    return `/${city.slug}/${serviceSlug}/`;
  }
  return `/${city.slug}/`;
}
---

<section class="section-padding bg-neutral-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 md:mb-12">
      <span class="overline">{overline}</span>
      <h2 class="section-heading">{heading}</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {relatedCities.map((city) => (
        <a
          href={getHref(city)}
          class="bg-white border border-neutral-200 rounded-2xl p-6 text-center hover:border-brand-pink hover:shadow-[0_8px_40px_rgba(255,111,156,0.18)] transition-all duration-300 group"
        >
          <h3 class="text-lg font-bold text-neutral-800 group-hover:text-brand-pink transition-colors font-display">
            {city.name}
          </h3>
          <p class="mt-1.5 text-sm text-neutral-500">
            {serviceSlug ? `${city.name} rentals` : `Party rentals in ${city.name}`}
          </p>
          <span class="inline-block mt-3 text-sm font-semibold text-brand-pink group-hover:text-brand-pink-dark transition-colors">
            View {city.name} &rarr;
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

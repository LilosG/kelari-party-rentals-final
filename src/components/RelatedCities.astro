---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import { cities, type City } from "../data/cities";

interface Props {
  currentSlug?: string;
  serviceSlug?: string;
  heading?: string;
  overline?: string;
}

const {
  currentSlug,
  serviceSlug,
  heading = "We Also Serve",
  overline = "Nearby Cities",
} = Astro.props;

const relatedCities: City[] = currentSlug
  ? cities.filter((c) => c.slug !== currentSlug)
  : cities;

function getHref(city: City): string {
  return serviceSlug ? `/${city.slug}/${serviceSlug}/` : `/${city.slug}/`;
}
---

<Section bg="light" spacing="compact" width="wide">
  <div class="mb-8">
    <SectionHeader eyebrow={overline} title={heading} />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {relatedCities.map((city) => (
      <a
        href={getHref(city)}
        class="group flex items-center justify-between gap-3 rounded-2xl border border-neutral-100 bg-white px-5 py-4 shadow-sm hover:border-brand-pink hover:shadow-md transition-all duration-200"
      >
        <div>
          <h3 class="font-display font-bold text-base text-neutral-900 group-hover:text-brand-pink transition-colors">
            {city.name}
          </h3>
          <p class="text-sm text-neutral-500 mt-0.5">
            {serviceSlug ? `${city.name} rentals` : `Party rentals in ${city.name}`}
          </p>
        </div>
        <span class="text-brand-pink shrink-0 group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
      </a>
    ))}
  </div>
</Section>

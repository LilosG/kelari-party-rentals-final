---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: "brand" | "brand-soft" | "outline-light";
  size?: "sm" | "md";
  pill?: boolean;
  class?: string;
  target?: string;
  rel?: string;
}

const {
  href,
  type = "button",
  variant = "brand",
  size = "md",
  pill = false,
  class: className,
  target,
  rel,
} = Astro.props;

const classes = [
  "btn",
  size === "sm" ? "btn--sm" : "btn--md",
  pill ? "btn--pill" : "",
  variant === "brand" ? "btn--brand" : variant === "brand-soft" ? "btn--brand-soft" : "btn--outline-light",
  className,
];
---

{href ? (
  <a href={href} class:list={classes} target={target} rel={rel}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes}>
    <slot />
  </button>
)}

---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface IncludedItem {
  icon: string;
  title: string;
  description: string;
}

export interface Props {
  items: IncludedItem[];
  columns?: 2 | 3 | 4;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "featured" | "none";
}

const { items, columns = 3, eyebrow, title, subtitle, bg = "light", padding = "default" } = Astro.props;
const isDark = bg === "dark";

const colClass = {
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
}[columns];
---

<Section {bg} spacing={padding} width="wide">
  {(title || eyebrow) && (
    <div class="mb-12 md:mb-16">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} width="wide" />
    </div>
  )}

  <div class={`grid gap-6 ${colClass}`}>
    {items.map((item) => (
      <div class:list={[
        "rounded-2xl p-6 border transition-shadow duration-300",
        isDark
          ? "bg-white/5 border-white/10 hover:bg-white/8"
          : "bg-white border-neutral-100 shadow-sm hover:shadow-md",
      ]}>
        <div class:list={[
          "w-14 h-14 rounded-full flex items-center justify-center text-2xl mb-5",
          isDark ? "bg-white/10" : "bg-brand-pink-light/50",
        ]} aria-hidden="true">
          {item.icon}
        </div>
        <h3 class:list={["font-display font-bold text-lg", isDark ? "text-white" : "text-neutral-900"]}>
          {item.title}
        </h3>
        <p class:list={["text-sm mt-2 leading-relaxed", isDark ? "text-neutral-300" : "text-neutral-600"]}>
          {item.description}
        </p>
      </div>
    ))}
  </div>
</Section>

---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface IncludedItem {
  icon: string;
  title: string;
  description: string;
}

export interface Props {
  items: IncludedItem[];
  columns?: 2 | 3 | 4;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "featured" | "none";
}

const {
  items,
  columns = 3,
  eyebrow,
  title,
  subtitle,
  bg = "light",
  padding = "default",
} = Astro.props;

const isDark = bg === "dark";

const colClass = {
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
}[columns];
---

<Section {bg} spacing={padding} width="wide">
  {(title || eyebrow) && (
    <div class="mb-10 md:mb-14">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} width="wide" />
    </div>
  )}

  <div class={`grid gap-6 ${colClass}`}>
    {items.map((item) => (
      <div class:list={["card-surface", isDark && "card-surface-dark"]}>
        <div class="card-body">
          <div class="info-card-icon" aria-hidden="true">
            <span>{item.icon}</span>
          </div>
          <h3 class:list={["card-title text-lg", isDark && "text-white"]}>{item.title}</h3>
          <p class:list={["card-copy card-copy-compact", isDark && "text-neutral-300"]}>
            {item.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</Section>

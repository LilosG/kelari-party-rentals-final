---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface IncludedItem {
  icon: string;
  title: string;
  description: string;
}

export interface Props {
  items: IncludedItem[];
  columns?: 2 | 3 | 4;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "none";
}

const {
  items,
  columns = 3,
  eyebrow,
  title,
  subtitle,
  bg = "light",
  padding = "default",
} = Astro.props;

const isDark = bg === "dark";

const colClass = {
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
}[columns];
---

<Section {bg} {padding}>
  {(title || eyebrow) && (
    <div class="mb-10 md:mb-14">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} />
    </div>
  )}

  <div class={`grid gap-6 ${colClass}`}>
    {items.map((item) => (
      <div class:list={[
        "rounded-2xl p-6 border shadow-sm",
        isDark
          ? "bg-white/5 border-white/10"
          : "bg-white border-neutral-100",
      ]}>
        <div class="w-14 h-14 rounded-full bg-brand-pink-light flex items-center justify-center mb-4">
          <span class="text-2xl" aria-hidden="true">{item.icon}</span>
        </div>
        <h3 class:list={[
          "font-semibold text-lg",
          isDark ? "text-white" : "text-neutral-800",
        ]}>
          {item.title}
        </h3>
        <p class:list={[
          "text-sm mt-2 leading-relaxed",
          isDark ? "text-neutral-300" : "text-neutral-600",
        ]}>
          {item.description}
        </p>
      </div>
    ))}
  </div>
</Section>

---
import { nap } from "../data/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const mapsEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(`${nap.name}, ${nap.address.city}, ${nap.address.state}`)}&output=embed&z=15`;
---

<div class:list={[className]}>
  <div class="aspect-[4/3] overflow-hidden rounded-2xl border border-neutral-200 shadow-sm">
    <iframe
      src={mapsEmbedSrc}
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title={`Map showing ${nap.name} location in ${nap.address.city}`}
    ></iframe>
  </div>
  <p class="mt-3 text-center text-sm text-neutral-500">
    {nap.address.full}
  </p>
</div>

---
import ContactMetadata from "./ContactMetadata.astro";
import ConversionProofPoints from "./ConversionProofPoints.astro";
import { contactMetaItems, conversionProofPoints } from "../data/conversion";

interface Props {
  heading?: string;
  subheading?: string;
  overline?: string;
  city?: string;
  service?: string;
  variant?: "light" | "dark";
}

const {
  heading = "Get a Free Quote",
  subheading = "Tell us about your event and we'll put together a custom rental package — no obligation.",
  overline = "Start Here",
  city,
  service,
  variant = "dark",
} = Astro.props;

const isDark = variant === "dark";
const priorityContactItems = contactMetaItems.filter(({ label }) => ["Phone", "Email", "Hours"].includes(label));
---

<section id="quote-form" class={`section-padding relative overflow-hidden ${isDark ? "bg-brand-dark" : ""}`}>
  {isDark && (
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute top-0 right-0 h-[600px] w-[600px] -translate-y-1/2 translate-x-1/3 rounded-full bg-brand-pink/5 blur-[100px]"></div>
    </div>
  )}

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class={isDark ? "grid gap-12 lg:grid-cols-2 lg:gap-20" : "mx-auto max-w-4xl"}>
      {isDark && (
        <div class="flex flex-col justify-center">
          <span class="overline mb-3">{overline}</span>
          <h2 class="section-title mb-5 text-white">
            {heading}
          </h2>
          <p class="lead-paragraph mb-8 max-w-[420px] text-white/75">
            {subheading}
          </p>

          <ConversionProofPoints items={conversionProofPoints.slice(0, 2)} surface="dark" compact={true} />

          <div class="mt-6">
            <ContactMetadata items={priorityContactItems} surface="dark" showDescriptions={false} />
          </div>
        </div>
      )}

      <div>
        {!isDark && (
          <div class="mb-10 text-center md:mb-12">
            <span class="overline mb-3">{overline}</span>
            <h2 class="heading-section">{heading}</h2>
            <p class="lead-paragraph mt-3 text-neutral-500">{subheading}</p>
          </div>
        )}

        <form
          class="rounded-[var(--radius-card)] bg-white card-padding shadow-[var(--shadow-card)]"
          method="POST"
          action="/api/quote"
          data-city={city}
          data-service={service}
        >
          {isDark && (
            <h3 class="mb-6 font-display text-xl font-semibold text-neutral-800">Request a Quote</h3>
          )}

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="quote-name" class="form-label">
                Full Name <span class="text-brand-pink">*</span>
              </label>
              <input
                type="text"
                id="quote-name"
                name="name"
                required
                autocomplete="name"
                class="form-input"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="quote-phone" class="form-label">
                Phone <span class="text-brand-pink">*</span>
              </label>
              <input
                type="tel"
                id="quote-phone"
                name="phone"
                required
                autocomplete="tel"
                class="form-input"
                placeholder="(760) 000-0000"
              />
            </div>
            <div>
              <label for="quote-email" class="form-label">
                Email <span class="text-brand-pink">*</span>
              </label>
              <input
                type="email"
                id="quote-email"
                name="email"
                required
                autocomplete="email"
                class="form-input"
                placeholder="you@email.com"
              />
            </div>
            <div>
              <label for="quote-date" class="form-label">
                Event Date <span class="text-brand-pink">*</span>
              </label>
              <input
                type="date"
                id="quote-date"
                name="event_date"
                required
                class="form-input"
              />
            </div>
          </div>

          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
              <label for="quote-event-type" class="form-label">
                Event Type
              </label>
              <select
                id="quote-event-type"
                name="event_type"
                class="form-select bg-white"
              >
                <option value="">Select event type</option>
                <option value="birthday">Birthday Party</option>
                <option value="baby-shower">Baby Shower</option>
                <option value="graduation">Graduation Party</option>
                <option value="engagement">Engagement Party</option>
                <option value="backyard">Backyard Party</option>
                <option value="park">Park Party</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="quote-guests" class="form-label">
                Estimated Guests
              </label>
              <select
                id="quote-guests"
                name="guest_count"
                class="form-select bg-white"
              >
                <option value="">Select range</option>
                <option value="1-20">1–20 guests</option>
                <option value="21-50">21–50 guests</option>
                <option value="51-100">51–100 guests</option>
                <option value="100+">100+ guests</option>
              </select>
            </div>
          </div>

          <div class="mt-4">
            <label for="quote-message" class="form-label">
              Tell us about your event
            </label>
            <textarea
              id="quote-message"
              name="message"
              rows="4"
              class="form-textarea"
              placeholder="What items are you looking for? Any special requests?"
            ></textarea>
          </div>

          {city && <input type="hidden" name="city" value={city} />}
          {service && <input type="hidden" name="service" value={service} />}

          <button type="submit" class="mt-4 flex w-full gap-2 py-[14px] text-base font-bold btn-primary">
            Request My Free Quote
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </button>

          <p class="mt-2 text-center font-body text-xs text-neutral-500">
            We respond within 2 hours during business hours. No spam, ever.
          </p>
        </form>

        {!isDark && (
          <div class="mt-6">
            <ConversionProofPoints items={conversionProofPoints} compact={false} />
          </div>
        )}
      </div>
    </div>
  </div>
</section>

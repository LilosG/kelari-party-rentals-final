---
import ContactMetadata from "./ContactMetadata.astro";
import ConversionProofPoints from "./ConversionProofPoints.astro";
import { contactMetaItems, conversionProofPoints } from "../data/conversion";

interface Props {
  heading?: string;
  subheading?: string;
  overline?: string;
  city?: string;
  service?: string;
  variant?: "light" | "dark";
}

const {
  heading = "Get a Free Quote",
  subheading = "Tell us about your event and we'll put together a custom rental package — no obligation.",
  overline = "Start Here",
  city,
  service,
  variant = "dark",
} = Astro.props;

const isDark = variant === "dark";
const priorityContactItems = contactMetaItems.filter(({ label }) => ["Phone", "Email", "Hours"].includes(label));
---

<section id="quote-form" class:list={["py-20 lg:py-28 relative overflow-hidden", isDark ? "bg-brand-dark quote-form--dark" : "bg-[--color-soft-bg]"]}>
  {isDark && (
    <div class="absolute top-0 right-0 h-[500px] w-[500px] -translate-y-1/2 translate-x-1/3 rounded-full bg-brand-pink/5 blur-[80px] pointer-events-none" aria-hidden="true"></div>
  )}

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class:list={[isDark ? "grid gap-12 lg:grid-cols-2 lg:gap-20" : "mx-auto max-w-3xl"]}>

      {isDark && (
        <div class="flex flex-col justify-center">
          <p class="font-body uppercase tracking-widest text-xs font-bold text-brand-pink mb-4">{overline}</p>
          <h2 class="font-display font-bold text-4xl md:text-5xl text-white leading-tight mb-5">{heading}</h2>
          <p class="text-lg leading-relaxed text-neutral-300 max-w-sm mb-8">{subheading}</p>
          <ConversionProofPoints items={conversionProofPoints.slice(0, 2)} surface="dark" compact={true} />
          <div class="mt-6">
            <ContactMetadata items={priorityContactItems} surface="dark" showDescriptions={false} />
          </div>
        </div>
      )}

      <div>
        {!isDark && (
          <div class="mb-10 text-center">
            <p class="font-body uppercase tracking-widest text-xs font-bold text-brand-pink mb-3">{overline}</p>
            <h2 class="font-display font-bold text-4xl text-white leading-tight">{heading}</h2>
            <p class="mt-3 text-lg text-neutral-200 leading-relaxed">{subheading}</p>
          </div>
        )}

        <div class:list={["rounded-2xl p-8", isDark ? "bg-white/[0.06] border border-white/10" : "bg-white border border-neutral-100 shadow-sm"]}>
          {isDark && (
            <h3 class="font-display text-xl font-bold text-white mb-6">Request a Quote</h3>
          )}

          <form method="POST" action="https://api.staticforms.xyz/submit" class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="quote-name" class:list={["form-label", isDark ? "text-neutral-200" : ""]}>Full Name <span class="text-brand-pink">*</span></label>
                <input type="text" id="quote-name" name="name" required autocomplete="name" class:list={[isDark ? "form-input form-input-dark" : "form-input"]} placeholder="Your name" />
              </div>
              <div>
                <label for="quote-phone" class:list={["form-label", isDark ? "text-neutral-200" : ""]}>Phone <span class="text-brand-pink">*</span></label>
                <input type="tel" id="quote-phone" name="phone" required autocomplete="tel" class:list={[isDark ? "form-input form-input-dark" : "form-input"]} placeholder="(760) 000-0000" />
              </div>
              <div>
                <label for="quote-email" class:list={["form-label", isDark ? "text-neutral-200" : ""]}>Email <span class="text-brand-pink">*</span></label>
                <input type="email" id="quote-email" name="email" required autocomplete="email" class:list={[isDark ? "form-input form-input-dark" : "form-input"]} placeholder="you@email.com" />
              </div>
              <div>
                <label for="quote-date" class:list={["form-label", isDark ? "text-neutral-200" : ""]}>Event Date <span class="text-brand-pink">*</span></label>
                <input type="date" id="quote-date" name="event_date" required class:list={[isDark ? "form-input form-input-dark" : "form-input"]} />
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="quote-event-type" class:list={["form-label", isDark ? "text-neutral-200" : ""]}>Event Type</label>
                <select id="quote-event-type" name="event_type" class:list={[isDark ? "form-input form-input-dark" : "form-select"]}>
                  <option value="">Select event type</option>
                  <option value="birthday">Birthday Party</option>
                  <option value="baby-shower">Baby Shower</option>
                  <option value="graduation">Graduation Party</option>
                  <option value="engagement">Engagement Party</option>
                  <option value="backyard">Backyard Party</option>
                  <option value="park">Park Party</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label for="quote-guests" class:list={["form-label", isDark ? "text-neutral-200" : ""]}>Estimated Guests</label>
                <select id="quote-guests" name="guest_count" class:list={[isDark ? "form-input form-input-dark" : "form-select"]}>
                  <option value="">Select range</option>
                  <option value="1-20">1–20 guests</option>
                  <option value="21-50">21–50 guests</option>
                  <option value="51-100">51–100 guests</option>
                  <option value="100+">100+ guests</option>
                </select>
              </div>
            </div>

            <div>
              <label for="quote-message" class:list={["form-label", isDark ? "text-neutral-200" : ""]}>Tell us about your event</label>
              <textarea id="quote-message" name="message" rows="4" class:list={[isDark ? "form-input form-input-dark" : "form-textarea"]} placeholder="What items are you looking for? Any special requests?"></textarea>
            </div>

            {city && <input type="hidden" name="city" value={city} />}
            {service && <input type="hidden" name="service" value={service} />}
            <input type="hidden" name="accessKey" value="sf_7941a8e0435764d2be4a9381" />
            <input type="hidden" name="redirectTo" value="https://kelaripartyrentals.com/thank-you/" />
            <input type="text" name="honeypot" style="display:none" />

            <button type="submit" class="btn btn--brand btn--md w-full justify-center py-4">
              Request My Free Quote
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </button>
            <p class:list={["text-center text-xs font-body", isDark ? "text-neutral-400" : "text-neutral-400"]}>We respond within 2 hours during business hours. No spam, ever.</p>
          </form>
        </div>

        {!isDark && (
          <div class="mt-6">
            <ConversionProofPoints items={conversionProofPoints} compact={false} />
          </div>
        )}
      </div>
    </div>
  </div>
</section>

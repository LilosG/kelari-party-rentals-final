---
export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
  breadcrumbs?: { label: string; href: string }[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  eyebrow?: string;
  trustItems?: string[];
  /** @deprecated Use title instead */
  headline?: string;
  /** @deprecated Use subtitle instead */
  subheadline?: string;
  /** @deprecated Use backgroundImage instead */
  bgImage?: string;
  /** @deprecated Pass breadcrumbs directly */
  city?: string;
  /** @deprecated Pass breadcrumbs directly */
  service?: string;
}

const {
  title,
  subtitle,
  backgroundImage,
  breadcrumbs: breadcrumbsProp,
  primaryCta,
  secondaryCta,
  eyebrow,
  trustItems = [],
  headline,
  subheadline,
  bgImage,
  city,
  service,
} = Astro.props;

const resolvedTitle = title ?? headline ?? "";
const resolvedSubtitle = subtitle ?? subheadline ?? "";
const resolvedImage = backgroundImage ?? bgImage ?? "/images/hero-party.jpg";

const resolvedBreadcrumbs: { label: string; href: string }[] =
  breadcrumbsProp ??
  (() => {
    const crumbs: { label: string; href: string }[] = [{ label: "Home", href: "/" }];
    if (city) {
      crumbs.push({
        label: city,
        href: `/${city.toLowerCase().replace(/\s+/g, "-")}/`,
      });
    }
    if (service) {
      const serviceSlug = service.toLowerCase().replace(/\s+/g, "-");
      crumbs.push({
        label: service,
        href: city
          ? `/${city.toLowerCase().replace(/\s+/g, "-")}/${serviceSlug}/`
          : `/services/${serviceSlug}/`,
      });
    }
    return crumbs.length > 1 ? crumbs : [];
  })();

const resolvedPrimaryCta = primaryCta ?? {
  label: "Get a Free Quote",
  href: "/quote/",
};
const resolvedSecondaryCta = secondaryCta ?? {
  label: "(760) 000-0000",
  href: "tel:7600000000",
};
---

<section class="relative isolate overflow-hidden min-h-[580px] lg:min-h-[680px] flex items-center">
  <img
    src={resolvedImage}
    alt=""
    width="1600"
    height="900"
    class="absolute inset-0 h-full w-full object-cover"
    aria-hidden="true"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/55 to-black/20"></div>

  <div class="relative z-10 w-full">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-2xl">

        {resolvedBreadcrumbs.length > 0 && (
          <nav class="mb-6" aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/70">
              {resolvedBreadcrumbs.map((crumb, i) => (
                <li class="flex items-center gap-2">
                  {i > 0 && <span class="text-white/40" aria-hidden="true">/</span>}
                  {i === resolvedBreadcrumbs.length - 1 ? (
                    <span class="text-white/90" aria-current="page">{crumb.label}</span>
                  ) : (
                    <a href={crumb.href} class="hover:text-white transition-colors">{crumb.label}</a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}

        {eyebrow && (
          <p class="font-body uppercase tracking-widest text-xs font-bold text-brand-pink-light mb-5">
            {eyebrow}
          </p>
        )}

        {trustItems.length > 0 && (
          <ul class="flex flex-wrap gap-2.5 mb-6">
            {trustItems.map((item) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/20 px-3.5 py-1.5 text-sm text-white/90 backdrop-blur-sm">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-pink" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        )}

        <h1 class="font-display font-bold text-white leading-tight tracking-tight text-[2.6rem] sm:text-[3.2rem] lg:text-[4rem] xl:text-[4.4rem]" style="text-shadow: 0 2px 20px rgba(0,0,0,0.4);">
          {resolvedTitle}
        </h1>

        {resolvedSubtitle && (
          <p class="mt-6 text-lg text-white/90 leading-relaxed max-w-xl" style="text-shadow: 0 1px 8px rgba(0,0,0,0.3);">
            {resolvedSubtitle}
          </p>
        )}

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={resolvedPrimaryCta.href}
            class="inline-flex items-center justify-center gap-2 bg-brand-pink hover:bg-brand-pink-dark text-white font-semibold px-8 py-4 rounded-lg text-base shadow-lg hover:shadow-xl transition-all duration-300"
          >
            {resolvedPrimaryCta.label}
          </a>
          <a
            href={resolvedSecondaryCta.href}
            class="inline-flex items-center justify-center gap-2 border-2 border-white/80 text-white hover:bg-white hover:text-neutral-900 font-semibold px-8 py-4 rounded-lg text-base transition-all duration-300"
          >
            {resolvedSecondaryCta.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

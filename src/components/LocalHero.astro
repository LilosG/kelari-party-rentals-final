---
export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
  breadcrumbs?: { label: string; href: string }[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  eyebrow?: string;
  trustItems?: string[];
  /** @deprecated Use title instead */
  headline?: string;
  /** @deprecated Use subtitle instead */
  subheadline?: string;
  /** @deprecated Use backgroundImage instead */
  bgImage?: string;
  /** @deprecated Pass breadcrumbs directly */
  city?: string;
  /** @deprecated Pass breadcrumbs directly */
  service?: string;
}

const {
  title,
  subtitle,
  backgroundImage,
  breadcrumbs: breadcrumbsProp,
  primaryCta,
  secondaryCta,
  eyebrow,
  trustItems = [],
  headline,
  subheadline,
  bgImage,
  city,
  service,
} = Astro.props;

const resolvedTitle = title ?? headline ?? "";
const resolvedSubtitle = subtitle ?? subheadline ?? "";
const resolvedImage = backgroundImage ?? bgImage ?? "/images/hero-party.jpg";

const resolvedBreadcrumbs: { label: string; href: string }[] =
  breadcrumbsProp ??
  (() => {
    const crumbs: { label: string; href: string }[] = [{ label: "Home", href: "/" }];
    if (city) {
      crumbs.push({
        label: city,
        href: `/${city.toLowerCase().replace(/\s+/g, "-")}/`,
      });
    }
    if (service) {
      const serviceSlug = service.toLowerCase().replace(/\s+/g, "-");
      crumbs.push({
        label: service,
        href: city
          ? `/${city.toLowerCase().replace(/\s+/g, "-")}/${serviceSlug}/`
          : `/services/${serviceSlug}/`,
      });
    }
    return crumbs.length > 1 ? crumbs : [];
  })();

const resolvedPrimaryCta = primaryCta ?? {
  label: "Get a Free Quote",
  href: "/quote/",
};
const resolvedSecondaryCta = secondaryCta ?? {
  label: "(760) 000-0000",
  href: "tel:7600000000",
};
---

<section class="relative isolate overflow-hidden flex items-center" style="min-height: 600px;">
  <img
    src={resolvedImage}
    alt=""
    width="1600"
    height="900"
    class="absolute inset-0 h-full w-full object-cover"
    aria-hidden="true"
  />
  <!-- Warm atmospheric overlay -->
  <div class="absolute inset-0" style="background: linear-gradient(105deg, rgba(15,10,20,0.82) 0%, rgba(15,10,20,0.65) 55%, rgba(15,10,20,0.3) 100%);"></div>
  <!-- Pink radial glow top-left -->
  <div class="absolute -top-24 -left-24 w-[480px] h-[480px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(232,53,109,0.18) 0%, transparent 70%);"></div>

  <div class="relative z-10 w-full">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-2xl">

        {resolvedBreadcrumbs.length > 0 && (
          <nav class="mb-6" aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/70">
              {resolvedBreadcrumbs.map((crumb, i) => (
                <li class="flex items-center gap-2">
                  {i > 0 && <span class="text-white/40" aria-hidden="true">/</span>}
                  {i === resolvedBreadcrumbs.length - 1 ? (
                    <span class="text-white/90" aria-current="page">{crumb.label}</span>
                  ) : (
                    <a href={crumb.href} class="hover:text-white transition-colors">{crumb.label}</a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}

        {eyebrow && (
          <p class="font-body uppercase tracking-[0.2em] text-[0.7rem] font-bold text-brand-pink-light mb-5">
            {eyebrow}
          </p>
        )}

        {trustItems.length > 0 && (
          <ul class="flex flex-wrap gap-2.5 mb-6">
            {trustItems.map((item) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/20 px-3.5 py-1.5 text-sm text-white/90 backdrop-blur-sm">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-pink" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        )}

        <h1 class="font-display font-bold text-white leading-[1.05] tracking-tight text-[2.8rem] sm:text-[3.4rem] lg:text-[4.4rem] xl:text-[5rem] max-w-[14ch]" style="text-shadow: 0 2px 24px rgba(0,0,0,0.5);">
          {resolvedTitle}
        </h1>

        {resolvedSubtitle && (
          <p class="mt-6 text-lg text-white/80 leading-relaxed max-w-xl" style="text-shadow: 0 1px 8px rgba(0,0,0,0.3);">
            {resolvedSubtitle}
          </p>
        )}

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={resolvedPrimaryCta.href}
            class="inline-flex items-center justify-center gap-2 text-white font-semibold px-8 py-4 rounded-full text-base transition-all duration-300"
            style="background: #E8356D; box-shadow: 0 8px 28px rgba(232,53,109,0.45);"
          >
            {resolvedPrimaryCta.label}
          </a>
          <a
            href={resolvedSecondaryCta.href}
            class="inline-flex items-center justify-center gap-2 border-2 border-white/80 text-white hover:bg-white hover:text-neutral-900 font-semibold px-8 py-4 rounded-full text-base transition-all duration-300"
          >
            {resolvedSecondaryCta.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

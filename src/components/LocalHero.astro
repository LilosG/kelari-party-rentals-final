---
export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
  breadcrumbs?: { label: string; href: string }[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  eyebrow?: string;
  trustItems?: string[];
  /** @deprecated Use title instead */
  headline?: string;
  /** @deprecated Use subtitle instead */
  subheadline?: string;
  /** @deprecated Use backgroundImage instead */
  bgImage?: string;
  /** @deprecated Pass breadcrumbs directly */
  city?: string;
  /** @deprecated Pass breadcrumbs directly */
  service?: string;
}

const {
  title,
  subtitle,
  backgroundImage,
  breadcrumbs: breadcrumbsProp,
  primaryCta,
  secondaryCta,
  eyebrow,
  trustItems = [],
  headline,
  subheadline,
  bgImage,
  city,
  service,
} = Astro.props;

const resolvedTitle = title ?? headline ?? "";
const resolvedSubtitle = subtitle ?? subheadline ?? "";
const resolvedImage = backgroundImage ?? bgImage ?? "/images/hero-party.jpg";

const resolvedBreadcrumbs: { label: string; href: string }[] =
  breadcrumbsProp ??
  (() => {
    const crumbs: { label: string; href: string }[] = [{ label: "Home", href: "/" }];
    if (city) {
      crumbs.push({
        label: city,
        href: `/${city.toLowerCase().replace(/\s+/g, "-")}/`,
      });
    }
    if (service) {
      const serviceSlug = service.toLowerCase().replace(/\s+/g, "-");
      crumbs.push({
        label: service,
        href: city
          ? `/${city.toLowerCase().replace(/\s+/g, "-")}/${serviceSlug}/`
          : `/services/${serviceSlug}/`,
      });
    }
    return crumbs.length > 1 ? crumbs : [];
  })();

const resolvedPrimaryCta = primaryCta ?? {
  label: "Get a Free Quote",
  href: "/quote/",
};
const resolvedSecondaryCta = secondaryCta ?? {
  label: "(760) 000-0000",
  href: "tel:7600000000",
};
---

<section class="relative isolate overflow-hidden min-h-[640px] lg:min-h-[760px] flex items-center bg-brand-dark">
  <img
    src={resolvedImage}
    alt=""
    width="1200"
    height="900"
    class="absolute inset-0 h-full w-full object-cover"
    aria-hidden="true"
  />
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_14%_20%,rgba(255,182,217,0.2),transparent_35%),linear-gradient(103deg,rgba(20,20,20,0.82)_8%,rgba(20,20,20,0.66)_40%,rgba(20,20,20,0.42)_64%,rgba(20,20,20,0.22)_100%)]"></div>
  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.03)_0%,rgba(255,255,255,0)_22%,rgba(0,0,0,0.3)_100%)]"></div>

  <div class="relative z-10 w-full">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 md:py-28 lg:py-32">
      <div class="max-w-3xl lg:max-w-[46rem]">
        {resolvedBreadcrumbs.length > 0 && (
          <nav class="mb-6" aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/70">
              {resolvedBreadcrumbs.map((crumb, i) => (
                <li class="flex items-center gap-2">
                  {i > 0 && <span class="text-white/35" aria-hidden="true">/</span>}
                  {i === resolvedBreadcrumbs.length - 1 ? (
                    <span class="text-white" aria-current="page">{crumb.label}</span>
                  ) : (
                    <a href={crumb.href} class="transition-colors hover:text-white text-white/75">
                      {crumb.label}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}

        {(eyebrow || trustItems.length > 0) && (
          <div class="mb-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            {eyebrow && (
              <span class="inline-flex w-fit items-center rounded-full border border-white/18 bg-white/10 px-4 py-2 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-white/92 backdrop-blur-sm">
                {eyebrow}
              </span>
            )}
            {trustItems.length > 0 && (
              <ul class="flex flex-wrap gap-2.5 text-sm text-white/86">
                {trustItems.map((item) => (
                  <li class="inline-flex items-center gap-2 rounded-full border border-white/14 bg-black/16 px-3.5 py-2 backdrop-blur-sm">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-pink"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}

        <div class="hero-panel">
          <h1 class="font-display text-balance text-[3.2rem] font-bold leading-[0.92] tracking-[-0.035em] text-white sm:text-[4.35rem] lg:text-[5.6rem] xl:text-[5.9rem] max-w-[11ch]">
            {resolvedTitle}
          </h1>
          {resolvedSubtitle && (
            <p class="mt-7 max-w-2xl text-[1.03rem] leading-[1.76] text-white/85 sm:text-[1.12rem] lg:text-[1.24rem]">
              {resolvedSubtitle}
            </p>
          )}
          <div class="mt-10 flex flex-wrap gap-4 lg:mt-12">
            <a href={resolvedPrimaryCta.href} class="btn-primary btn-primary-lg">
              {resolvedPrimaryCta.label}
            </a>
            <a href={resolvedSecondaryCta.href} class="btn-secondary-on-dark btn-secondary-lg">
              {resolvedSecondaryCta.label}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

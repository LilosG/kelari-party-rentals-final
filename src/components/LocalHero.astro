---
import { Image } from 'astro:assets';
import Button from "./Button.astro";

import heroParty from '../assets/images/hero-party.jpg';
import heroBalloon from '../assets/images/hero-balloon-tent.jpg';
import parkParty from '../assets/images/park-party.jpg';
import backyardParty from '../assets/images/backyard-party.jpg';
import birthdayParty from '../assets/images/birthday-party.jpg';
import engagementParty from '../assets/images/engagement-party.jpg';
import graduationParty from '../assets/images/graduation-party.jpg';
import babyShower from '../assets/images/baby-shower.jpg';
import galleryCanopy from '../assets/images/gallery-canopy.jpg';
import galleryMarquee from '../assets/images/gallery-marquee.jpg';
import galleryTablescape from '../assets/images/gallery-tablescape.jpg';
import tentWhite10x20Open from '../assets/images/tent-white-10x20-open.png';

import type { ImageMetadata } from 'astro';
import { nap, booqableStore } from '../data/site';

const heroImageMap: Record<string, ImageMetadata> = {
  '/images/hero-party.jpg': heroParty,
  '/images/hero-balloon-tent.jpg': heroBalloon,
  '/images/park-party.jpg': parkParty,
  '/images/backyard-party.jpg': backyardParty,
  '/images/birthday-party.jpg': birthdayParty,
  '/images/engagement-party.jpg': engagementParty,
  '/images/graduation-party.jpg': graduationParty,
  '/images/baby-shower.jpg': babyShower,
  '/images/gallery-canopy.jpg': galleryCanopy,
  '/images/gallery-marquee.jpg': galleryMarquee,
  '/images/gallery-tablescape.jpg': galleryTablescape,
  '/images/tent-white-10x20-open.png': tentWhite10x20Open,
};

export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
  breadcrumbs?: { label: string; href: string }[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  eyebrow?: string;
  trustItems?: string[];
  /** @deprecated Use title instead */
  headline?: string;
  /** @deprecated Use subtitle instead */
  subheadline?: string;
  /** @deprecated Use backgroundImage instead */
  bgImage?: string;
  /** @deprecated Pass breadcrumbs directly */
  city?: string;
  /** @deprecated Pass breadcrumbs directly */
  service?: string;
}

const {
  title,
  subtitle,
  backgroundImage,
  breadcrumbs: breadcrumbsProp,
  primaryCta,
  secondaryCta,
  eyebrow,
  trustItems = [],
  headline,
  subheadline,
  bgImage,
  city,
  service,
} = Astro.props;

const resolvedTitle = title ?? headline ?? "";
const resolvedSubtitle = subtitle ?? subheadline ?? "";
const resolvedImagePath = backgroundImage ?? bgImage ?? "/images/hero-party.jpg";
const resolvedImage = heroImageMap[resolvedImagePath] ?? heroParty;

const resolvedBreadcrumbs: { label: string; href: string }[] =
  breadcrumbsProp ??
  (() => {
    const crumbs: { label: string; href: string }[] = [{ label: "Home", href: "/" }];
    if (city) {
      crumbs.push({
        label: city,
        href: `/${city.toLowerCase().replace(/\s+/g, "-")}/`,
      });
    }
    if (service) {
      const serviceSlug = service.toLowerCase().replace(/\s+/g, "-");
      crumbs.push({
        label: service,
        href: city
          ? `/${city.toLowerCase().replace(/\s+/g, "-")}/${serviceSlug}/`
          : `/services/${serviceSlug}/`,
      });
    }
    return crumbs.length > 1 ? crumbs : [];
  })();

const resolvedPrimaryCta = primaryCta ?? {
  label: "Book Now",
  href: booqableStore,
};
const resolvedSecondaryCta = secondaryCta ?? {
  label: nap.contact.phone,
  href: `tel:${nap.contact.phone.replace(/\D/g, "")}`,
};

const hasEmphasisPattern = resolvedTitle.includes("Every Celebration");
const introTitle = hasEmphasisPattern
  ? resolvedTitle.split("Every Celebration")[0].trim()
  : resolvedTitle;
const emphasisTail = hasEmphasisPattern
  ? resolvedTitle.split("Every Celebration")[1].trim()
  : "";
---

<section class="hero-shell relative isolate overflow-hidden flex items-center">
  <Image
    src={resolvedImage}
    alt=""
    widths={[640, 1280, 1600]}
    sizes="100vw"
    fetchpriority="high"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover object-center"
  />
  <!-- Warm atmospheric overlay -->
  <div class="hero-overlay absolute inset-0"></div>
  <!-- Pink radial glow top-left -->
  <div class="hero-pink-glow absolute -top-20 -left-20 w-[300px] h-[300px] rounded-full pointer-events-none"></div>

  <div class="relative z-10 w-full">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-2xl">

        {resolvedBreadcrumbs.length > 0 && (
          <nav class="mb-6" aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/90">
              {resolvedBreadcrumbs.map((crumb, i) => (
                <li class="flex items-center gap-2">
                  {i > 0 && <span class="text-white/60" aria-hidden="true">/</span>}
                  {i === resolvedBreadcrumbs.length - 1 ? (
                    <span class="text-white/90" aria-current="page">{crumb.label}</span>
                  ) : (
                    <a href={crumb.href} class="hover:text-white transition-colors">{crumb.label}</a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}

        <p class="hero-chip inline-flex items-center gap-2 text-xs font-semibold mb-6 px-3 py-1.5 rounded-full border">
          <span class="w-1.5 h-1.5 rounded-full shrink-0 bg-brand-pink"></span>
          North County San Diego
        </p>
        {eyebrow && eyebrow !== "North County San Diego" && (
          <p class="font-body uppercase tracking-[0.2em] text-[0.7rem] font-bold text-brand-pink-light mb-5">
            {eyebrow}
          </p>
        )}

        {trustItems.length > 0 && (
          <ul class="flex flex-wrap gap-2.5 mb-6">
            {trustItems.map((item) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/20 px-3.5 py-1.5 text-sm text-white/90 backdrop-blur-sm">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-pink" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        )}

        <h1 class="hero-title font-display text-white leading-[1.06] tracking-tight text-[2.15rem] sm:text-[2.7rem] lg:text-[3.35rem] xl:text-[3.8rem] max-w-[19ch]">
          {hasEmphasisPattern ? (
            <>
              <span class="hero-title-intro block">{introTitle}</span>
              <span class="hero-title-emphasis block">
                <span class="text-brand-pink">Every Celebration</span>{" "}
                <em class="hero-title-emphasis-tail">{emphasisTail}</em>
              </span>
            </>
          ) : (
            <span class="hero-title-intro block">{resolvedTitle}</span>
          )}
        </h1>

        {resolvedSubtitle && (
          <p class="hero-subtitle mt-6 text-lg text-white/80 leading-relaxed max-w-xl">
            {resolvedSubtitle}
          </p>
        )}

        <div class="mt-8 flex flex-wrap gap-3">
          <Button
            href={resolvedPrimaryCta.href}
            variant="brand"
            size="md"
            target={resolvedPrimaryCta.href.startsWith("http") ? "_blank" : undefined}
            rel={resolvedPrimaryCta.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {resolvedPrimaryCta.label}
          </Button>
          <Button href={resolvedSecondaryCta.href} variant="outline-light" size="md">
            {resolvedSecondaryCta.label}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

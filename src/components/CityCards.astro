---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface CityCard {
  name: string;
  description: string;
  href: string;
  image?: string;
  slug?: string;
}

export interface Props {
  cities: CityCard[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "featured" | "none";
}

const {
  cities,
  eyebrow,
  title,
  subtitle,
  bg = "light",
  padding = "default",
} = Astro.props;

const cityImages: Record<string, string> = {
  carlsbad: "/images/hero-party.jpg",
  encinitas: "/images/backyard-party.jpg",
  oceanside: "/images/park-party.jpg",
  "san-marcos": "/images/graduation-party.jpg",
};

function getCityImage(city: CityCard): string {
  if (city.image) return city.image;
  const slug = city.slug ?? city.href.split("/").filter(Boolean).pop() ?? "";
  return cityImages[slug] ?? "/images/hero-party.jpg";
}
---

<Section {bg} spacing={padding} width="wide">
  {(title || eyebrow) && (
    <div class="mb-10 md:mb-14">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} width="wide" />
    </div>
  )}

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {cities.map((city) => (
      <a href={city.href} class="card-surface card-link group text-center">
        <div class="card-image-wrap">
          <img
            src={getCityImage(city)}
            alt={city.name}
            width="1200"
            height="900"
            class="card-image"
            loading="lazy"
          />
        </div>
        <div class="card-body items-center">
          <h3 class="card-title text-xl group-hover:text-brand-pink transition-colors">{city.name}</h3>
          <p class="card-copy card-copy-compact text-center text-neutral-500">{city.description}</p>
          <span class="card-link-text">Party rentals in {city.name} <span aria-hidden="true">&rarr;</span></span>
        </div>
      </a>
    ))}
  </div>
</Section>

---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import { getCityImage } from "../data/images";

export interface CityCard {
  name: string;
  description: string;
  href: string;
  image?: string;
  slug?: string;
}

export interface Props {
  cities: CityCard[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "none";
}

const {
  cities,
  eyebrow,
  title,
  subtitle,
  bg = "light",
  padding = "default",
} = Astro.props;

const isDark = bg === "dark";

function resolveCityImage(city: CityCard): string {
  if (city.image) return city.image;
  const slug = city.slug ?? city.href.split("/").filter(Boolean).pop() ?? "";
  return getCityImage(slug);
}
---

<Section {bg} {padding}>
  {(title || eyebrow) && (
    <div class="mb-10 md:mb-14">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} />
    </div>
  )}

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {cities.map((city) => (
      <a
        href={city.href}
        class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 border border-neutral-100 overflow-hidden group"
      >
        <div class="aspect-[4/3] overflow-hidden">
          <img
            src={resolveCityImage(city)}
            alt={city.name}
            width="1200"
            height="900"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6 flex flex-col flex-1 text-center">
          <h3 class:list={[
            "font-display text-xl font-bold group-hover:text-brand-pink transition-colors",
            isDark ? "text-white" : "text-neutral-800",
          ]}>
            {city.name}
          </h3>
          <p class:list={[
            "mt-1.5 text-sm leading-relaxed",
            isDark ? "text-neutral-400" : "text-neutral-500",
          ]}>
            {city.description}
          </p>
          <span class="mt-3 text-sm font-semibold text-brand-pink group-hover:underline">
            Party rentals in {city.name} &rarr;
          </span>
        </div>
      </a>
    ))}
  </div>
</Section>

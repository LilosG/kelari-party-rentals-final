---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import { getCategoryImage } from "../data/images";

export interface CategoryCard {
  name: string;
  description: string;
  href: string;
  image?: string;
  icon?: string;
  slug?: string;
}

export interface Props {
  categories: CategoryCard[];
  columns?: 2 | 3 | 4;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "none";
}

const {
  categories,
  columns = 3,
  eyebrow,
  title,
  subtitle,
  bg = "light",
  padding = "default",
} = Astro.props;

const isDark = bg === "dark";

function resolveCategoryImage(cat: CategoryCard): string {
  if (cat.image) return cat.image;
  const slug = cat.slug ?? cat.href.split("/").filter(Boolean).pop() ?? "";
  return getCategoryImage(slug);
}

const colClass = {
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
}[columns];
---

<Section {bg} {padding}>
  {(title || eyebrow) && (
    <div class="mb-10 md:mb-14">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} />
    </div>
  )}

  <div class={`grid gap-6 ${colClass}`}>
    {categories.map((cat) => (
      <a
        href={cat.href}
        class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 border border-neutral-100 overflow-hidden group"
      >
        <div class="aspect-[4/3] overflow-hidden">
          <img
            src={resolveCategoryImage(cat)}
            alt={cat.name}
            width="1200"
            height="900"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-6 flex flex-col flex-1">
          <h3 class:list={[
            "font-display text-lg font-bold group-hover:text-brand-pink transition-colors",
            isDark ? "text-white" : "text-neutral-800",
          ]}>
            {cat.name}
          </h3>
          <p class:list={[
            "mt-1.5 text-sm leading-relaxed flex-1",
            isDark ? "text-neutral-300" : "text-neutral-600",
          ]}>
            {cat.description}
          </p>
          <span class="mt-3 text-sm font-semibold text-brand-pink group-hover:underline">
            Browse {cat.name} &rarr;
          </span>
        </div>
      </a>
    ))}
  </div>
</Section>

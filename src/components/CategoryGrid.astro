---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface CategoryCard {
  name: string;
  description: string;
  href: string;
  image?: string;
  icon?: string;
  slug?: string;
}

export interface Props {
  categories: CategoryCard[];
  columns?: 2 | 3 | 4;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "featured" | "none";
}

const {
  categories,
  columns = 3,
  eyebrow,
  title,
  subtitle,
  bg = "light",
  padding = "default",
} = Astro.props;

const isDark = bg === "dark";

const categoryImages: Record<string, string> = {
  tables: "/images/gallery-tablescape.jpg",
  chairs: "/images/backyard-party.jpg",
  "tents-canopies": "/images/gallery-canopy.jpg",
  linens: "/images/baby-shower.jpg",
  tableware: "/images/gallery-tablescape.jpg",
  decorations: "/images/gallery-marquee.jpg",
  lighting: "/images/engagement-party.jpg",
};

function getCategoryImage(cat: CategoryCard): string {
  if (cat.image) return cat.image;
  const slug = cat.slug ?? cat.href.split("/").filter(Boolean).pop() ?? "";
  return categoryImages[slug] ?? "/images/hero-party.jpg";
}

const colClass = {
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
}[columns];
---

<Section {bg} spacing={padding} width="wide">
  {(title || eyebrow) && (
    <div class="mb-12 md:mb-16">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} width="wide" />
    </div>
  )}

  <div class={`grid gap-6 md:gap-7 ${colClass}`}>
    {categories.map((cat) => (
      <a
        href={cat.href}
        class="group relative overflow-hidden rounded-2xl bg-white border border-neutral-100 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col"
      >
        <div class="relative overflow-hidden aspect-[16/10]">
          <img
            src={getCategoryImage(cat)}
            alt={cat.name}
            width="800"
            height="600"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-5 flex flex-col flex-1">
          <h3 class:list={[
            "font-display font-bold text-lg group-hover:text-brand-pink transition-colors",
            isDark ? "text-white" : "text-neutral-900",
          ]}>
            {cat.name}
          </h3>
          <p class:list={[
            "text-sm mt-2 leading-relaxed flex-1",
            isDark ? "text-neutral-300" : "text-neutral-600",
          ]}>
            {cat.description}
          </p>
          <span class="inline-flex items-center gap-1 text-sm font-semibold text-brand-pink mt-4 group-hover:gap-2 transition-all duration-200">
            Browse {cat.name} <span aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</Section>

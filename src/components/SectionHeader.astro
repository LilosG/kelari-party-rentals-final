---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  dark?: boolean;
  width?: "default" | "narrow" | "wide";
  spacing?: "default" | "compact" | "featured";
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = "center",
  dark = false,
  width = "default",
  spacing = "default",
  class: className,
} = Astro.props;

const isCenter = align === "center";

const titleClass = {
  compact: "text-[2.2rem] md:text-[2.75rem]",
  default: "text-[2.45rem] md:text-[3.3rem] lg:text-[4rem]",
  featured: "text-[2.8rem] md:text-[3.9rem] lg:text-[4.8rem]",
}[spacing];

const subtitleClass = {
  compact: "mt-5 text-[1.02rem] md:text-[1.14rem]",
  default: "mt-6 text-[1.12rem] md:text-[1.24rem]",
  featured: "mt-7 text-[1.18rem] md:text-[1.34rem]",
}[spacing];

const widthClass = {
  narrow: "max-w-2xl",
  default: "max-w-3xl",
  wide: "max-w-4xl",
}[width];
---

<div class:list={[isCenter ? "text-center mx-auto" : "text-left", widthClass, className]}>
  {eyebrow && (
    <p class:list={[
      "font-body uppercase tracking-[0.32em] text-[0.68rem] font-bold mb-5 sm:mb-6",
      dark ? "text-brand-pink-light" : "text-brand-pink-dark",
    ]}>
      {eyebrow}
    </p>
  )}
  <h2 class:list={[
    "font-display font-bold text-balance leading-[1.01] tracking-[-0.03em]",
    titleClass,
    dark ? "text-white" : "text-neutral-900",
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      "leading-[1.72] max-w-[54rem]",
      subtitleClass,
      isCenter ? "mx-auto" : "",
      dark ? "text-neutral-300" : "text-neutral-600",
    ]}>
      {subtitle}
    </p>
  )}
</div>

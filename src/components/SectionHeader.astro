---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  dark?: boolean;
  width?: "default" | "narrow" | "wide";
  spacing?: "default" | "compact" | "featured";
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = "center",
  dark = false,
  width = "default",
  spacing = "default",
  class: className,
} = Astro.props;

const isCenter = align === "center";

const widthClass = {
  narrow: "max-w-2xl",
  default: "max-w-3xl",
  wide: "max-w-4xl",
}[width];

const titleSize = {
  compact: "text-[1.75rem] md:text-[2.1rem] lg:text-[2.35rem]",
  default: "text-[2rem] md:text-[2.45rem] lg:text-[2.85rem]",
  featured: "text-[2.2rem] md:text-[2.8rem] lg:text-[3.2rem] xl:text-[3.6rem]",
}[spacing];
---

<div class:list={[isCenter ? "text-center mx-auto" : "text-left", widthClass, className]}>
  {eyebrow && (
    <p class:list={[
      "font-body uppercase tracking-[0.18em] text-[0.68rem] font-bold mb-3",
      dark ? "text-brand-pink-light" : "text-brand-pink",
    ]}>
      {eyebrow}
    </p>
  )}
  <h2 class:list={[
    "font-display font-semibold leading-[1.05] tracking-[-0.02em]",
    titleSize,
    dark ? "text-white" : "text-neutral-900",
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      "mt-4 text-[1rem] lg:text-[1.08rem] leading-[1.7]",
      isCenter ? "mx-auto" : "",
      "max-w-2xl",
      dark ? "text-neutral-300" : "text-neutral-500",
    ]}>
      {subtitle}
    </p>
  )}
</div>

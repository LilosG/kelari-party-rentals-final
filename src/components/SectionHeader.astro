---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  dark?: boolean;
  width?: "default" | "narrow" | "wide";
  spacing?: "default" | "compact" | "featured";
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = "center",
  dark = false,
  width = "default",
  spacing = "default",
  class: className,
} = Astro.props;

const isCenter = align === "center";

const widthClass = {
  narrow: "max-w-2xl",
  default: "max-w-3xl",
  wide: "max-w-4xl",
}[width];

const titleSize = {
  compact: "text-3xl md:text-4xl lg:text-[2.6rem]",
  default: "text-4xl md:text-5xl lg:text-[3.2rem]",
  featured: "text-4xl md:text-5xl lg:text-[3.6rem] xl:text-[4rem]",
}[spacing];
---

<div class:list={[isCenter ? "text-center mx-auto" : "text-left", widthClass, className]}>
  {eyebrow && (
    <p class:list={[
      "font-body uppercase tracking-widest text-xs font-bold mb-4",
      dark ? "text-brand-pink-light" : "text-brand-pink",
    ]}>
      {eyebrow}
    </p>
  )}
  <h2 class:list={[
    "font-display font-bold leading-tight tracking-tight",
    titleSize,
    dark ? "text-white" : "text-neutral-900",
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      "mt-5 text-lg leading-relaxed",
      isCenter ? "mx-auto" : "",
      "max-w-2xl",
      dark ? "text-neutral-300" : "text-neutral-500",
    ]}>
      {subtitle}
    </p>
  )}
</div>

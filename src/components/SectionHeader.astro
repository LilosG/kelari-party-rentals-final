---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  dark?: boolean;
  width?: "default" | "narrow" | "wide";
  spacing?: "default" | "compact" | "featured";
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = "center",
  dark = false,
  width = "default",
  spacing = "default",
  class: className,
} = Astro.props;

const isCenter = align === "center";

const titleClass = {
  compact: "text-[2rem] md:text-[2.4rem]",
  default: "text-[2.15rem] md:text-[2.8rem] lg:text-[3.35rem]",
  featured: "text-[2.5rem] md:text-[3.35rem] lg:text-[4.25rem]",
}[spacing];

const subtitleClass = {
  compact: "mt-4 text-base md:text-lg",
  default: "mt-5 text-[1.05rem] md:text-[1.15rem]",
  featured: "mt-6 text-lg md:text-xl",
}[spacing];

const widthClass = {
  narrow: "max-w-2xl",
  default: "max-w-3xl",
  wide: "max-w-4xl",
}[width];
---

<div class:list={[isCenter ? "text-center mx-auto" : "text-left", widthClass, className]}>
  {eyebrow && (
    <p class:list={[
      "font-body uppercase tracking-[0.28em] text-[0.69rem] font-semibold mb-4 sm:mb-5",
      dark ? "text-brand-pink-light" : "text-brand-pink-dark",
    ]}>
      {eyebrow}
    </p>
  )}
  <h2 class:list={[
    "font-display font-bold text-balance leading-[1.04] tracking-[-0.02em]",
    titleClass,
    dark ? "text-white" : "text-neutral-900",
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      "leading-relaxed max-w-[48rem]",
      subtitleClass,
      isCenter ? "mx-auto" : "",
      dark ? "text-neutral-300" : "text-neutral-600",
    ]}>
      {subtitle}
    </p>
  )}
</div>

---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  dark?: boolean;
  width?: "default" | "narrow" | "wide";
  spacing?: "default" | "compact" | "featured";
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = "center",
  dark = false,
  width = "default",
  spacing = "default",
  class: className,
} = Astro.props;

const isCenter = align === "center";

const widthClass = {
  narrow: "max-w-2xl",
  default: "max-w-3xl",
  wide: "max-w-4xl",
}[width];

const titleSize = {
  compact: "text-[1.9rem] md:text-[2.4rem] lg:text-[2.8rem]",
  default: "text-[2.4rem] md:text-[3rem] lg:text-[3.6rem]",
  featured: "text-[2.8rem] md:text-[3.6rem] lg:text-[4.2rem] xl:text-[4.8rem]",
}[spacing];
---

<div class:list={[isCenter ? "text-center mx-auto" : "text-left", widthClass, className]}>
  {eyebrow && (
    <p class:list={[
      "font-body uppercase tracking-[0.2em] text-[0.7rem] font-bold mb-4",
      dark ? "text-brand-pink-light" : "text-brand-pink",
    ]}>
      {eyebrow}
    </p>
  )}
  <h2 class:list={[
    "font-display font-bold leading-tight tracking-tight",
    titleSize,
    dark ? "text-white" : "text-neutral-900",
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      "mt-5 text-[1.05rem] lg:text-[1.15rem] leading-[1.75]",
      isCenter ? "mx-auto" : "",
      "max-w-2xl",
      dark ? "text-neutral-300" : "text-neutral-500",
    ]}>
      {subtitle}
    </p>
  )}
</div>

---
import ContactMetadata from "./ContactMetadata.astro";
import ConversionProofPoints from "./ConversionProofPoints.astro";
import { contactMetaItems, conversionProofPoints } from "../data/conversion";

interface Props {
  heading?: string;
  subheading?: string;
  overline?: string;
  city?: string;
  service?: string;
  variant?: "light" | "dark";
}

const {
  heading = "Get a Free Quote",
  subheading = "Tell us about your event and we'll put together a custom rental package — no obligation.",
  overline = "Start Here",
  city,
  service,
  variant = "dark",
} = Astro.props;

const isDark = variant === "dark";
const priorityContactItems = contactMetaItems.filter(({ label }) => ["Phone", "Email", "Hours"].includes(label));
---

<section id="quote-form" class:list={["py-20 lg:py-28 relative overflow-hidden", isDark ? "bg-[#222222] quote-form--dark" : "bg-white/10"]}>
  {isDark && (
    <div class="absolute top-0 right-0 h-[500px] w-[500px] -translate-y-1/2 translate-x-1/3 rounded-full bg-brand-pink/5 blur-[80px] pointer-events-none" aria-hidden="true"></div>
  )}

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class:list={[isDark ? "grid gap-12 lg:grid-cols-2 lg:gap-20" : "mx-auto max-w-3xl"]}>

      {isDark && (
        <div class="flex flex-col justify-center">
          <p class="font-body uppercase tracking-widest text-xs font-bold text-brand-pink mb-4">{overline}</p>
          <h2 class="font-display font-bold text-4xl md:text-5xl text-white leading-tight mb-5">{heading}</h2>
          <p class="text-lg leading-relaxed text-neutral-400 max-w-sm mb-8">{subheading}</p>
          <ConversionProofPoints items={conversionProofPoints.slice(0, 2)} surface="dark" compact={true} />
          <div class="mt-6">
            <ContactMetadata items={priorityContactItems} surface="dark" showDescriptions={false} />
          </div>
        </div>
      )}

      <div>
        {!isDark && (
          <div class="mb-10 text-center">
            <p class="font-body uppercase tracking-widest text-xs font-bold text-brand-pink mb-3">{overline}</p>
            <h2 class="font-display font-bold text-4xl text-white leading-tight">{heading}</h2>
            <p class="mt-3 text-lg text-neutral-200 leading-relaxed">{subheading}</p>
          </div>
        )}

        <div class="rounded-2xl bg-white/10 border border-neutral-100 shadow-sm p-8">
          {isDark && (
            <h3 class="font-display text-xl font-bold text-white mb-6">Request a Quote</h3>
          )}

          <form method="POST" action="/api/quote" data-city={city} data-service={service} class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="quote-name" class="form-label">Full Name <span class="text-brand-pink">*</span></label>
                <input type="text" id="quote-name" name="name" required autocomplete="name" class="form-input" placeholder="Your name" />
              </div>
              <div>
                <label for="quote-phone" class="form-label">Phone <span class="text-brand-pink">*</span></label>
                <input type="tel" id="quote-phone" name="phone" required autocomplete="tel" class="form-input" placeholder="(760) 000-0000" />
              </div>
              <div>
                <label for="quote-email" class="form-label">Email <span class="text-brand-pink">*</span></label>
                <input type="email" id="quote-email" name="email" required autocomplete="email" class="form-input" placeholder="you@email.com" />
              </div>
              <div>
                <label for="quote-date" class="form-label">Event Date <span class="text-brand-pink">*</span></label>
                <input type="date" id="quote-date" name="event_date" required class="form-input" />
              </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="quote-event-type" class="form-label">Event Type</label>
                <select id="quote-event-type" name="event_type" class="form-select">
                  <option value="">Select event type</option>
                  <option value="birthday">Birthday Party</option>
                  <option value="baby-shower">Baby Shower</option>
                  <option value="graduation">Graduation Party</option>
                  <option value="engagement">Engagement Party</option>
                  <option value="backyard">Backyard Party</option>
                  <option value="park">Park Party</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label for="quote-guests" class="form-label">Estimated Guests</label>
                <select id="quote-guests" name="guest_count" class="form-select">
                  <option value="">Select range</option>
                  <option value="1-20">1–20 guests</option>
                  <option value="21-50">21–50 guests</option>
                  <option value="51-100">51–100 guests</option>
                  <option value="100+">100+ guests</option>
                </select>
              </div>
            </div>

            <div>
              <label for="quote-message" class="form-label">Tell us about your event</label>
              <textarea id="quote-message" name="message" rows="4" class="form-textarea" placeholder="What items are you looking for? Any special requests?"></textarea>
            </div>

            {city && <input type="hidden" name="city" value={city} />}
            {service && <input type="hidden" name="service" value={service} />}

            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-brand-pink hover:bg-brand-pink-dark text-white font-semibold py-4 rounded-lg text-base transition-all duration-200 shadow-sm hover:shadow-md">
              Request My Free Quote
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </button>
            <p class="text-center text-xs text-neutral-200 font-body">We respond within 2 hours during business hours. No spam, ever.</p>
          </form>
        </div>

        {!isDark && (
          <div class="mt-6">
            <ConversionProofPoints items={conversionProofPoints} compact={false} />
          </div>
        )}
      </div>
    </div>
  </div>
</section>

---
import type { ConversionProofPoint } from "../data/conversion";

interface Props {
  items: ConversionProofPoint[];
  surface?: "light" | "dark";
  compact?: boolean;
}

const { items, surface = "light", compact = false } = Astro.props;
const isDark = surface === "dark";
---

<div class:list={[compact ? "grid gap-3" : "grid gap-4 md:grid-cols-3"]}>
  {items.map((item) => (
    <div class:list={[
      "flex items-start gap-3 rounded-xl border p-4",
      isDark ? "border-white/10 bg-white/5" : "border-neutral-200 bg-neutral-50",
    ]}>
      <div class:list={[
        "flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-lg",
        isDark ? "bg-brand-pink/20" : "bg-brand-pink-light",
      ]} aria-hidden="true">
        {item.icon}
      </div>
      <div>
        <h3 class:list={["font-body text-sm font-semibold", isDark ? "text-white" : "text-neutral-800"]}>
          {item.title}
        </h3>
        <p class:list={["mt-1 text-sm leading-relaxed", isDark ? "text-white/70" : "text-neutral-600"]}>
          {item.description}
        </p>
        {item.links && item.links.length > 0 && (
          <div class="mt-1.5 flex flex-wrap gap-x-3 gap-y-1">
            {item.links.map((link) => (
              <a
                href={link.href}
                class:list={[
                  "text-sm font-medium hover:underline",
                  isDark ? "text-brand-pink-light" : "text-brand-pink",
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  ))}
</div>

---
import ContactMetadata from "./ContactMetadata.astro";
import ConversionProofPoints from "./ConversionProofPoints.astro";
import { site, nap } from "../data/site";
import { contactMetaItems, conversionProofPoints, footerNavGroups } from "../data/conversion";

interface Props {
  variant?: "home" | "default";
}

const { variant = "default" } = Astro.props;

const footerContactItems = contactMetaItems.filter(({ label }) => ["Phone", "Email", "Hours"].includes(label));
---

<footer class="bg-brand-dark text-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">

    {variant === "home" ? (
      <>
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
          <div>
            <a href="/" class="inline-block mb-5 hover:opacity-90 transition-opacity">
              <span class="font-display text-2xl font-bold text-brand-pink">{nap.name}</span>
            </a>
            <p class="text-sm leading-7 text-white max-w-sm">
              Stress-free party rentals with polished setups, clear communication, and full-service delivery, setup, and pickup.
            </p>
            <div class="mt-6 space-y-2 text-sm">
              <a href={`tel:${nap.contact.phone.replace(/\D/g, "")}`} class="flex text-white hover:text-brand-pink transition-colors">{nap.contact.phone}</a>
              <a href={`mailto:${nap.contact.email}`} class="flex text-white hover:text-brand-pink transition-colors">{nap.contact.email}</a>
              <p class="text-neutral-100">{nap.contact.hours}</p>
              <p class="text-neutral-100 text-xs">{nap.address.full}</p>
            </div>
          </div>

          <div class="rounded-2xl border border-white/20 bg-white/12 p-7">
            <p class="font-body text-xs font-bold uppercase tracking-widest text-brand-pink-light mb-3">Request a quote today</p>
            <h3 class="font-display text-2xl font-bold text-white">Request Your Free Quote Today</h3>
            <p class="mt-3 text-sm leading-relaxed text-white">
              Tell us about your date and guest count. We'll send a clean, all-in quote with delivery, setup, and pickup included.
            </p>
            <form method="POST" action="https://api.staticforms.xyz/submit" class="mt-6 space-y-3">
              <div class="grid gap-3 sm:grid-cols-2">
                <input type="text" name="name" placeholder="Name" required class="form-input form-input-dark" />
                <input type="tel" name="phone" placeholder="Phone" required class="form-input form-input-dark" />
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                <input type="email" name="email" placeholder="Email" required class="form-input form-input-dark" />
                <input type="date" name="event_date" required class="form-input form-input-dark [color-scheme:dark]" />
              </div>
              <input type="hidden" name="accessKey" value="sf_7941a8e0435764d2be4a9381" />
              <input type="hidden" name="redirectTo" value="https://kelaripartyrentals.com/thank-you/" />
              <input type="text" name="honeypot" style="display:none" />
              <button type="submit" class="w-full inline-flex items-center justify-center bg-brand-pink hover:bg-brand-pink-dark text-white font-semibold px-6 py-3.5 rounded-lg text-sm transition-colors">
                Send My Quote
              </button>
            </form>
          </div>
        </div>

        <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {footerNavGroups.map((group) => (
            <div>
              <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-white/80">{group.title}</h3>
              <ul class="space-y-3 text-sm">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-white hover:text-brand-pink transition-colors">{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </>
    ) : (
      <div class="grid gap-12 lg:grid-cols-[1fr_1fr_auto] lg:gap-14">
        <div>
          <a href="/" class="inline-block mb-5 hover:opacity-90 transition-opacity">
            <span class="font-display text-2xl font-bold text-brand-pink">{nap.name}</span>
          </a>
          <p class="text-sm leading-7 text-white max-w-xs">
            Stress-free party rentals with fast communication, free delivery, setup, and pickup.
          </p>
          <div class="mt-6 space-y-2 text-sm">
            <a href={`tel:${nap.contact.phone.replace(/\D/g, "")}`} class="flex text-white hover:text-brand-pink transition-colors">{nap.contact.phone}</a>
            <a href={`mailto:${nap.contact.email}`} class="flex text-white hover:text-brand-pink transition-colors">{nap.contact.email}</a>
            <p class="text-neutral-100">{nap.contact.hours}</p>
            <p class="text-neutral-100 text-xs">{nap.address.full}</p>
          </div>
          <div class="mt-6 flex flex-wrap gap-4 text-sm">
            <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="text-neutral-100 hover:text-brand-pink transition-colors">Facebook</a>
            <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="text-neutral-100 hover:text-brand-pink transition-colors">Instagram</a>
            <a href={site.social.google} target="_blank" rel="noopener noreferrer" class="text-neutral-100 hover:text-brand-pink transition-colors">Google</a>
          </div>
        </div>

        <div class="grid gap-8 sm:grid-cols-2">
          {footerNavGroups.map((group) => (
            <div>
              <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-white/80">{group.title}</h3>
              <ul class="space-y-3 text-sm">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-white hover:text-brand-pink transition-colors">{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div>
          <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-white/80">Get in Touch</h3>
          <div class="space-y-3 text-sm">
            <a href="tel:7600000000" class="flex items-center gap-2 text-white hover:text-brand-pink transition-colors">
              <svg class="w-4 h-4 text-brand-pink shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              (760) 000-0000
            </a>
            <a href="mailto:hello@kelaripartyrentals.com" class="flex items-center gap-2 text-white hover:text-brand-pink transition-colors">
              <svg class="w-4 h-4 text-brand-pink shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              hello@kelaripartyrentals.com
            </a>
            <p class="text-neutral-400 text-xs pl-6">Mon–Sun 9AM–7PM</p>
          </div>
          <a href="/quote/" class="mt-6 inline-flex items-center justify-center w-full bg-brand-pink hover:bg-brand-pink-dark text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors">
            Get a Free Quote
          </a>
        </div>
      </div>
    )}

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/20 pt-6 text-sm text-neutral-100 sm:flex-row">
      <p>&copy; {new Date().getFullYear()} {nap.name}. All rights reserved.</p>
    </div>

  </div>
</footer>

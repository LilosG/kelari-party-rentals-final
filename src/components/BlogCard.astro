---
// src/components/BlogCard.astro
// Kelari Party Rentals — Blog Card
// ==================================
// Adds image support. When an image is provided it renders above the
// card content; when absent the card remains text-only (no broken
// placeholder, no repeated fallback image).

export interface Props {
  title: string;
  description: string;
  slug: string;
  publishDate: string;
  category: string;
  tags?: string[];
  featured?: boolean;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  slug,
  publishDate,
  category,
  tags = [],
  featured = false,
  image,
  imageAlt,
} = Astro.props;

const displayDate = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const href = `/blog/${slug}/`;
---

<article
  class:list={[
    'group relative flex flex-col bg-white rounded-2xl border border-neutral-100 overflow-hidden transition-shadow duration-300 hover:shadow-[0_8px_40px_rgba(200,68,122,0.14)]',
    featured && 'ring-1 ring-brand-pink/20',
  ]}
>
  {image && (
    <div class="aspect-video overflow-hidden">
      <img
        src={image}
        alt={imageAlt ?? title}
        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
        loading="lazy"
        decoding="async"
        width="1200"
        height="675"
      />
    </div>
  )}

  <div class="flex flex-col flex-1 p-6 lg:p-7">

    <!-- Category + date -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <span class="inline-block bg-brand-pink/10 text-brand-pink text-[0.65rem] font-bold uppercase tracking-[0.18em] px-2.5 py-1 rounded-full">
        {category}
      </span>
      <time datetime={publishDate} class="text-xs text-neutral-400 shrink-0">
        {displayDate}
      </time>
    </div>

    <!-- Title -->
    <h2 class="font-display font-semibold text-neutral-900 leading-snug tracking-[-0.01em] text-[1.15rem] lg:text-[1.25rem] mb-3 group-hover:text-brand-pink transition-colors">
      <a href={href} class="after:absolute after:inset-0">
        {title}
      </a>
    </h2>

    <!-- Excerpt -->
    <p class="text-sm text-neutral-500 leading-relaxed flex-1 mb-5">
      {description}
    </p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-5">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-[0.65rem] text-neutral-400 bg-neutral-50 border border-neutral-100 px-2 py-0.5 rounded-full">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Read more -->
    <div class="mt-auto">
      <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-pink group-hover:text-brand-pink-dark transition-colors pointer-events-none">
        Read article
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>

  </div>
</article>

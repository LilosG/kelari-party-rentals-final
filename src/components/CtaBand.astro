---
export interface Props {
  title: string;
  subtitle?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { title, subtitle, primaryCta, secondaryCta } = Astro.props;

const isPhone = secondaryCta?.href?.startsWith("tel:");
---

<section class="relative overflow-hidden py-20 lg:py-28" style="background: #111111;">
  <!-- Pink radial glow left -->
  <div class="absolute -top-32 -left-32 w-[500px] h-[500px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(232,53,109,0.14) 0%, transparent 70%);"></div>
  <!-- Pink radial glow right -->
  <div class="absolute -bottom-32 -right-32 w-[400px] h-[400px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(232,53,109,0.10) 0%, transparent 70%);"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <p class="font-body uppercase tracking-[0.2em] text-[0.7rem] font-bold mb-4" style="color: #FCE4EC;">
        Ready to plan your event?
      </p>
      <h2 class="font-display font-bold text-white leading-tight tracking-tight text-4xl md:text-5xl">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-6 text-lg leading-relaxed max-w-2xl mx-auto" style="color: rgba(255,255,255,0.65);">
          {subtitle}
        </p>
      )}
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href={primaryCta.href}
          class="inline-flex items-center justify-center gap-2 text-white font-semibold px-8 py-4 rounded-full text-base transition-all duration-300"
          style="background: #E8356D; box-shadow: 0 8px 28px rgba(232,53,109,0.4);"
        >
          {primaryCta.label}
        </a>
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="inline-flex items-center justify-center gap-2 border-2 border-white/60 text-white hover:bg-white hover:text-neutral-900 font-semibold px-8 py-4 rounded-full text-base transition-all duration-300"
          >
            {isPhone && (
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            )}
            {secondaryCta.label}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

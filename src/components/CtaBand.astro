---
import SectionHeader from "./SectionHeader.astro";
import Button from "./Button.astro";

export interface Props {
  title: string;
  subtitle?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  tertiaryCta?: { label: string; href: string };
}

const { title, subtitle, primaryCta, secondaryCta, tertiaryCta } = Astro.props;
const isPhone = secondaryCta?.href?.startsWith("tel:");
const isTertiaryPhone = tertiaryCta?.href?.startsWith("tel:");
---

<section class="relative overflow-hidden py-16 lg:py-20 bg-brand-dark">
  <!-- Decorative glow elements — positioned via Tailwind, colored via token classes -->
  <div class="absolute -top-32 -left-32 w-[480px] h-[480px] rounded-full bg-brand-pink/[0.08] blur-[80px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-32 -right-32 w-[380px] h-[380px] rounded-full bg-brand-pink/[0.06] blur-[80px] pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <SectionHeader
        eyebrow="Ready to plan your event?"
        title={title}
        subtitle={subtitle}
        dark={true}
        align="center"
        spacing="default"
      />
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button
          href={primaryCta.href}
          variant="brand"
          size="md"
          target={primaryCta.href.startsWith("http") ? "_blank" : undefined}
          rel={primaryCta.href.startsWith("http") ? "noopener noreferrer" : undefined}
        >
          {primaryCta.label}
        </Button>
        {secondaryCta && (
          <Button href={secondaryCta.href} variant="outline-light" size="md">
            {isPhone && (
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            )}
            {secondaryCta.label}
          </Button>
        )}
        {tertiaryCta && (
          <Button href={tertiaryCta.href} variant="outline-light" size="md">
            {isTertiaryPhone && (
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            )}
            {tertiaryCta.label}
          </Button>
        )}
      </div>
    </div>
  </div>
</section>

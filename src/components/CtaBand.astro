---
import Section from "./Section.astro";

export interface Props {
  title: string;
  subtitle?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { title, subtitle, primaryCta, secondaryCta } = Astro.props;
---

<Section bg="dark" spacing="featured" width="default">
  <div class="cta-band-shell text-center">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display text-3xl font-bold text-white md:text-4xl lg:text-5xl text-balance">
        {title}
      </h2>
      {subtitle && (
        <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-neutral-200 md:text-lg">
          {subtitle}
        </p>
      )}
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-3.5 lg:mt-10">
      <a href={primaryCta.href} class="btn-primary btn-primary-lg">
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a href={secondaryCta.href} class="btn-secondary-on-dark btn-secondary-lg">
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</Section>

---
import Section from "./Section.astro";

export interface Props {
  title: string;
  subtitle?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { title, subtitle, primaryCta, secondaryCta } = Astro.props;
---

<Section bg="dark" padding="default">
  <div class="text-center">
    <h2 class="font-display text-3xl lg:text-4xl font-bold text-white">
      {title}
    </h2>
    {subtitle && (
      <p class="text-neutral-200 text-lg mt-4 max-w-2xl mx-auto">
        {subtitle}
      </p>
    )}
    <div class="mt-8 flex flex-wrap gap-4 justify-center">
      <a
        href={primaryCta.href}
        class="bg-brand-pink hover:bg-brand-pink-dark text-white px-8 py-4 rounded-lg font-semibold text-lg shadow-lg hover:shadow-xl transition-all duration-300"
      >
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class="border-2 border-white text-white hover:bg-white hover:text-brand-dark px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300"
        >
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</Section>

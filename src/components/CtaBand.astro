---
import Section from "./Section.astro";

export interface Props {
  title: string;
  subtitle?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { title, subtitle, primaryCta, secondaryCta } = Astro.props;
---

<Section bg="dark" spacing="featured" width="wide">
  <div class="text-center max-w-3xl mx-auto">
    <p class="font-body uppercase tracking-widest text-xs font-bold text-brand-pink-light mb-5">
      Ready to plan your event?
    </p>
    <h2 class="font-display font-bold text-white leading-tight tracking-tight text-4xl md:text-5xl">
      {title}
    </h2>
    {subtitle && (
      <p class="mt-6 text-lg leading-relaxed text-neutral-300 max-w-2xl mx-auto">
        {subtitle}
      </p>
    )}
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href={primaryCta.href}
        class="inline-flex items-center justify-center gap-2 bg-brand-pink hover:bg-brand-pink-dark text-white font-semibold px-8 py-4 rounded-lg text-base shadow-lg hover:shadow-xl transition-all duration-300"
      >
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class="inline-flex items-center justify-center gap-2 border-2 border-white/60 text-white hover:bg-white hover:text-neutral-900 font-semibold px-8 py-4 rounded-lg text-base transition-all duration-300"
        >
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</Section>

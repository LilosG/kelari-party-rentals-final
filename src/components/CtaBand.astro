---
import Section from "./Section.astro";

export interface Props {
  title: string;
  subtitle?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { title, subtitle, primaryCta, secondaryCta } = Astro.props;
---

<Section bg="dark" padding="default">
  <div class="text-center">
    <h2 class="section-title font-bold text-white">
      {title}
    </h2>
    {subtitle && (
      <p class="lead-paragraph text-neutral-200 mt-4 max-w-2xl mx-auto">
        {subtitle}
      </p>
    )}
    <div class="mt-8 flex flex-wrap gap-4 justify-center">
      <a
        href={primaryCta.href}
        class="btn-primary px-8 py-4 text-lg shadow-[var(--shadow-card)] hover:shadow-[var(--shadow-card-hover)]"
      >
        {primaryCta.label}
      </a>
      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class="btn-outline-light border-2 border-white px-8 py-4 text-lg"
        >
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</Section>

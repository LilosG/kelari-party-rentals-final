---
interface Props {
  heading: string;
  body: string;
  city?: string;
  service?: string;
}

const { heading, body, city, service } = Astro.props;

const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "5ab53834-d854-45c6-a84d-1e981ea8cf51";
---

<section class="bg-white py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

      <!-- Left: geo-anchored, equipment-led content -->
      <div class="lg:pt-2">
        <p class="font-body uppercase tracking-[0.18em] text-[0.68rem] font-bold mb-4 text-brand-pink">
          NORTH COUNTY SAN DIEGO
        </p>
        <h2 class="font-display font-bold text-3xl md:text-4xl lg:text-[2.6rem] text-neutral-900 leading-tight mb-6">
          {heading}
        </h2>
        <p class="text-lg text-neutral-600 leading-relaxed">
          {body}
        </p>
      </div>

      <!-- Right: mini quote form -->
      <div class="bg-[--color-soft-bg] rounded-2xl border border-neutral-200 p-7 lg:p-8">
        <p class="font-body uppercase tracking-widest text-xs font-bold text-brand-pink mb-1">GET A FREE QUOTE</p>
        <h3 class="font-display text-xl font-bold text-neutral-900 mb-6">Tell Us About Your Event</h3>

        <form data-mini-form class="space-y-4" novalidate>
          <div style="position:absolute; left:-5000px;" aria-hidden="true">
            <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="mf-name" class="form-label">Full Name <span class="text-brand-pink">*</span></label>
              <input type="text" id="mf-name" name="name" required autocomplete="name" class="form-input" placeholder="Your name" />
            </div>
            <div>
              <label for="mf-phone" class="form-label">Phone <span class="text-brand-pink">*</span></label>
              <input type="tel" id="mf-phone" name="phone" required autocomplete="tel" class="form-input" placeholder="(760) 000-0000" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="mf-date" class="form-label">Event Date</label>
              <input type="date" id="mf-date" name="event_date" class="form-input" />
            </div>
            <div>
              <label for="mf-occasion" class="form-label">Occasion</label>
              <select id="mf-occasion" name="occasion" class="form-select">
                <option value="">Select occasion</option>
                <option value="Birthday Party">Birthday Party</option>
                <option value="Baby Shower">Baby Shower</option>
                <option value="Graduation">Graduation</option>
                <option value="Backyard Party">Backyard Party</option>
                <option value="Park Party">Park Party</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          {city && <input type="hidden" name="city" value={city} />}
          {service && <input type="hidden" name="service" value={service} />}

          <p data-mini-error role="alert" class="text-sm text-red-500 min-h-[1.25rem]"></p>

          <button type="submit" class="btn btn--brand btn--md w-full justify-center py-4">
            Request My Free Quote →
          </button>
          <p class="text-center text-xs font-body text-neutral-500">We respond within 2 hours. No spam, ever.</p>
        </form>

        <div data-mini-success class="hidden text-center py-8">
          <svg class="mx-auto h-10 w-10 text-brand-pink mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="font-display text-xl font-bold text-neutral-900 mb-2">We'll be in touch soon!</h3>
          <p class="text-sm text-neutral-600">Quote request received. We respond within 2 hours during business hours.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline define:vars={{ ACCESS_KEY }}>
(function () {
  var forms = document.querySelectorAll('[data-mini-form]:not([data-initialized])');
  var form = forms[forms.length - 1];
  if (!form) return;
  form.dataset.initialized = 'true';

  var errorEl = form.querySelector('[data-mini-error]');
  var successEl = form.parentElement.querySelector('[data-mini-success]');

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    errorEl.textContent = '';

    var fd = new FormData(form);
    var body = {
      access_key: ACCESS_KEY,
      to: 'hello@kelaripartyrentals.com',
      name: fd.get('name'),
      phone: fd.get('phone'),
      event_date: fd.get('event_date') || '',
      occasion: fd.get('occasion') || '',
      honeypot: fd.get('honeypot') || '',
      subject: 'Quick Quote – Kelari Party Rentals',
    };
    if (fd.get('city')) body.city = fd.get('city');
    if (fd.get('service')) body.service = fd.get('service');

    try {
      var res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      var json = await res.json();
      if (json.success) {
        var showSuccess = function () {
          form.style.display = 'none';
          successEl.style.display = 'block';
        };
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'form_submit', {
            event_category: 'lead',
            event_label: 'mini_quote_form',
            event_callback: showSuccess,
            event_timeout: 2000,
          });
        } else {
          showSuccess();
        }
      } else {
        throw new Error(json.message || 'Submission failed');
      }
    } catch (err) {
      errorEl.textContent = 'Something went wrong. Please call us at (760) 385-8501.';
    }
  });
})();
</script>

---
import { nap, booqableStore } from "../data/site";
import { resourcesNav } from "../data/conversion";
import { services } from "../data/services";
import { categories } from "../data/categories";
import { cities } from "../data/cities";
import BrandWordmark from "./BrandWordmark.astro";
import Button from "./Button.astro";

const serviceLinks = services
  .filter((s) => s.slug !== "delivery-setup-pickup")
  .map((s) => ({ label: s.shortName, href: `/services/${s.slug}/` }));

const rentalLinks = categories
  .filter((c) => !c.hidden)
  .map((c) => ({
    label: c.name,
    href: `/rentals/${c.slug}/`,
    icon: c.icon,
  }));

const cityLinks = cities.map((c) => ({
  label: c.name,
  href: `/${c.slug}/`,
}));
---

<header
  id="site-header"
  class="site-header fixed inset-x-0 top-0 z-50 backdrop-blur-sm border-b border-neutral-100 transition-shadow duration-300 lg:sticky lg:inset-auto lg:top-0"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[58px] md:h-[64px]">

      <!-- Wordmark -->
      <a href="/" class="shrink-0 hover:opacity-90 transition-opacity">
        <BrandWordmark size="md" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">

        <!-- Services dropdown -->
        <div class="relative" id="desktop-services-wrapper">
          <div class="flex items-center">
            <a href="/services/" class="header-nav-link px-3 py-2 rounded-lg hover:bg-neutral-50">
              Services
            </a>
            <button
              type="button"
              id="desktop-services-btn"
              aria-expanded="false"
              aria-controls="desktop-services-panel"
              aria-label="Services submenu"
              class="p-1.5 rounded-lg text-neutral-400 hover:text-neutral-600 hover:bg-neutral-50 transition-colors"
            >
              <svg class="w-3.5 h-3.5 transition-transform duration-200" id="desktop-services-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
          <div id="desktop-services-panel" hidden class="absolute top-full left-0 mt-1 w-56 bg-white rounded-2xl border border-neutral-100 shadow-[0_8px_40px_rgba(0,0,0,0.12)] z-50">
            <div class="p-2">
              {serviceLinks.map((link) => (
                <a href={link.href} class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm text-neutral-700 hover:bg-brand-pink-light hover:text-brand-pink transition-colors font-medium">
                  {link.label}
                </a>
              ))}
              <div class="border-t border-neutral-100 mt-1 pt-1">
                <a href="/services/" class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm text-brand-pink font-semibold hover:bg-brand-pink-light transition-colors">
                  View all services →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Rentals dropdown -->
        <div class="relative" id="desktop-rentals-wrapper">
          <div class="flex items-center">
            <a href="/rentals/" class="header-nav-link px-3 py-2 rounded-lg hover:bg-neutral-50">
              Rentals
            </a>
            <button
              type="button"
              id="desktop-rentals-btn"
              aria-expanded="false"
              aria-controls="desktop-rentals-panel"
              aria-label="Rentals submenu"
              class="p-1.5 rounded-lg text-neutral-400 hover:text-neutral-600 hover:bg-neutral-50 transition-colors"
            >
              <svg class="w-3.5 h-3.5 transition-transform duration-200" id="desktop-rentals-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
          <div id="desktop-rentals-panel" hidden class="absolute top-full left-0 mt-1 w-52 bg-white rounded-2xl border border-neutral-100 shadow-[0_8px_40px_rgba(0,0,0,0.12)] z-50">
            <div class="p-2">
              {rentalLinks.map((link) => (
                <a href={link.href} class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm text-neutral-700 hover:bg-brand-pink-light hover:text-brand-pink transition-colors font-medium">
                  <span aria-hidden="true">{link.icon}</span>
                  {link.label}
                </a>
              ))}
              <div class="border-t border-neutral-100 mt-1 pt-1">
                <a href="/rentals/" class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm text-brand-pink font-semibold hover:bg-brand-pink-light transition-colors">
                  Browse all rentals →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Service Areas dropdown -->
        <!-- Service Areas dropdown -->
        <div class="relative" id="desktop-areas-wrapper">
          <div class="flex items-center">
            <a href="/service-area/" class="header-nav-link px-3 py-2 rounded-lg hover:bg-neutral-50">
              Service Areas
            </a>
            <button
              type="button"
              id="desktop-areas-btn"
              aria-expanded="false"
              aria-controls="desktop-areas-panel"
              aria-label="Service Areas submenu"
              class="p-1.5 rounded-lg text-neutral-400 hover:text-neutral-600 hover:bg-neutral-50 transition-colors"
            >
              <svg class="w-3.5 h-3.5 transition-transform duration-200" id="desktop-areas-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
          <div id="desktop-areas-panel" hidden class="absolute top-full left-0 mt-1 w-48 bg-white rounded-2xl border border-neutral-100 shadow-[0_8px_40px_rgba(0,0,0,0.12)] z-50">
            <div class="p-2">
              {cityLinks.map((link) => (
                <a href={link.href} class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm text-neutral-700 hover:bg-brand-pink-light hover:text-brand-pink transition-colors font-medium">
                  <svg class="w-3.5 h-3.5 text-brand-pink shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {link.label}
                </a>
              ))}
              <div class="border-t border-neutral-100 mt-1 pt-1">
                <a href="/service-area/" class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm text-brand-pink font-semibold hover:bg-brand-pink-light transition-colors">
                  Full service area →
                </a>
              </div>
            </div>
          </div>
        </div>

        <a href="/about/" class="header-nav-link px-3 py-2 rounded-lg hover:bg-neutral-50">
          About
        </a>

        <!-- Resources dropdown -->
        <div class="relative" id="desktop-resources-wrapper">
          <div class="flex items-center">
            <span class="header-nav-link px-3 py-2 rounded-lg">
              Resources
            </span>
            <button
              type="button"
              id="desktop-resources-btn"
              aria-expanded="false"
              aria-controls="desktop-resources-panel"
              aria-label="Resources submenu"
              class="p-1.5 rounded-lg text-neutral-400 hover:text-neutral-600 hover:bg-neutral-50 transition-colors"
            >
              <svg class="w-3.5 h-3.5 transition-transform duration-200" id="desktop-resources-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
          <div id="desktop-resources-panel" hidden class="absolute top-full left-0 mt-1 w-44 bg-white rounded-2xl border border-neutral-100 shadow-[0_8px_40px_rgba(0,0,0,0.12)] z-50">
            <div class="p-2">
              {resourcesNav.map((link) => (
                <a href={link.href} class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm text-neutral-700 hover:bg-brand-pink-light hover:text-brand-pink transition-colors font-medium">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/contact/" class="header-nav-link px-3 py-2 rounded-lg hover:bg-neutral-50">
          Contact
        </a>
      </nav>

      <!-- Desktop right -->
      <div class="hidden lg:flex items-center gap-3">
        
          <a
          href={`tel:${nap.contact.phone.replace(/\D/g, "")}`}
          class="header-contact"
        >
          <svg class="w-4 h-4 shrink-0 text-brand-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {nap.contact.phone}
        </a>
        <Button href="/quote/" variant="brand-soft" size="sm">
          Get a Quote
        </Button>
        <Button href={booqableStore} target="_blank" rel="noopener noreferrer" variant="brand" size="sm">
          Book Now
        </Button>
      </div>

      <!-- Mobile menu button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="lg:hidden p-2 transition-colors text-neutral-600 hover:text-neutral-900"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-100 bg-white max-h-[80vh] overflow-y-auto">
    <nav class="flex flex-col px-4 py-4 gap-1" aria-label="Mobile navigation">

      <!-- Services group -->
      <div>
        <button
          type="button"
          class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition-colors"
          aria-expanded="false"
          id="mobile-services-btn"
        >
          Services
          <svg class="w-4 h-4 text-neutral-400 transition-transform duration-200" id="mobile-services-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-services-menu" class="hidden pl-3 mt-1 space-y-0.5 border-l-2 border-brand-pink-light ml-3">
          {serviceLinks.map((link) => (
            <a href={link.href} class="block px-3 py-2 text-sm text-neutral-600 hover:text-brand-pink transition-colors rounded-lg hover:bg-neutral-50">
              {link.label}
            </a>
          ))}
          <a href="/services/" class="block px-3 py-2 text-sm font-semibold text-brand-pink hover:bg-brand-pink-light transition-colors rounded-lg">
            All services →
          </a>
        </div>
      </div>

      <!-- Rentals group -->
      <div>
        <button
          type="button"
          class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition-colors"
          aria-expanded="false"
          id="mobile-rentals-btn"
        >
          Rentals
          <svg class="w-4 h-4 text-neutral-400 transition-transform duration-200" id="mobile-rentals-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-rentals-menu" class="hidden pl-3 mt-1 space-y-0.5 border-l-2 border-brand-pink-light ml-3">
          {rentalLinks.map((link) => (
            <a href={link.href} class="flex items-center gap-2 px-3 py-2 text-sm text-neutral-600 hover:text-brand-pink transition-colors rounded-lg hover:bg-neutral-50">
              <span aria-hidden="true">{link.icon}</span>
              {link.label}
            </a>
          ))}
          <a href="/rentals/" class="block px-3 py-2 text-sm font-semibold text-brand-pink hover:bg-brand-pink-light transition-colors rounded-lg">
            Browse all rentals →
          </a>
        </div>
      </div>

      <!-- Service Areas group -->
      <div>
        <button
          type="button"
          class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition-colors"
          aria-expanded="false"
          id="mobile-areas-btn"
        >
          Service Areas
          <svg class="w-4 h-4 text-neutral-400 transition-transform duration-200" id="mobile-areas-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-areas-menu" class="hidden pl-3 mt-1 space-y-0.5 border-l-2 border-brand-pink-light ml-3">
          {cityLinks.map((link) => (
            <a href={link.href} class="block px-3 py-2 text-sm text-neutral-600 hover:text-brand-pink transition-colors rounded-lg hover:bg-neutral-50">
              {link.label}
            </a>
          ))}
          <a href="/service-area/" class="block px-3 py-2 text-sm font-semibold text-brand-pink hover:bg-brand-pink-light transition-colors rounded-lg">
            Full service area →
          </a>
        </div>
      </div>

      <a href="/about/" class="px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition-colors">
        About
      </a>

      <!-- Resources group -->
      <div>
        <button
          type="button"
          class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition-colors"
          aria-expanded="false"
          id="mobile-resources-btn"
        >
          Resources
          <svg class="w-4 h-4 text-neutral-400 transition-transform duration-200" id="mobile-resources-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-resources-menu" class="hidden pl-3 mt-1 space-y-0.5 border-l-2 border-brand-pink-light ml-3">
          {resourcesNav.map((link) => (
            <a href={link.href} class="block px-3 py-2 text-sm text-neutral-600 hover:text-brand-pink transition-colors rounded-lg hover:bg-neutral-50">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <a href="/contact/" class="px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition-colors">
        Contact
      </a>

      <div class="border-t border-neutral-100 mt-2 pt-3 space-y-2">
        
          <a
          href={`tel:${nap.contact.phone.replace(/\D/g, "")}`}
          class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition-colors"
        >
          <svg class="w-4 h-4 text-brand-pink shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {nap.contact.phone}
        </a>
        <Button href={booqableStore} target="_blank" rel="noopener noreferrer" variant="brand" size="sm" class="w-full justify-center">
          Book Now
        </Button>
        <Button href="/quote/" variant="brand-soft" size="sm" class="w-full justify-center">
          Get a Quote
        </Button>
      </div>
    </nav>
  </div>
</header>
<div aria-hidden="true" class="h-[58px] lg:hidden"></div>

<!-- Mobile bottom conversion bar -->
<div class="mobile-bottom-cta lg:hidden fixed inset-x-0 bottom-0 z-50 border-t border-neutral-200 bg-white/95 px-4 pb-[calc(env(safe-area-inset-bottom)+0.5rem)] pt-2 shadow-[0_-8px_30px_rgba(0,0,0,0.10)] backdrop-blur-md">
  <div class="grid grid-cols-2 gap-2">
    <a
      href={booqableStore}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-w-0 items-center justify-center rounded-lg bg-brand-pink px-3 py-3 text-sm font-semibold text-white shadow-sm"
    >
      Book Now
    </a>
    <a
      href={`tel:${nap.contact.phone.replace(/\D/g, "")}`}
      class="inline-flex min-w-0 items-center justify-center rounded-lg border border-brand-pink/30 bg-brand-pink-light px-3 py-3 text-sm font-semibold text-brand-pink"
    >
      Call Now
    </a>
  </div>
</div>


<script>
  // Main mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const icon = document.getElementById("menu-icon");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
    if (icon) {
      icon.setAttribute(
        "d",
        isOpen ? "M6 18L18 6M6 6l12 12" : "M4 6h16M4 12h16M4 18h16"
      );
    }
  });

  // Mobile sub-menu toggles
  function setupSubMenu(btnId: string, menuId: string, iconId: string) {
    const subBtn = document.getElementById(btnId);
    const subMenu = document.getElementById(menuId);
    const subIcon = document.getElementById(iconId);

    subBtn?.addEventListener("click", () => {
      const isOpen = subMenu?.classList.toggle("hidden") === false;
      subBtn.setAttribute("aria-expanded", String(isOpen));
      if (subIcon) {
        subIcon.style.transform = isOpen ? "rotate(180deg)" : "rotate(0deg)";
      }
    });
  }

  setupSubMenu("mobile-services-btn", "mobile-services-menu", "mobile-services-icon");
  setupSubMenu("mobile-rentals-btn", "mobile-rentals-menu", "mobile-rentals-icon");
  setupSubMenu("mobile-areas-btn", "mobile-areas-menu", "mobile-areas-icon");
  setupSubMenu("mobile-resources-btn", "mobile-resources-menu", "mobile-resources-icon");

  // Desktop dropdown toggles
  function setupDesktopDropdown(btnId: string, panelId: string, iconId: string) {
    const dropBtn = document.getElementById(btnId);
    const dropPanel = document.getElementById(panelId);
    const dropIcon = document.getElementById(iconId);

    if (!dropBtn || !dropPanel) return;

    dropBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = !dropPanel.hasAttribute("hidden");
      // Close all other desktop dropdowns first
      ["desktop-services-panel", "desktop-rentals-panel", "desktop-areas-panel", "desktop-resources-panel"].forEach((id) => {
        if (id !== panelId) {
          const otherPanel = document.getElementById(id);
          const otherBtn = document.getElementById(id.replace("-panel", "-btn"));
          const otherIcon = document.getElementById(id.replace("-panel", "-icon"));
          if (otherPanel) otherPanel.setAttribute("hidden", "");
          if (otherBtn) otherBtn.setAttribute("aria-expanded", "false");
          if (otherIcon) otherIcon.style.transform = "rotate(0deg)";
        }
      });
      if (isOpen) {
        dropPanel.setAttribute("hidden", "");
        dropBtn.setAttribute("aria-expanded", "false");
        if (dropIcon) dropIcon.style.transform = "rotate(0deg)";
      } else {
        dropPanel.removeAttribute("hidden");
        dropBtn.setAttribute("aria-expanded", "true");
        if (dropIcon) dropIcon.style.transform = "rotate(180deg)";
      }
    });
  }

  setupDesktopDropdown("desktop-services-btn", "desktop-services-panel", "desktop-services-icon");
  setupDesktopDropdown("desktop-rentals-btn", "desktop-rentals-panel", "desktop-rentals-icon");
  setupDesktopDropdown("desktop-areas-btn", "desktop-areas-panel", "desktop-areas-icon");
  setupDesktopDropdown("desktop-resources-btn", "desktop-resources-panel", "desktop-resources-icon");

  // Close desktop dropdowns on outside click or Escape
  document.addEventListener("click", () => {
    ["desktop-services", "desktop-rentals", "desktop-areas", "desktop-resources"].forEach((prefix) => {
      const panel = document.getElementById(`${prefix}-panel`);
      const btn = document.getElementById(`${prefix}-btn`);
      const icon = document.getElementById(`${prefix}-icon`);
      if (panel) panel.setAttribute("hidden", "");
      if (btn) btn.setAttribute("aria-expanded", "false");
      if (icon) icon.style.transform = "rotate(0deg)";
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      ["desktop-services", "desktop-rentals", "desktop-areas", "desktop-resources"].forEach((prefix) => {
        const panel = document.getElementById(`${prefix}-panel`);
        const btn = document.getElementById(`${prefix}-btn`);
        const icon = document.getElementById(`${prefix}-icon`);
        if (panel) panel.setAttribute("hidden", "");
        if (btn) btn.setAttribute("aria-expanded", "false");
        if (icon) icon.style.transform = "rotate(0deg)";
      });
    }
  });

  // Scroll-aware header shadow
  const header = document.getElementById("site-header");
  window.addEventListener("scroll", () => {
    if (header) {
      if (window.scrollY > 10) {
        header.classList.add("shadow-md");
        header.classList.remove("shadow-none");
      } else {
        header.classList.remove("shadow-md");
      }
    }
  }, { passive: true });
</script>

---
import { nap } from "../data/site";

const navLinks = [
  { label: "Services", href: "/services/" },
  { label: "Rentals", href: "/rentals/" },
  { label: "Service Areas", href: "/service-area/" },
  { label: "How It Works", href: "/#how-it-works" },
  { label: "FAQ", href: "/faq/" },
];
---

<header class="sticky top-0 z-50 bg-white/97 backdrop-blur-sm border-b border-neutral-100" style="box-shadow: 0 1px 8px rgba(0,0,0,0.05);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[60px] md:h-[68px]">

      <a href="/" class="shrink-0 hover:opacity-90 transition-opacity">
        <span class="font-display text-xl font-bold" style="color: #111111;">Kelari </span><span class="font-display text-xl font-bold" style="color: #E8356D;">Party Rentals</span>
      </a>

      <nav class="hidden lg:flex items-center gap-7" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium transition-colors"
            style="color: #374151;"
            onmouseover="this.style.color='#111111'"
            onmouseout="this.style.color='#374151'"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-4">
        <a
          href={`tel:${nap.contact.phone.replace(/\D/g, "")}`}
          class="flex items-center gap-2 text-sm font-medium transition-colors"
          style="color: #374151;"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" style="color: #E8356D;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {nap.contact.phone}
        </a>
        <a
          href="/quote/"
          class="inline-flex items-center justify-center text-white font-semibold px-5 py-2.5 rounded-lg text-sm transition-all duration-200"
          style="background: #E8356D; box-shadow: 0 2px 10px rgba(232,53,109,0.30);"
          onmouseover="this.style.background='#B5264F'"
          onmouseout="this.style.background='#E8356D'"
        >
          Request a Quote
        </a>
      </div>

      <button
        type="button"
        id="mobile-menu-btn"
        class="lg:hidden p-2 transition-colors"
        style="color: #374151;"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-100 bg-white">
    <nav class="flex flex-col px-4 py-3 gap-1" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="py-2.5 px-3 text-sm font-medium rounded-lg transition-colors"
          style="color: #374151;"
        >
          {link.label}
        </a>
      ))}
      <a
        href={`tel:${nap.contact.phone.replace(/\D/g, "")}`}
        class="py-2.5 px-3 text-sm font-medium rounded-lg transition-colors"
        style="color: #374151;"
      >
        {nap.contact.phone}
      </a>
      <a
        href="/quote/"
        class="text-white text-center font-semibold px-5 py-3 rounded-lg mt-2 transition-colors text-sm"
        style="background: #E8356D;"
      >
        Request a Quote
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const icon = document.getElementById("menu-icon");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
    if (icon) {
      icon.setAttribute(
        "d",
        isOpen
          ? "M6 18L18 6M6 6l12 12"
          : "M4 6h16M4 12h16M4 18h16",
      );
    }
  });
</script>

---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface Step {
  number?: string;
  title: string;
  description: string;
  icon?: string;
}

export interface Props {
  steps: Step[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "featured" | "none";
}

const {
  steps,
  eyebrow,
  title,
  subtitle,
  bg = "white",
  padding = "default",
} = Astro.props;

const isDark = bg === "dark";
---

<Section {bg} spacing={padding} width="wide">
  {(title || eyebrow) && (
    <div class="mb-10 md:mb-14">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} width="wide" />
    </div>
  )}

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((step, i) => (
      <div class:list={["card-surface relative", isDark && "card-surface-dark"]}>
        <div class="card-body items-start text-left">
          <div class="stat-card-value" aria-hidden="true">
            {step.icon ? <span class="text-2xl">{step.icon}</span> : <span>{step.number ?? String(i + 1)}</span>}
          </div>
          <h3 class:list={["card-title text-lg", isDark && "text-white"]}>{step.title}</h3>
          <p class:list={["card-copy card-copy-compact", isDark && "text-neutral-300"]}>
            {step.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</Section>

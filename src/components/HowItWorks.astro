---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface Step {
  number?: string;
  title: string;
  description: string;
  icon?: string;
}

export interface Props {
  steps: Step[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "featured" | "none";
}

const { steps, eyebrow, title, subtitle, bg = "light", padding = "featured" } = Astro.props;
const isDark = bg === "dark";
---

<Section {bg} spacing={padding} width="wide">
  {(title || eyebrow) && (
    <div class="mb-16 md:mb-20">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} />
    </div>
  )}

  <div class="relative grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Dashed connecting line (desktop only) -->
    <div class="absolute top-8 left-[12.5%] right-[12.5%] hidden lg:block border-t-2 border-dashed border-brand-pink/20" aria-hidden="true"></div>

    {steps.map((step, i) => (
      <div class="flex flex-col items-center text-center relative">
        <div class="w-16 h-16 rounded-full flex items-center justify-center font-display text-xl font-bold mb-6 shrink-0 relative z-10 bg-brand-pink text-white shadow-brand-button">
          {step.icon
            ? <span class="text-2xl">{step.icon}</span>
            : <span>{step.number ?? String(i + 1).padStart(2, "0")}</span>
          }
        </div>
        <h3 class:list={["font-display font-bold text-lg", isDark ? "text-white" : "text-neutral-900"]}>
          {step.title}
        </h3>
        <p class:list={["text-sm mt-2 leading-relaxed", isDark ? "text-neutral-300" : "text-neutral-600"]}>
          {step.description}
        </p>
      </div>
    ))}
  </div>
</Section>

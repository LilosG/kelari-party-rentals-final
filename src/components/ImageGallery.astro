---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface GalleryImage {
  src: ImageMetadata;
  alt: string;
}

export interface Props {
  images: GalleryImage[];
  columns?: 2 | 3 | 4;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "featured" | "none";
}

const {
  images,
  columns = 3,
  eyebrow,
  title,
  subtitle,
  bg = "white",
  padding = "default",
} = Astro.props;

const isDark = bg === "dark";

const colClass = {
  2: "grid-cols-2",
  3: "grid-cols-2 md:grid-cols-3",
  4: "grid-cols-2 md:grid-cols-3 lg:grid-cols-4",
}[columns];
---

<Section {bg} spacing={padding} width="wide">
  {(title || eyebrow) && (
    <div class="mb-12 md:mb-16">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} />
    </div>
  )}

  <div class={`grid gap-4 ${colClass}`}>
    {images.map((img) => (
      <div class="rounded-xl overflow-hidden aspect-[4/3] group">
        <Image
          src={img.src}
          alt={img.alt}
          widths={[400, 800]}
          sizes="(max-width: 639px) 50vw, (max-width: 767px) 33vw, 25vw"
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      </div>
    ))}
  </div>
</Section>

---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface GalleryImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

export interface Props {
  images: GalleryImage[];
  columns?: 2 | 3 | 4;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "none";
}

const {
  images,
  columns = 3,
  eyebrow,
  title,
  subtitle,
  bg = "white",
  padding = "default",
} = Astro.props;

const isDark = bg === "dark";

// Always 2 cols on mobile, then the specified count on larger screens
const colClass = {
  2: "grid-cols-2",
  3: "grid-cols-2 md:grid-cols-3",
  4: "grid-cols-2 md:grid-cols-3 lg:grid-cols-4",
}[columns];
---

<Section {bg} {padding}>
  {(title || eyebrow) && (
    <div class="mb-10 md:mb-14">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} />
    </div>
  )}

  <div class={`grid gap-4 ${colClass}`}>
    {images.map((img) => (
      <div class="rounded-xl overflow-hidden aspect-[4/3] group">
        <img
          src={img.src}
          alt={img.alt}
          width={img.width}
          height={img.height}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      </div>
    ))}
  </div>
</Section>

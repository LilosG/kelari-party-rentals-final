---
import { nap } from "../data/site";
import BrandWordmark from "./BrandWordmark.astro";
import Button from "./Button.astro";

const navLinks = [
  { label: "Services", href: "/services/" },
  { label: "Rentals", href: "/rentals/" },
  { label: "Service Areas", href: "/service-area/" },
  { label: "How It Works", href: "/#how-it-works" },
  { label: "FAQ", href: "/faq/" },
];
---

<header class="site-header sticky top-0 z-50 backdrop-blur-sm border-b border-neutral-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[58px] md:h-[64px]">

      <a href="/" class="shrink-0 hover:opacity-90 transition-opacity">
        <BrandWordmark size="md" />
      </a>

      <nav class="hidden lg:flex items-center gap-6" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="header-nav-link"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-3">
        <a
          href={`tel:${nap.contact.phone.replace(/\D/g, "")}`}
          class="header-contact"
        >
          <svg class="w-4 h-4 shrink-0 text-brand-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {nap.contact.phone}
        </a>
        <Button href="/quote/" variant="brand-soft" size="sm">
          Request a Quote
        </Button>
      </div>

      <button
        type="button"
        id="mobile-menu-btn"
        class="lg:hidden p-2 transition-colors text-[color:var(--text-subtle)] hover:text-neutral-900"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-100 bg-white">
    <nav class="flex flex-col px-4 py-3 gap-1" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="header-nav-link py-2.5 px-3 rounded-lg"
        >
          {link.label}
        </a>
      ))}
      <a
        href={`tel:${nap.contact.phone.replace(/\D/g, "")}`}
        class="header-nav-link py-2.5 px-3 rounded-lg"
      >
        {nap.contact.phone}
      </a>
      <Button href="/quote/" variant="brand-soft" size="sm" class="mt-2 w-full">
        Request a Quote
      </Button>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const icon = document.getElementById("menu-icon");

  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
    if (icon) {
      icon.setAttribute(
        "d",
        isOpen
          ? "M6 18L18 6M6 6l12 12"
          : "M4 6h16M4 12h16M4 18h16",
      );
    }
  });
</script>

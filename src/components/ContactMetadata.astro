---
import type { ContactMetaItem } from "../data/conversion";

interface Props {
  items: ContactMetaItem[];
  layout?: "rows" | "cards";
  surface?: "light" | "dark";
  showDescriptions?: boolean;
}

const {
  items,
  layout = "rows",
  surface = "light",
  showDescriptions = true,
} = Astro.props;

const isDark = surface === "dark";
const isCards = layout === "cards";
---

<div class={isCards ? "grid gap-4 sm:grid-cols-2" : "space-y-5"}>
  {items.map((item) => (
    <div
      class:list={[
        isCards
          ? isDark
            ? "rounded-[var(--radius-card)] border border-white/12 bg-white/6 p-5"
            : "rounded-[var(--radius-card)] border border-neutral-200 bg-neutral-50 p-5"
          : "flex items-start gap-4",
      ]}
    >
      <div class:list={[
        "flex h-10 w-10 shrink-0 items-center justify-center rounded-xl",
        isDark ? "bg-brand-pink/18 text-brand-pink-light" : "bg-brand-pink-light text-brand-pink",
      ]}>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
        </svg>
      </div>
      <div>
        <p class:list={[
          "mb-0.5 text-xs font-semibold uppercase tracking-[0.14em]",
          isDark ? "text-white/45" : "text-neutral-400",
        ]}>{item.label}</p>
        {item.href ? (
          <a href={item.href} class:list={[
            "font-medium transition-colors",
            isDark ? "text-white hover:text-brand-pink-light" : "text-neutral-800 hover:text-brand-pink",
          ]}>
            {item.value}
          </a>
        ) : (
          <p class:list={[isDark ? "text-white" : "text-neutral-800", "font-medium"]}>{item.value}</p>
        )}
        {showDescriptions && item.description && (
          <p class:list={[
            "mt-1 text-sm leading-relaxed",
            isDark ? "text-white/65" : "text-neutral-600",
          ]}>{item.description}</p>
        )}
      </div>
    </div>
  ))}
</div>

---
import type { ContactMetaItem } from "../data/conversion";

interface Props {
  items: ContactMetaItem[];
  layout?: "rows" | "cards";
  surface?: "light" | "dark";
  showDescriptions?: boolean;
}

const {
  items,
  layout = "rows",
  surface = "light",
  showDescriptions = true,
} = Astro.props;

const isDark = surface === "dark";
const isCards = layout === "cards";
---

<div class:list={[isCards ? "grid gap-3 sm:grid-cols-2" : "space-y-4"]}>
  {items.map((item) => (
    <div class:list={[
      "flex items-start gap-3",
      isCards
        ? isDark
          ? "rounded-xl border border-white/10 bg-white/5 p-4"
          : "rounded-xl border border-neutral-100 bg-neutral-50 p-4"
        : "",
    ]}>
      <div class:list={[
        "flex h-9 w-9 shrink-0 items-center justify-center rounded-lg",
        isDark ? "bg-brand-pink/20 text-brand-pink-light" : "bg-brand-pink-light text-brand-pink",
      ]}>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
        </svg>
      </div>
      <div>
        <p class:list={["text-xs font-semibold uppercase tracking-wider mb-0.5", isDark ? "text-white/65" : "text-neutral-400"]}>
          {item.label}
        </p>
        {item.href ? (
          <a href={item.href} class:list={["text-sm font-medium transition-colors", isDark ? "text-white hover:text-brand-pink-light" : "text-neutral-800 hover:text-brand-pink"]}>
            {item.value}
          </a>
        ) : (
          <p class:list={["text-sm font-medium", isDark ? "text-white" : "text-neutral-800"]}>{item.value}</p>
        )}
        {showDescriptions && item.description && (
          <p class:list={["mt-0.5 text-xs leading-relaxed", isDark ? "text-white/80" : "text-neutral-500"]}>
            {item.description}
          </p>
        )}
      </div>
    </div>
  ))}
</div>

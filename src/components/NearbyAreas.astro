---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import { getCityImage } from "../data/images";

export interface AreaCard {
  name: string;
  tagline: string;
  href: string;
  image?: string;
}

export interface Props {
  areas: AreaCard[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "none";
}

const {
  areas,
  eyebrow,
  title,
  subtitle,
  bg = "light",
  padding = "default",
} = Astro.props;

const isDark = bg === "dark";

function getAreaImage(area: AreaCard): string {
  if (area.image) return area.image;
  const slug = area.href.split("/").filter(Boolean)[0] ?? "";
  return getCityImage(slug);
}
---

<Section {bg} {padding}>
  {(title || eyebrow) && (
    <div class="mb-10 md:mb-14">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} dark={isDark} />
    </div>
  )}

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {areas.map((area) => (
      <a
        href={area.href}
        class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 border border-neutral-100 overflow-hidden group"
      >
        <div class="aspect-[4/3] overflow-hidden">
          <img
            src={getAreaImage(area)}
            alt={area.name}
            width="1200"
            height="900"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
        <div class="p-5 flex flex-col flex-1 text-center">
          <h3 class:list={[
            "font-display text-lg font-bold group-hover:text-brand-pink transition-colors",
            isDark ? "text-white" : "text-neutral-800",
          ]}>
            {area.name}
          </h3>
          <p class:list={[
            "mt-1 text-sm",
            isDark ? "text-neutral-400" : "text-neutral-500",
          ]}>
            {area.tagline}
          </p>
          <span class="mt-3 text-sm font-semibold text-brand-pink group-hover:underline">
            View {area.name} &rarr;
          </span>
        </div>
      </a>
    ))}
  </div>
</Section>

---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface AreaCard {
  name: string;
  tagline: string;
  href: string;
  image?: string;
}

export interface Props {
  areas: AreaCard[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "featured" | "none";
}

const {
  areas,
  eyebrow,
  title,
  subtitle,
  bg = "light",
  padding = "default",
} = Astro.props;
---

<Section {bg} spacing={padding} width="wide">
  {(title || eyebrow) && (
    <div class="mb-10 md:mb-14">
      <SectionHeader {eyebrow} title={title ?? ""} {subtitle} width="wide" />
    </div>
  )}

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {areas.map((area) => (
      <a href={area.href} class="compact-link-card group">
        <div>
          <h3 class="font-display text-lg font-bold text-neutral-900 transition-colors group-hover:text-brand-pink">
            {area.name}
          </h3>
          <p class="mt-1 text-sm leading-relaxed text-neutral-500">{area.tagline}</p>
        </div>
        <span class="text-brand-pink transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
      </a>
    ))}
  </div>
</Section>

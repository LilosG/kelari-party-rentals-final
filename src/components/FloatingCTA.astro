---
import { nap, booqableStore } from "../data/site";
import Button from "./Button.astro";
---

<div
  id="floating-cta"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full transition-transform duration-300 lg:hidden"
>
  <div
    class="flex items-center gap-3 border-t border-neutral-100 bg-white px-4 py-3 shadow-[0_-4px_20px_rgba(0,0,0,0.08)]"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
  >
    <Button
      href={`tel:${nap.contact.phone.replace(/\D/g, "")}`}
      variant="outline-brand"
      size="md"
      class="flex-1 justify-center"
    >
      Call Now
    </Button>
    <Button
      href={booqableStore}
      target="_blank"
      rel="noopener noreferrer"
      variant="brand"
      size="md"
      class="flex-1 justify-center"
    >
      Book Now
    </Button>
  </div>
</div>

<script>
  const bar = document.getElementById("floating-cta");
  let ticking = false;

  function updateBar() {
    if (!bar) return;
    if (window.scrollY > 300) {
      bar.classList.remove("translate-y-full");
    } else {
      bar.classList.add("translate-y-full");
    }
    ticking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        requestAnimationFrame(updateBar);
        ticking = true;
      }
    },
    { passive: true }
  );

  updateBar();
</script>

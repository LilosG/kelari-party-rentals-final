---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface Props {
  neighborhoods: string[];
  eyebrow?: string;
  title?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "none";
}

const {
  neighborhoods,
  eyebrow,
  title,
  bg = "white",
  padding = "compact",
} = Astro.props;

const isDark = bg === "dark";
---

<Section {bg} {padding}>
  {(title || eyebrow) && (
    <div class="mb-6">
      <SectionHeader
        eyebrow={eyebrow}
        title={title ?? ""}
        align="left"
        dark={isDark}
      />
    </div>
  )}

  <div class="flex flex-wrap gap-3">
    {neighborhoods.map((name) => (
      <span class:list={[
        "inline-flex items-center px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200",
        isDark
          ? "bg-white/10 text-neutral-200 border border-white/20 hover:bg-white/20"
          : "bg-neutral-100 text-neutral-700 hover:bg-brand-pink-light hover:text-brand-pink",
      ]}>
        {name}
      </span>
    ))}
  </div>
</Section>

---
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

export interface Props {
  neighborhoods: string[];
  eyebrow?: string;
  title?: string;
  bg?: "white" | "light" | "dark" | "pink-light";
  padding?: "default" | "compact" | "none";
}

const {
  neighborhoods,
  eyebrow,
  title,
  bg = "light",
  padding = "compact",
} = Astro.props;

const isDark = bg === "dark";
---

<Section {bg} spacing={padding} width="wide">
  {(title || eyebrow) && (
    <div class="mb-7">
      <SectionHeader eyebrow={eyebrow} title={title ?? ""} align="center" dark={isDark} />
    </div>
  )}

  <div class="flex flex-wrap justify-center gap-3">
    {neighborhoods.map((name) => (
      <span class:list={[
        "inline-flex items-center px-4 py-2 rounded-full text-sm font-medium border transition-all duration-200",
        isDark
          ? "bg-white/8 text-neutral-200 border-white/15 hover:bg-white/14"
          : "bg-neutral-100 text-neutral-700 border-neutral-200 hover:bg-brand-pink-light hover:text-brand-pink hover:border-brand-pink-light",
      ]}>
        {name}
      </span>
    ))}
  </div>
</Section>

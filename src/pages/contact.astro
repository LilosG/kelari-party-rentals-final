---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalHero from "../components/LocalHero.astro";
import TrustBar from "../components/TrustBar.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import QuoteForm from "../components/QuoteForm.astro";
import ContactMetadata from "../components/ContactMetadata.astro";
import ConversionProofPoints from "../components/ConversionProofPoints.astro";

import { site, nap } from "../data/site";
import { contactMetaItems, conversionProofPoints } from "../data/conversion";

const mapsEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(`${nap.name}, ${nap.address.city}, ${nap.address.state}`)}&output=embed&z=15`;

const title = "Contact Kelari Party Rentals | Party Rentals in Carlsbad CA";
const description =
  "Get in touch with Kelari Party Rentals. Call, email, or visit us in Carlsbad. We respond within 2 hours during business hours.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    url: `${site.domain}/contact/`,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      { "@type": "ListItem", position: 2, name: "Contact", item: `${site.domain}/contact/` },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${site.domain}/contact/`}
  schema={schema}
>
  <LocalHero
    title="Contact Us"
    subtitle="Questions about rentals? Ready to book? We're here to help."
    bgImage="/images/hero-party.jpg"
  />

  <TrustBar />

  <QuoteForm
    heading="Send Us a Message"
    subheading="Fill out the form below and we'll get back to you within 2 hours during business hours."
  />

  <Section bg="white">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeader
          eyebrow="CONTACT INFO"
          title="Get in Touch"
          align="left"
        />
        <p class="mt-6 leading-relaxed text-neutral-600">
          Have a question about our rentals, delivery, or pricing? Want to check availability for your event? Reach out and we'll get back to you within 2 hours during business hours.
        </p>

        <div class="mt-8">
          <ContactMetadata items={contactMetaItems} layout="rows" />
        </div>

        <div class="mt-8">
          <ConversionProofPoints items={conversionProofPoints} compact={true} />
        </div>

        <div class="mt-8 border-t border-neutral-200 pt-6">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-neutral-400">Follow Us</p>
          <div class="flex gap-4">
            <a href={site.social.google} target="_blank" rel="noopener noreferrer"
               class="text-sm font-medium text-neutral-600 transition-colors hover:text-brand-pink">
              Google
            </a>
          </div>
        </div>
      </div>

      <div>
        <div class="mb-6">
          <SectionHeader
            eyebrow="WHY CUSTOMERS REACH OUT"
            title="The same details you'll see across every conversion point"
            subtitle="Call, email, or send a form submission knowing exactly how fast we reply and what comes with your quote."
            align="left"
          />
        </div>
        <ContactMetadata items={contactMetaItems.filter(({ label }) => label !== "Address")} layout="cards" />

        <div class="mt-8 aspect-[4/3] overflow-hidden rounded-2xl border border-neutral-200 shadow-sm">
          <iframe
            src={mapsEmbedSrc}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Map showing ${nap.name} location in ${nap.address.city}`}
          ></iframe>
        </div>
        <p class="mt-3 text-center text-sm text-neutral-500">
          {nap.address.full}
        </p>
      </div>
    </div>
  </Section>

</BaseLayout>

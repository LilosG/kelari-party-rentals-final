---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalHero from "../../components/LocalHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import Section from "../../components/Section.astro";
import CategoryGrid from "../../components/CategoryGrid.astro";
import CtaBand from "../../components/CtaBand.astro";
import QuoteForm from "../../components/QuoteForm.astro";

import { site, nap } from "../../data/site";
import { categories } from "../../data/categories";

const title = "Party Rental Inventory | Kelari Party Rentals";
const description =
  "Browse our full party rental inventory — tables, chairs, tents, linens, tableware, decorations & lighting. Free delivery in North County San Diego.";

const categoryCards = categories.map((cat) => ({
  name: cat.name,
  description: cat.subheadline,
  href: `/rentals/${cat.slug}/`,
  icon: cat.icon,
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    url: `${site.domain}/rentals/`,
    description,
    provider: { "@id": `${site.domain}/#localbusiness` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      {
        "@type": "ListItem",
        position: 2,
        name: "Rentals",
        item: `${site.domain}/rentals/`,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${site.domain}/rentals/`}
  schema={schema}
>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title="Party Rental Inventory"
    subtitle="Tables, chairs, tents, linens, tableware, decorations & lighting — everything you need for your next celebration."
    bgImage="/images/gallery-tablescape.jpg"
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 3 · Intro — white ────────────────────────── -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-lg md:text-xl text-neutral-600 leading-relaxed">
        Browse our full rental inventory below. Every item includes free delivery, professional setup, and same-day pickup across Carlsbad, Encinitas, Oceanside, and San Marcos.
      </p>
    </div>
  </Section>

  <!-- 4 · Category Grid — light ────────────────── -->
  <CategoryGrid
    eyebrow="BROWSE INVENTORY"
    title="Rental Categories"
    subtitle="Select a category to see every item we carry, along with available sizes and styles."
    categories={categoryCards}
    columns={3}
    bg="light"
  />

  <!-- 5 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title="Need Help Choosing?"
    subtitle="Not sure what you need? Tell us about your event and we'll recommend the perfect rental package — no obligation."
    primaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    secondaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 6 · Quote Form — dark ────────────────────── -->
  <QuoteForm
    heading="Request a Custom Quote"
    subheading="Share your event details and we'll put together a rental package tailored to your needs."
  />

</BaseLayout>

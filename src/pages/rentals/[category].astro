---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalHero from "../../components/LocalHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import Section from "../../components/Section.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CtaBand from "../../components/CtaBand.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import CityCards from "../../components/CityCards.astro";

import OccasionStrip from "../../components/OccasionStrip.astro";
import WhatsIncluded from "../../components/WhatsIncluded.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import TestimonialCarousel from "../../components/TestimonialCarousel.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import { Image } from 'astro:assets';
import { site, nap, booqableStore } from "../../data/site";
import { categories, type Category } from "../../data/categories";
import { services as allServices } from "../../data/services";
import { cities } from "../../data/cities";
import { howItWorksSteps, testimonials } from "../../data/homepage";

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;

const cityCards = cities.map((c) => ({
  name: c.name,
  description: `${category.name} rentals in ${c.name}.`,
  href: `/${c.slug}/`,
}));

const categoryImages: Record<string, string> = {
  tables: "/images/gallery-tablescape.jpg",
  chairs: "/images/backyard-party.jpg",
  "tents-canopies": "/images/gallery-canopy.jpg",
  linens: "/images/baby-shower.jpg",
  tableware: "/images/gallery-tablescape.jpg",
  decorations: "/images/gallery-marquee.jpg",
  lighting: "/images/engagement-party.jpg",
};
const bgImage = categoryImages[category.slug] ?? "/images/hero-party.jpg";

const otherCategories = categories.filter((c) => c.slug !== category.slug);

const relatedServiceData = category.relatedServices
  .map((slug) => allServices.find((s) => s.slug === slug))
  .filter((s): s is (typeof allServices)[number] => Boolean(s));

const catName = category.name;
const catNameLower = category.name.toLowerCase();
const titleIncluded = "What's Included with Every " + catName + " Rental";
const subtitleIncluded = "Delivered across North County San Diego — complimentary warehouse pickup always available at our Carlsbad location.";
const titleHowItWorks = "How " + catName + " Rentals Work";
const titleFaq = catName + " Rentals — Frequently Asked Questions";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: category.meta.title,
    url: `${site.domain}/rentals/${category.slug}/`,
    description: category.meta.description,
    provider: { "@id": `${site.domain}/#localbusiness` },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: category.meta.title,
    url: `${site.domain}/rentals/${category.slug}/`,
    description: category.meta.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      {
        "@type": "ListItem",
        position: 2,
        name: "Rentals",
        item: `${site.domain}/rentals/`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: category.name,
        item: `${site.domain}/rentals/${category.slug}/`,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: category.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={category.meta.title}
  description={category.meta.description}
  canonical={`${site.domain}/rentals/${category.slug}/`}
  schema={schema}
>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title={category.headline}
    subtitle={category.subheadline}
    bgImage={bgImage}
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 3 · Occasion Strip ───────────────────────── -->
  <OccasionStrip heading="We Specialize In" />

  <!-- 4 · Intro — white ────────────────────────── -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <p class="font-body uppercase tracking-[0.18em] text-[0.68rem] font-bold mb-5 text-brand-pink">
        ABOUT THIS RENTAL
      </p>
      <div class="border-t border-neutral-200 pt-6">
        <p class="text-lg md:text-xl text-neutral-600 leading-relaxed">
          {category.intro}
        </p>
      </div>
    </div>
  </Section>

  <!-- 5 · Items Grid — light ───────────────────── -->
  <Section bg="light">
    <div class="mb-10 md:mb-14">
      <SectionHeader
        eyebrow="BROWSE ITEMS"
        title={`Available ${category.name}`}
        subtitle={`Delivered across North County San Diego — complimentary warehouse pickup always available.`}
      />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {category.items.map((item) => (
        <div class="bg-white rounded-2xl border border-neutral-200 shadow-sm p-6 flex flex-col">
          {item.image ? (
            <div class="aspect-[4/3] rounded-xl overflow-hidden mb-4">
              <Image
                src={item.image}
                alt={item.name}
                width={400}
                height={300}
                class="w-full h-full object-cover"
              />
            </div>
          ) : (
            <div class="aspect-[4/3] rounded-xl bg-brand-pink-light mb-4 flex items-center justify-center">
              <span class="text-5xl" aria-hidden="true">{category.icon}</span>
            </div>
          )}
          <h3 class="font-display text-lg font-bold text-neutral-800">{item.name}</h3>
          <p class="mt-1.5 text-sm text-neutral-600 leading-relaxed flex-1">
            {item.description}
          </p>
          {item.sizes && item.sizes.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {item.sizes.map((size) => (
                <span class="text-xs px-2.5 py-1 bg-brand-pink-light text-brand-pink rounded-full font-medium border border-brand-pink/20">
                  {size}
                </span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </Section>

  <!-- 6 · What's Included — white ─────────────── -->
  <WhatsIncluded
    eyebrow="FULL-SERVICE RENTALS"
    title={titleIncluded}
    subtitle={subtitleIncluded}
    items={category.whatsIncluded}
    columns={3}
    bg="white"
  />

  <!-- 7 · How It Works — light ─────────────────── -->
  <HowItWorks
    eyebrow="HOW IT WORKS"
    title={titleHowItWorks}
    subtitle="From your first quote to post-event pickup we handle every step so you can focus on celebrating."
    steps={howItWorksSteps}
    bg="light"
  />

  <!-- 8 · Testimonials — white ─────────────────── -->
  <TestimonialCarousel
    eyebrow="REVIEWS"
    title="Trusted by Families Across North County"
    subtitle="Hundreds of events served across Carlsbad, Encinitas, Oceanside, San Marcos, and Vista."
    testimonials={testimonials}
    bg="white"
  />

  <!-- 9 · Other Categories — light ────────────── -->
  <Section bg="light">
    <div class="mb-10 md:mb-12">
      <SectionHeader
        eyebrow="MORE RENTALS"
        title="Browse Other Categories"
      />
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
      {otherCategories.map((cat) => (
        <a
          href={`/rentals/${cat.slug}/`}
          class="bg-white border border-neutral-200 rounded-2xl p-4 text-center hover:border-brand-pink hover:shadow-[0_8px_40px_rgba(200,80,122,0.15)] transition-all duration-300 group"
        >
          <span class="text-2xl block mb-2" aria-hidden="true">{cat.icon}</span>
          <span class="text-sm font-semibold text-neutral-800 group-hover:text-brand-pink transition-colors font-display">
            {cat.name}
          </span>
        </a>
      ))}
    </div>
  </Section>

  <!-- 11 · City Cards — white ──────────────── -->
  <CityCards
    eyebrow="SERVICE AREAS"
    title={`${category.name} Rentals by City`}
    subtitle={`${category.name} rentals available across North County San Diego.`}
    cities={cityCards}
    bg="white"
  />

  <!-- 10 · FAQ — light ──────────────────────────── -->
  <FAQAccordion
    eyebrow="FAQ"
    title={titleFaq}
    faqs={category.faqs}
    bg="light"
  />

  <!-- 11 · Related Services — white ───────────── -->
  {relatedServiceData.length > 0 && (
    <Section bg="white">
      <div class="mb-10 md:mb-12">
        <SectionHeader
          eyebrow="POPULAR OCCASIONS"
          title={`${category.name} for Every Event Type`}
          subtitle={`See how we use ${category.name.toLowerCase()} across our most popular party rental services.`}
        />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
        {relatedServiceData.map((service) => (
          <a
            href={`/services/${service.slug}/`}
            class="group flex flex-col bg-white rounded-2xl border border-neutral-100 p-6 shadow-sm hover:shadow-[0_8px_40px_rgba(200,68,122,0.12)] hover:border-brand-pink/30 transition-all duration-300"
          >
            <span class="text-2xl mb-3" aria-hidden="true">{service.icon}</span>
            <h3 class="font-display font-bold text-neutral-900 text-lg mb-2 group-hover:text-brand-pink transition-colors">
              {service.name}
            </h3>
            <p class="text-sm text-neutral-600 leading-relaxed flex-1">
              {service.subheadline}
            </p>
            <span class="inline-flex items-center gap-1 text-sm font-semibold mt-4 text-brand-pink group-hover:gap-2 transition-all duration-200">
              View packages <span aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </Section>
  )}

  <!-- 12 · CTA Band — dark ─────────────────────── -->
  <CtaBand
    title={`Need ${category.name} for Your Event?`}
    subtitle={`Get a quote for ${category.name.toLowerCase()} rentals. Delivery available across North County SD.`}
    primaryCta={{ label: "Book Now", href: booqableStore }}
    secondaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    tertiaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 13 · Quote Form — dark ───────────────────── -->
  <QuoteForm
    heading={`Get a ${category.name} Rental Quote`}
    subheading={`Tell us about your event and we'll recommend the perfect ${category.name.toLowerCase()} for your setup.`}
  />

</BaseLayout>

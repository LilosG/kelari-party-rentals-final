---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalHero from "../../components/LocalHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import Section from "../../components/Section.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import ServiceGrid from "../../components/ServiceGrid.astro";
import NeighborhoodTags from "../../components/NeighborhoodTags.astro";
import ParksList from "../../components/ParksList.astro";
import CtaBand from "../../components/CtaBand.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import CityCards from "../../components/CityCards.astro";
import QuoteForm from "../../components/QuoteForm.astro";

import { site, nap } from "../../data/site";
import { cities, type City } from "../../data/cities";
import { testimonials, galleryImages } from "../../data/homepage";
import TestimonialCarousel from "../../components/TestimonialCarousel.astro";
import ImageGallery from "../../components/ImageGallery.astro";

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

interface Props {
  city: City;
}

const { city } = Astro.props;

const cityImages: Record<string, string> = {
  carlsbad: "/images/hero-party.jpg",
  encinitas: "/images/backyard-party.jpg",
  oceanside: "/images/park-party.jpg",
  "san-marcos": "/images/graduation-party.jpg",
};
const bgImage = cityImages[city.slug] ?? "/images/hero-party.jpg";

const nearbyAreas = cities
  .filter((c) => c.slug !== city.slug)
  .map((c) => ({
    name: c.name,
    tagline: c.subheadline,
    href: `/${c.slug}/`,
  }));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name: nap.name,
    url: `${site.domain}/${city.slug}/`,
    telephone: nap.contact.phone,
    email: nap.contact.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: `${nap.address.street} ${nap.address.suite}`,
      addressLocality: nap.address.city,
      addressRegion: nap.address.state,
      postalCode: nap.address.zip,
      addressCountry: "US",
    },
    geo: site.schema.geo,
    openingHours: "Mo-Su 09:00-19:00",
    priceRange: site.schema.priceRange,
    areaServed: {
      "@type": "City",
      name: `${city.name}, ${city.state}`,
    },
    sameAs: site.schema.sameAs,
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: `Party Rentals in ${city.name}`,
    provider: {
      "@type": "LocalBusiness",
      name: nap.name,
    },
    areaServed: {
      "@type": "City",
      name: `${city.name}, ${city.state}`,
    },
    description: city.meta.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: city.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: city.meta.title,
    url: `${site.domain}/${city.slug}/`,
    description: city.meta.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: site.domain,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: city.name,
        item: `${site.domain}/${city.slug}/`,
      },
    ],
  },
];
---

<BaseLayout
  title={city.meta.title}
  description={city.meta.description}
  canonical={`${site.domain}/${city.slug}/`}
  schema={schema}
>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title={city.headline}
    subtitle={city.subheadline}
    bgImage={bgImage}
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 3 · Intro — white ────────────────────────── -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-lg md:text-xl text-neutral-600 leading-relaxed">
        {city.intro}
      </p>
    </div>
  </Section>

  <!-- 4 · Services — light ─────────────────────── -->
  <ServiceGrid
    eyebrow="OUR SERVICES"
    title={`Party Rental Services in ${city.name}`}
    subtitle={`Every service includes free delivery, setup, and pickup throughout ${city.name}.`}
    slugs={city.services}
    citySlug={city.slug}
    columns={4}
    bg="light"
  />

  <!-- 5 · Neighborhoods — white (compact) ──────── -->
  <NeighborhoodTags
    eyebrow="NEIGHBORHOODS"
    title={`${city.name} Neighborhoods We Serve`}
    neighborhoods={city.neighborhoods}
    bg="white"
    padding="compact"
  />

  <!-- 6 · Parks — light (compact) ─────────────── -->
  <ParksList
    eyebrow="POPULAR VENUES"
    title={`Popular ${city.name} Parks for Parties`}
    parks={city.parks.map((p) => ({ name: p }))}
    bg="light"
    padding="compact"
  />

  <!-- 7 · Local Proof — white ──────────────────── -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <SectionHeader
        eyebrow="LOCAL EXPERTS"
        title={`Your ${city.name} Party Rental Team`}
      />
      <p class="mt-6 text-lg text-neutral-600 leading-relaxed">
        {city.localProof}
      </p>
      <p class="mt-3 text-base text-neutral-500">
        {city.deliveryNote}
      </p>
    </div>
  </Section>

  <!-- 8 · Gallery — white ─────────────────────── -->
  <ImageGallery
    eyebrow="RECENT SETUPS"
    title={`Party Setups in ${city.name}`}
    subtitle={`Real events we've delivered and set up across ${city.name} and surrounding North County San Diego.`}
    images={galleryImages.slice(0, 8)}
    columns={4}
    bg="white"
  />

  <!-- 9 · Testimonials — light ─────────────────── -->
  <TestimonialCarousel
    eyebrow="REVIEWS"
    title={`Trusted by ${city.name} Families`}
    subtitle={`Hundreds of events served across ${city.name} and surrounding North County communities.`}
    testimonials={testimonials}
    bg="light"
  />

  <!-- 10 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title={`Plan Your ${city.name} Party`}
    subtitle={`Get a free quote for tables, chairs, tents & décor delivered to your ${city.name} venue. We handle setup and pickup.`}
    primaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    secondaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 11 · FAQ — light ──────────────────────────── -->
  <FAQAccordion
    eyebrow="FAQ"
    title={`${city.name} Party Rental FAQs`}
    faqs={city.faqs}
    bg="light"
  />

  <!-- 12 · Nearby Cities — white ───────────────── -->
  <CityCards
    eyebrow="NEARBY CITIES"
    title="We Also Serve"
    subtitle="Free delivery and full-service setup in every North County San Diego city."
    cities={nearbyAreas.map((a) => ({ name: a.name, description: a.tagline, href: a.href }))}
    bg="white"
    padding="default"
  />

  <!-- 13 · Quote Form — dark ───────────────────── -->
  <QuoteForm
    heading={`Get a Free Quote for ${city.name}`}
    subheading={`Tell us about your ${city.name} event and we'll put together a custom rental package.`}
    city={city.slug}
  />

</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalHero from "../components/LocalHero.astro";
import TrustBar from "../components/TrustBar.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import QuoteForm from "../components/QuoteForm.astro";

import { site, nap } from "../data/site";

const title = "Get a Free Quote | Kelari Party Rentals";
const description =
  "Request a free, no-obligation party rental quote. Tables, chairs, tents, linens & décor with free delivery in Carlsbad, Encinitas, Oceanside & San Marcos.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    url: `${site.domain}/quote/`,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      { "@type": "ListItem", position: 2, name: "Get a Quote", item: `${site.domain}/quote/` },
    ],
  },
];

const benefits = [
  {
    icon: "✅",
    title: "Free & No-Obligation",
    text: "Your quote is completely free. No commitment required — take your time deciding.",
  },
  {
    icon: "⚡",
    title: "Fast Response",
    text: "We respond within 2 hours during business hours. Most quotes are ready same-day.",
  },
  {
    icon: "🚚",
    title: "Everything Included",
    text: "Your quote includes delivery, setup, and pickup — no hidden fees or surprise charges.",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${site.domain}/quote/`}
  schema={schema}
>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title="Get a Free Quote"
    subtitle="Tell us about your event and we'll put together a custom rental package — no obligation, no pressure."
    bgImage="/images/baby-shower.jpg"
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 3 · Why Quote with Us — white ────────────── -->
  <Section bg="white">
    <div class="max-w-4xl mx-auto">
      <div class="mb-10">
        <SectionHeader
          eyebrow="HOW IT WORKS"
          title="Quick, Free, and No Pressure"
          subtitle="Three reasons to get your quote today."
        />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
        {benefits.map((item) => (
          <div class="text-center p-6 bg-neutral-50 rounded-2xl border border-neutral-200">
            <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-brand-pink-light flex items-center justify-center">
              <span class="text-2xl" aria-hidden="true">{item.icon}</span>
            </div>
            <h3 class="font-display text-lg font-bold text-neutral-800">{item.title}</h3>
            <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- 4 · Quote Form — dark ────────────────────── -->
  <QuoteForm
    heading="Request Your Quote"
    subheading="Share your event details below. The more info you provide, the more accurate your quote will be."
  />

  <!-- 5 · Prefer to Call — light ───────────────── -->
  <Section bg="light">
    <div class="max-w-2xl mx-auto text-center">
      <SectionHeader
        eyebrow="CALL US"
        title="Prefer to Talk?"
        subtitle="Call us directly and we'll walk you through options and pricing over the phone."
      />
      <a
        href={`tel:${nap.contact.phone.replace(/\D/g, "")}`}
        class="inline-flex items-center justify-center mt-8 px-8 py-4 bg-brand-pink hover:bg-brand-pink/90 text-white font-semibold rounded-lg transition-colors text-base"
      >
        Call {nap.contact.phone}
      </a>
      <p class="mt-3 text-sm text-neutral-500">{nap.contact.hours}</p>
    </div>
  </Section>

</BaseLayout>

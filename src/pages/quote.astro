---
import BaseLayout from "../layouts/BaseLayout.astro";
import SchemaWebPage from "../components/schema/SchemaWebPage.astro";
import SchemaBreadcrumb from "../components/schema/SchemaBreadcrumb.astro";
import LocalHero from "../components/LocalHero.astro";
import TrustBar from "../components/TrustBar.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import QuoteForm from "../components/QuoteForm.astro";
import ConversionProofPoints from "../components/ConversionProofPoints.astro";
import ContactMetadata from "../components/ContactMetadata.astro";

import { site } from "../data/site";
import { contactMetaItems, conversionProofPoints } from "../data/conversion";

const title = "Get a Free Quote | Kelari Party Rentals";
const description =
  "Request a free, no-obligation party rental quote. Tables, chairs, tents, linens & décor with free delivery in Carlsbad, Encinitas, Oceanside & San Marcos.";

const pageUrl = `${site.domain}/quote/`;

const quoteContactItems = contactMetaItems.filter(({ label }) => ["Phone", "Email", "Hours"].includes(label));
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
>

  <SchemaWebPage type="WebPage" name={title} url={pageUrl} description={description} />
  <SchemaBreadcrumb
    pageUrl={pageUrl}
    items={[
      { name: "Home", url: site.domain },
      { name: "Get a Quote", url: pageUrl },
    ]}
  />
  <LocalHero
    title="Get a Free Quote"
    subtitle="Tell us about your event and we'll put together a custom rental package — no obligation, no pressure."
    bgImage="/images/baby-shower.jpg"
  />

  <TrustBar />

  <Section bg="white">
    <div class="mx-auto max-w-5xl">
      <div class="mb-10">
        <SectionHeader
          eyebrow="HOW IT WORKS"
          title="Here's What Happens Next"
          subtitle="Submit your details and we'll respond within 2 hours with a custom quote — delivery, setup, and pickup always included."
        />
      </div>
      <ConversionProofPoints items={conversionProofPoints} />

      <div class="mt-8">
        <ContactMetadata items={quoteContactItems} layout="cards" />
      </div>
    </div>
  </Section>

  <QuoteForm
    heading="Request Your Quote"
    subheading="Share your event details below. The more info you provide, the more accurate your quote will be."
  />

  <Section bg="light">
    <div class="mx-auto max-w-2xl text-center">
      <SectionHeader
        eyebrow="CALL US"
        title="Prefer to Talk?"
        subtitle="Call us directly and we'll walk you through options, timing, and pricing over the phone."
      />
      <a
        href={quoteContactItems[0]?.href}
        class="mt-8 inline-flex items-center justify-center px-8 py-4 text-base bg-brand-pink hover:bg-brand-pink-dark text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300"
      >
        Call {quoteContactItems[0]?.value}
      </a>
      <p class="mt-3 text-sm text-neutral-500">{quoteContactItems[2]?.value}</p>
    </div>
  </Section>

</BaseLayout>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroParty from '../assets/images/hero-party.jpg';
import galleryCanopy from '../assets/images/gallery-canopy.jpg';
import birthdayParty from '../assets/images/birthday-party.jpg';
import backyardParty from '../assets/images/backyard-party.jpg';
import babyShower from '../assets/images/baby-shower.jpg';
import graduationParty from '../assets/images/graduation-party.jpg';
import engagementParty from '../assets/images/engagement-party.jpg';
import parkParty from '../assets/images/park-party.jpg';

import BaseLayout from "../layouts/BaseLayout.astro";
import LocalHero from "../components/LocalHero.astro";
import TrustBar from "../components/TrustBar.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CategoryGrid from "../components/CategoryGrid.astro";
import HowItWorks from "../components/HowItWorks.astro";
import CtaBand from "../components/CtaBand.astro";
import ImageGallery from "../components/ImageGallery.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CityCards from "../components/CityCards.astro";

import { site, nap } from "../data/site";
import { categories } from "../data/categories";
import { cities } from "../data/cities";
import { services as allServices } from "../data/services";
import {
  hero,
  trustBarItems,
  ctaBand,
  howItWorksSteps,
  testimonials,
  galleryImages,
  homepageFaqs,
  topServiceSlugs,
} from "../data/homepage";

const title = `Party Rentals in Carlsbad & North County San Diego | ${nap.name}`;
const description = site.description;

const categoryCards = categories.map((c) => ({
  name: c.name,
  description: c.subheadline,
  href: `/rentals/${c.slug}/`,
  icon: c.icon,
}));

const cityCards = cities.map((c) => ({
  name: c.name,
  description: c.subheadline,
  href: `/${c.slug}/`,
}));

const serviceImages: Record<string, ImageMetadata> = {
  "party-rentals": galleryCanopy,
  "birthday-party-rentals": birthdayParty,
  "backyard-party-rentals": backyardParty,
  "baby-shower-rentals": babyShower,
  "graduation-party-rentals": graduationParty,
  "engagement-party-rentals": engagementParty,
  "engagement-party-rentals": engagementParty,
  "park-party-rentals": parkParty,
};

const featuredServices = topServiceSlugs
  .map((slug) => allServices.find((s) => s.slug === slug))
  .filter((s): s is (typeof allServices)[number] => Boolean(s))
  .map((s) => ({
    ...s,
    href: `/services/${s.slug}/`,
    image: serviceImages[s.slug] ?? heroParty,
  }));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": site.schema["@type"],
    "@id": `${site.domain}/#localbusiness`,
    name: nap.name,
    url: site.domain,
    logo: site.schema.logo,
    image: site.schema.image,
    description: site.description,
    telephone: nap.contact.phone,
    email: nap.contact.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: `${nap.address.street} ${nap.address.suite}`,
      addressLocality: nap.address.city,
      addressRegion: nap.address.state,
      postalCode: nap.address.zip,
      addressCountry: "US",
    },
    geo: site.schema.geo,
    openingHoursSpecification: site.schema.openingHoursSpecification,
    priceRange: site.schema.priceRange,
    areaServed: site.schema.areaServed,
    sameAs: site.schema.sameAs,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: nap.name,
    url: site.domain,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: homepageFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
  ...testimonials.map((t) => ({
    "@context": "https://schema.org",
    "@type": "Review",
    itemReviewed: {
      "@id": `${site.domain}/#localbusiness`,
    },
    reviewRating: {
      "@type": "Rating",
      ratingValue: t.rating,
      bestRating: 5,
    },
    author: {
      "@type": "Person",
      name: t.name,
    },
    reviewBody: t.text,
    datePublished: t.date,
  })),
];
---

<BaseLayout {title} {description} {schema}>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title={hero.title}
    subtitle={hero.subtitle}
    backgroundImage={hero.backgroundImage}
    primaryCta={hero.primaryCta}
    secondaryCta={{ label: nap.contact.phone, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar items={trustBarItems} />

  <!-- 3 · Services — white ─────────────────────── -->
  <Section bg="white" spacing="default" width="wide">
    <div class="mb-12 md:mb-16">
      <SectionHeader
        eyebrow="WHAT WE OFFER"
        title="Rentals for Every Occasion"
        subtitle="Explore our most requested setups for birthdays, showers, graduations, park gatherings, and backyard celebrations."
        align="left"
        spacing="featured"
        width="wide"
      />
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {featuredServices.map((service, index) => (
        <a
          href={service.href}
          class="group relative block overflow-hidden rounded-2xl aspect-[4/3]"
        >
          <Image
            src={service.image}
            alt={service.shortName}
            widths={[400, 800]}
            sizes="(max-width: 639px) 50vw, 25vw"
            loading={index < 4 ? "eager" : "lazy"}
            fetchpriority={index < 4 ? "high" : "auto"}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <p class="font-display font-bold text-white text-base lg:text-lg leading-tight">{service.shortName}</p>
            <span class="text-white/80 text-xs mt-1 inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-200">
              Learn more <span aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
      <a
        href="/services/"
        class="group relative block overflow-hidden rounded-2xl aspect-[4/3] bg-neutral-900"
      >
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-4">
          <p class="font-display font-bold text-white text-base lg:text-lg leading-tight">View All Services</p>
          <span class="text-white/80 text-xs mt-1 inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-200">Browse all <span aria-hidden="true">&rarr;</span></span>
        </div>
      </a>
    </div>
    </Section>

  <!-- 4 · Inventory — light ────────────────────── -->
  <CategoryGrid
    eyebrow="OUR INVENTORY"
    title="Everything You Need, All in One Place"
    subtitle="From tables and chairs to linens, tableware, and décor accents — one team handles it all."
    categories={categoryCards.slice(0, 6)}
    columns={3}
    bg="light"
    padding="default"
  />

  <!-- 5 · How It Works — white ─────────────────── -->
  <div class="h-px bg-neutral-100"></div>
  <HowItWorks
    eyebrow="HOW IT WORKS"
    title="How It Works"
    subtitle="We handle every step so you can focus on what matters — celebrating with your people."
    steps={howItWorksSteps}
  />

  <!-- 6 · City Cards — light ──────────────────── -->
  <CityCards
    eyebrow="SERVICE AREAS"
    title="Serving North County San Diego"
    subtitle="We deliver to every neighborhood across our four core cities — with free delivery always included."
    cities={cityCards}
    bg="light"
  />

  <!-- 7 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title={ctaBand.title}
    subtitle={ctaBand.subtitle}
    primaryCta={ctaBand.primaryCta}
    secondaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 8 · Gallery — white ──────────────────────── -->
  <ImageGallery
    eyebrow="RECENT SETUPS"
    title="Real Setups, Real Celebrations"
    subtitle="A look at some of the parties we've helped bring to life across North County San Diego."
    images={galleryImages}
    columns={4}
    bg="white"
  />

  <!-- 9 · Testimonials — light ─────────────────── -->
  <TestimonialCarousel
    eyebrow="REVIEWS"
    title="Trusted by Families Across North County"
    subtitle="Hundreds of events served across Carlsbad, Encinitas, Oceanside, and San Marcos."
    {testimonials}
    bg="light"
  />

  <!-- 10 · FAQ — white ──────────────────────────── -->
  <FAQAccordion
    eyebrow="FAQ"
    title="Frequently Asked Questions"
    faqs={homepageFaqs}
    bg="white"
  />



</BaseLayout>

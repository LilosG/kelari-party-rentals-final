---
import { Image } from 'astro:assets';
import heroParty from '../assets/images/hero-party.jpg';

import BaseLayout from "../layouts/BaseLayout.astro";
import LocalHero from "../components/LocalHero.astro";
import TrustBar from "../components/TrustBar.astro";
import OccasionStrip from "../components/OccasionStrip.astro";
import LocalIntroWithForm from "../components/LocalIntroWithForm.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CategoryGrid from "../components/CategoryGrid.astro";
import HowItWorks from "../components/HowItWorks.astro";
import CtaBand from "../components/CtaBand.astro";
import MapEmbed from "../components/MapEmbed.astro";
import ImageGallery from "../components/ImageGallery.astro";
import { heroImages } from "../data/heroImages";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import RelatedPosts from "../components/RelatedPosts.astro";

import { site, nap } from "../data/site";
import { categories } from "../data/categories";
import { services as allServices } from "../data/services";
import {
  hero,
  trustBarItems,
  ctaBand,
  howItWorksSteps,
  testimonials,
  galleryImages,
  homepageFaqs,
  topServiceSlugs,
  localIntro,
} from "../data/homepage";

const title = `Party Rentals in Carlsbad & North County San Diego | ${nap.name}`;
const description = site.description;

const categoryCards = categories
  .filter((c) => !c.hidden)
  .map((c) => ({
    name: c.name,
    description: c.subheadline,
    href: `/rentals/${c.slug}/`,
    icon: c.icon,
    slug: c.slug,
    comingSoon: c.comingSoon ?? false,
  }));

const featuredServices = topServiceSlugs
  .map((slug) => allServices.find((s) => s.slug === slug))
  .filter((s): s is (typeof allServices)[number] => Boolean(s))
  .map((s) => ({
    ...s,
    href: `/services/${s.slug}/`,
    image: s.heroImage?.image ?? heroParty,
  }));

const serviceAreaLinks = [
  { name: "Carlsbad", href: "/carlsbad/" },
  { name: "Encinitas", href: "/encinitas/" },
  { name: "Oceanside", href: "/oceanside/" },
  { name: "San Marcos", href: "/san-marcos/" },
  { name: "Bressi Ranch", href: "/bressi-ranch/" },
  { name: "La Costa", href: "/la-costa/" },
  { name: "Aviara", href: "/aviara/" },
  { name: "Olde Carlsbad", href: "/olde-carlsbad/" },
  { name: "Vista", href: "/vista/" },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": site.schema["@type"],
    "@id": `${site.domain}/#localbusiness`,
    name: nap.name,
    url: site.domain,
    logo: site.schema.logo,
    image: site.schema.image,
    description: site.description,
    telephone: nap.contact.phone,
    email: nap.contact.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: `${nap.address.street} ${nap.address.suite}`,
      addressLocality: nap.address.city,
      addressRegion: nap.address.state,
      postalCode: nap.address.zip,
      addressCountry: "US",
    },
    geo: site.schema.geo,
    openingHoursSpecification: site.schema.openingHoursSpecification,
    priceRange: site.schema.priceRange,
    areaServed: site.schema.areaServed,
    sameAs: site.schema.sameAs,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: nap.name,
    url: site.domain,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: homepageFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout {title} {description} {schema}>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title={hero.title}
    subtitle={hero.subtitle}
    image={hero.heroImage.image}
    focalPoint={hero.heroImage.focalPoint}
    primaryCta={hero.primaryCta}
    secondaryCta={hero.secondaryCta}
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar items={trustBarItems} />

  <!-- 3 · Occasion Strip ───────────────────────── -->
  <OccasionStrip heading="We Specialize In" />

  <!-- 4 · Local Intro + Mini Form ─────────────── -->
  <LocalIntroWithForm
    heading={localIntro.heading}
    body={localIntro.body}
  />

  <!-- 5 · Equipment Inventory — light ─────────── -->
  <CategoryGrid
    eyebrow="OUR INVENTORY"
    title="Everything You Need, All in One Place"
    subtitle="From tables and chairs to linens, canopies, and décor — one team handles it all."
    categories={categoryCards.slice(0, 6)}
    columns={3}
    bg="light"
    padding="default"
  />

  <!-- 6 · Services by Occasion — white ───────── -->
  <Section bg="white" spacing="default" width="wide">
    <div class="mb-12 md:mb-16">
      <SectionHeader
        eyebrow="WHAT WE OFFER"
        title="Rentals for Every Occasion"
        subtitle="Explore our most popular rental packages for birthdays, showers, graduations, park gatherings, and backyard celebrations."
        align="left"
        spacing="featured"
        width="wide"
      />
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {featuredServices.map((service, index) => (
        <a
          href={service.href}
          class="group relative block overflow-hidden rounded-2xl aspect-[4/3]"
        >
          <Image
            src={service.image}
            alt={service.shortName}
            widths={[400, 800]}
            sizes="(max-width: 639px) 50vw, 25vw"
            loading={index < 4 ? "eager" : "lazy"}
            fetchpriority={index < 4 ? "high" : "auto"}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <p class="font-display font-bold text-white text-base lg:text-lg leading-tight">{service.shortName}</p>
            <span class="text-white/80 text-xs mt-1 inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-200">
              Learn more <span aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
      <a
        href="/services/"
        class="group relative block overflow-hidden rounded-2xl aspect-[4/3]"
      >
        <Image
          src={heroParty}
          alt="View all party rental services"
          widths={[400, 800]}
          sizes="(max-width: 639px) 50vw, 25vw"
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-4">
          <p class="font-display font-bold text-white text-base lg:text-lg leading-tight">View All Services</p>
          <span class="text-white/80 text-xs mt-1 inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-200">Browse all <span aria-hidden="true">&rarr;</span></span>
        </div>
      </a>
    </div>
  </Section>

  <!-- 7 · How It Works — light ─────────────────── -->
  <div class="h-[3px] bg-gradient-to-r from-transparent via-[--color-border] to-transparent" aria-hidden="true"></div>
  <div id="how-it-works" class="scroll-mt-28">
    <HowItWorks
      eyebrow="HOW IT WORKS"
      title="How It Works"
      subtitle="We handle every step so you can focus on what matters — celebrating with your people."
      image={heroImages.kelariPartyRentalsAviaraPartyRentals.image}
      imageAlt="Kelari Party Rentals event setup showing how party rentals work in North County San Diego"
      steps={howItWorksSteps}
    />
  </div>

  <!-- 8 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title={ctaBand.title}
    subtitle={ctaBand.subtitle}
    primaryCta={ctaBand.primaryCta}
    secondaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
  />

  <!-- 9 · Service Areas + Map — white ─────────── -->
  <Section bg="white">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: SEO-optimized heading + linked area list -->
      <div>
        <p class="font-body uppercase tracking-[0.18em] text-[0.68rem] font-bold mb-4 text-brand-pink">
          SERVICE AREAS
        </p>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-neutral-900 leading-tight mb-4">
          Party Equipment Rentals Delivered Across North County San Diego
        </h2>
        <p class="text-base text-neutral-600 leading-relaxed mb-8">
          We deliver tables, chairs, linens, and canopies throughout North County — or pick up free at our Carlsbad warehouse on El Camino Real.
        </p>
        <div class="grid grid-cols-2 gap-3">
          {serviceAreaLinks.map((area) => (
            <a
              href={area.href}
              class="group flex items-center justify-between px-4 py-3 rounded-xl bg-neutral-50 border border-neutral-200 border-l-[3px] border-l-brand-pink hover:bg-white hover:border-brand-pink/30 hover:shadow-sm transition-all duration-200"
            >
              <span class="text-sm font-semibold text-neutral-800 group-hover:text-brand-pink transition-colors">{area.name}</span>
              <span class="text-brand-pink/60 group-hover:text-brand-pink text-sm transition-colors" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        <a
          href="/service-area/"
          class="inline-flex items-center gap-1.5 mt-8 text-sm font-semibold text-brand-pink hover:gap-2.5 transition-all duration-200"
        >
          See full service area <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- Right: map -->
      <div>
        <MapEmbed />
      </div>

    </div>
  </Section>

  <!-- 10 · Gallery — light ────────────────────── -->
  <ImageGallery
    eyebrow="RECENT DELIVERIES"
    title="Real Events, Real Celebrations"
    subtitle="A look at some of the parties we've helped bring to life across North County San Diego."
    images={galleryImages}
    columns={4}
    bg="light"
  />

  <!-- 11 · Testimonials — white ─────────────────── -->
  <TestimonialCarousel
    eyebrow="REVIEWS"
    title="Trusted by Families Across North County"
    subtitle="Hundreds of events served across Carlsbad, Encinitas, Oceanside, and San Marcos."
    {testimonials}
    bg="white"
  />

  <div class="h-[3px] bg-gradient-to-r from-transparent via-[--color-border] to-transparent" aria-hidden="true"></div>

  <!-- 12 · FAQ — light ──────────────────────────── -->
  <FAQAccordion
    eyebrow="FAQ"
    title="Frequently Asked Questions"
    faqs={homepageFaqs}
    bg="light"
  />

  <!-- 13 · From Our Blog — white ──────────────── -->
  <RelatedPosts
    tags={[]}
    limit={3}
    heading="From Our Blog"
    bg="white"
  />

</BaseLayout>

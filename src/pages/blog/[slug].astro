---
// src/pages/blog/[slug].astro
// Kelari Party Rentals — Blog Post Route
// ========================================
// Passes relatedServices, serviceAreas, image, imageAlt, and faqs
// from frontmatter through to BlogLayout so the sidebar, money pages,
// FAQ section, and Related Articles render correctly.

import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const {
  title,
  description,
  publishDate,
  updatedDate,
  author,
  category,
  tags,
  ogImage,
  image,
  imageAlt,
  faqs,
  relatedServices,
  serviceAreas,
} = post.data;
---

<BlogLayout
  {title}
  {description}
  publishDate={publishDate.toISOString()}
  updatedDate={updatedDate?.toISOString()}
  {author}
  {category}
  {tags}
  {ogImage}
  {image}
  {imageAlt}
  {faqs}
  {relatedServices}
  {serviceAreas}
  slug={post.id}
>
  <Content />
</BlogLayout>

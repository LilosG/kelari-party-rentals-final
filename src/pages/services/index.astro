---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SchemaWebPage from "../../components/schema/SchemaWebPage.astro";
import SchemaBreadcrumb from "../../components/schema/SchemaBreadcrumb.astro";
import LocalHero from "../../components/LocalHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import Section from "../../components/Section.astro";
import ServiceGrid from "../../components/ServiceGrid.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import CtaBand from "../../components/CtaBand.astro";
import QuoteForm from "../../components/QuoteForm.astro";

import { site, nap } from "../../data/site";
import { howItWorksSteps, testimonials, galleryImages } from "../../data/homepage";
import TestimonialCarousel from "../../components/TestimonialCarousel.astro";
import ImageGallery from "../../components/ImageGallery.astro";

const title = "Party Rental Services | Kelari Party Rentals";
const description =
  "Birthday parties, baby showers, graduations, engagement parties, backyard events & park parties — full-service rentals with free delivery in North County San Diego.";

const pageUrl = `${site.domain}/services/`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
>

  <SchemaWebPage type="WebPage" name={title} url={pageUrl} description={description} />
  <SchemaBreadcrumb
    pageUrl={pageUrl}
    items={[
      { name: "Home", url: site.domain },
      { name: "Services", url: pageUrl },
    ]}
  />

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title="Party Rental Services"
    subtitle="Full-service party rentals for every occasion — birthdays, baby showers, graduations, engagements, and more."
    bgImage="/images/hero-party.jpg"
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 3 · Intro — white ────────────────────────── -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-lg md:text-xl text-neutral-600 leading-relaxed">
        Whatever you're celebrating, Kelari Party Rentals provides the tables, chairs, tents, linens, and décor to make it special. Every service includes free delivery, professional setup, and same-day pickup across Carlsbad, Encinitas, Oceanside, and San Marcos.
      </p>
    </div>
  </Section>

  <!-- 4 · All Services — light ─────────────────── -->
  <ServiceGrid
    eyebrow="WHAT WE OFFER"
    title="All Party Rental Services"
    subtitle="Choose a service to see what's included, pricing, and local delivery details."
    columns={4}
    bg="light"
  />

  <!-- 5 · How It Works — white ─────────────────── -->
  <HowItWorks
    eyebrow="HOW IT WORKS"
    title="How It Works"
    subtitle="We handle every step so you can focus on what matters — celebrating with your people."
    steps={howItWorksSteps}
    bg="white"
  />

  <!-- 5b · Gallery — white ────────────────────── -->
  <ImageGallery
    eyebrow="RECENT SETUPS"
    title="Real Setups, Real Celebrations"
    subtitle="A look at events we've delivered and set up across North County San Diego."
    images={galleryImages.slice(0, 8)}
    columns={4}
    bg="white"
  />

  <!-- 5c · Testimonials — light ───────────────── -->
  <TestimonialCarousel
    eyebrow="REVIEWS"
    title="Trusted by North County Families"
    subtitle="Hundreds of events served across Carlsbad, Encinitas, Oceanside, and San Marcos."
    testimonials={testimonials}
    bg="light"
  />

  <!-- 6 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title="Not Sure What You Need?"
    subtitle="Tell us about your event and we'll recommend the perfect service and rental package — no obligation."
    primaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    secondaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 7 · Quote Form — dark ────────────────────── -->
  <QuoteForm
    heading="Get a Free Party Rental Quote"
    subheading="Tell us about your event and we'll recommend the right services and put together a custom package."
  />

</BaseLayout>

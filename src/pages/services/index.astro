---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { heroImages } from "../../data/heroImages";
import LocalHero from "../../components/LocalHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import Section from "../../components/Section.astro";
import ServiceGrid from "../../components/ServiceGrid.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import CtaBand from "../../components/CtaBand.astro";
import QuoteForm from "../../components/QuoteForm.astro";

import { site, nap, booqableStore } from "../../data/site";
import { cities } from "../../data/cities";
import { howItWorksSteps, testimonials, galleryImages } from "../../data/homepage";
import TestimonialCarousel from "../../components/TestimonialCarousel.astro";
import ImageGallery from "../../components/ImageGallery.astro";
import MapEmbed from "../../components/MapEmbed.astro";
import LocalIntroWithForm from "../../components/LocalIntroWithForm.astro";

const title = "Party Rental Services | Kelari Party Rentals";
const cityCards = cities.map((c) => ({
  name: c.name,
  description: c.subheadline,
  href: `/${c.slug}/`,
}));
const description =
  "Birthday parties, baby showers, graduations, engagement parties, backyard events & park parties — professional delivery available across North County San Diego.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    url: `${site.domain}/services/`,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      {
        "@type": "ListItem",
        position: 2,
        name: "Services",
        item: `${site.domain}/services/`,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${site.domain}/services/`}
  schema={schema}
>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title="Party Rental Services"
    subtitle="Full-service party rentals for every occasion — birthdays, baby showers, graduations, engagements, and more."
    image={heroImages.kelariPartyRentalsVistaPartyRentals.image}
    focalPoint={heroImages.kelariPartyRentalsVistaPartyRentals.focalPoint}
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 3 · Intro + Mini Form ───────────────────── -->
  <LocalIntroWithForm
    heading="Party Rental Services Across North County San Diego"
    body="Whatever you're celebrating, Kelari Party Rentals provides the tables, chairs, tents, linens, and décor to make it special. Professional delivery available across Carlsbad, Encinitas, Oceanside, San Marcos, and surrounding communities."
  />

  <!-- 4 · All Services — light ─────────────────── -->
  <ServiceGrid
    eyebrow="WHAT WE OFFER"
    title="All Party Rental Services"
    subtitle="Choose a service to see what's included, pricing, and local delivery details."
    columns={4}
    bg="light"
  />

  <!-- 5 · How It Works — white ─────────────────── -->
  <HowItWorks
    eyebrow="HOW IT WORKS"
    title="How It Works"
    subtitle="We handle every step so you can focus on what matters — celebrating with your people."
    steps={howItWorksSteps}
    bg="white"
  />

  <!-- 5b · Gallery — white ────────────────────── -->
  <ImageGallery
    eyebrow="RECENT DELIVERIES"
    title="Real Events, Real Celebrations"
    subtitle="A look at events we've delivered across North County San Diego."
    images={galleryImages.slice(0, 8)}
    columns={4}
    bg="white"
  />

  <!-- 5c · Testimonials — light ───────────────── -->
  <TestimonialCarousel
    eyebrow="REVIEWS"
    title="Trusted by North County Families"
    subtitle="Hundreds of events served across Carlsbad, Encinitas, Oceanside, and San Marcos."
    testimonials={testimonials}
    bg="light"
  />

  <!-- 6 · Service Areas + Map — white ────────────── -->
  <Section bg="white">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <p class="font-body uppercase tracking-[0.18em] text-[0.68rem] font-bold mb-4 text-brand-pink">
          WHERE WE DELIVER
        </p>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-neutral-900 leading-tight mb-4">
          Party Rentals Across North County San Diego
        </h2>
        <p class="text-base text-neutral-600 leading-relaxed mb-8">
          We deliver to every neighborhood across North County — or pick up free at our Carlsbad warehouse on El Camino Real.
        </p>
        <div class="grid grid-cols-2 gap-3">
          {cityCards.map((city) => (
            <a
              href={city.href}
              class="group flex items-center justify-between px-4 py-3 rounded-xl bg-neutral-50 border border-neutral-200 border-l-[3px] border-l-brand-pink hover:bg-white hover:border-brand-pink/30 hover:shadow-sm transition-all duration-200"
            >
              <span class="text-sm font-semibold text-neutral-800 group-hover:text-brand-pink transition-colors">{city.name}</span>
              <span class="text-brand-pink/60 group-hover:text-brand-pink text-sm transition-colors" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        <a href="/service-area/" class="inline-flex items-center gap-2 mt-6 text-sm font-semibold text-brand-pink hover:underline">
          See full service area →
        </a>
      </div>
      <div>
        <MapEmbed />
      </div>
    </div>
  </Section>

  <!-- 7 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title="Not Sure What You Need?"
    subtitle="Tell us about your event and we'll recommend the perfect service and rental package — no obligation."
    primaryCta={{ label: "Book Now", href: booqableStore }}
    secondaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    tertiaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 7 · Quote Form — dark ────────────────────── -->
  <QuoteForm
    heading="Get a Free Party Rental Quote"
    subheading="Tell us about your event and we'll recommend the right services and put together a custom package."
  />

</BaseLayout>

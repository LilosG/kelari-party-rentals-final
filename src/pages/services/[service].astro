---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SchemaWebPage from "../../components/schema/SchemaWebPage.astro";
import SchemaBreadcrumb from "../../components/schema/SchemaBreadcrumb.astro";
import SchemaFAQ from "../../components/schema/SchemaFAQ.astro";
import SchemaService from "../../components/schema/SchemaService.astro";
import LocalHero from "../../components/LocalHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import Section from "../../components/Section.astro";
import WhatsIncluded from "../../components/WhatsIncluded.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import CtaBand from "../../components/CtaBand.astro";
import CityCards from "../../components/CityCards.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import QuoteForm from "../../components/QuoteForm.astro";

import { site, nap } from "../../data/site";
import { services, type Service } from "../../data/services";
import { cities } from "../../data/cities";
import { howItWorksSteps, testimonials, galleryImages } from "../../data/homepage";
import TestimonialCarousel from "../../components/TestimonialCarousel.astro";
import ImageGallery from "../../components/ImageGallery.astro";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

const serviceImages: Record<string, string> = {
  "party-rentals": "/images/hero-party.jpg",
  "birthday-party-rentals": "/images/birthday-party.jpg",
  "backyard-party-rentals": "/images/backyard-party.jpg",
  "baby-shower-rentals": "/images/baby-shower.jpg",
  "graduation-party-rentals": "/images/graduation-party.jpg",
  "engagement-party-rentals": "/images/engagement-party.jpg",
  "park-party-rentals": "/images/park-party.jpg",
  "delivery-setup-pickup": "/images/backyard-party.jpg",
};
const bgImage = serviceImages[service.slug] ?? "/images/hero-party.jpg";

const cityCards = cities
  .filter((c) => c.services.includes(service.slug))
  .map((c) => ({
    name: c.name,
    description: `${service.shortName} with free delivery and setup in ${c.name}.`,
    href: `/${c.slug}/${service.slug}/`,
  }));

const pageUrl = `${site.domain}/services/${service.slug}/`;
---

<BaseLayout
  title={service.meta.title}
  description={service.meta.description}
  canonical={pageUrl}
>

  <SchemaWebPage type="ItemPage" name={service.meta.title} url={pageUrl} description={service.meta.description} />
  <SchemaBreadcrumb
    pageUrl={pageUrl}
    items={[
      { name: "Home", url: site.domain },
      { name: "Services", url: `${site.domain}/services/` },
      { name: service.name, url: pageUrl },
    ]}
  />
  <SchemaService name={service.name} description={service.meta.description} pageUrl={pageUrl} />
  <SchemaFAQ faqs={service.faqs} pageUrl={pageUrl} />

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title={service.headline}
    subtitle={service.subheadline}
    bgImage={bgImage}
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 3 · Intro — white ────────────────────────── -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-lg md:text-xl text-neutral-600 leading-relaxed">
        {service.intro}
      </p>
    </div>
  </Section>

  <!-- 4 · What's Included — light ──────────────── -->
  <WhatsIncluded
    eyebrow="FULL-SERVICE RENTALS"
    title={`What's Included with ${service.name}`}
    items={service.whatsIncluded}
    columns={3}
    bg="light"
  />

  <!-- 5 · How It Works — white ─────────────────── -->
  <HowItWorks
    eyebrow="HOW IT WORKS"
    title="How It Works"
    subtitle="We handle every step so you can focus on what matters — celebrating with your people."
    steps={howItWorksSteps}
  />

  <!-- 6 · Gallery — white ─────────────────────── -->
  <ImageGallery
    eyebrow="RECENT SETUPS"
    title="Real Setups, Real Results"
    subtitle="A look at some of the events we've delivered across North County San Diego."
    images={galleryImages.slice(0, 8)}
    columns={4}
    bg="white"
  />

  <!-- 7 · Testimonials — light ─────────────────── -->
  <TestimonialCarousel
    eyebrow="REVIEWS"
    title="What Families Are Saying"
    subtitle="Hundreds of events served across Carlsbad, Encinitas, Oceanside, and San Marcos."
    testimonials={testimonials}
    bg="light"
  />

  <!-- 8 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title={`Ready to Book ${service.shortName}?`}
    subtitle="Free delivery, professional setup, and same-day pickup included with every rental. No hidden fees."
    primaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    secondaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 9 · City Cards — white ───────────────────── -->
  <CityCards
    eyebrow="SERVICE AREAS"
    title={`${service.name} by City`}
    subtitle={`Free delivery and setup for ${service.shortName.toLowerCase()} across North County San Diego. Choose your city for local details.`}
    cities={cityCards}
    bg="white"
  />

  <!-- 10 · FAQ — light ──────────────────────────── -->
  <FAQAccordion
    eyebrow="FAQ"
    title={`${service.name} — Frequently Asked Questions`}
    faqs={service.faqs}
    bg="light"
  />

  <!-- 11 · Quote Form — dark ────────────────────── -->
  <QuoteForm
    heading={`Get a ${service.shortName} Quote`}
    subheading={`Tell us about your event and we'll put together a custom ${service.name.toLowerCase()} package with free delivery.`}
    service={service.slug}
  />

</BaseLayout>

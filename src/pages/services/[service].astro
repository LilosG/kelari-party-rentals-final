---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalHero from "../../components/LocalHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import OccasionStrip from "../../components/OccasionStrip.astro";
import WhatsIncluded from "../../components/WhatsIncluded.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import CtaBand from "../../components/CtaBand.astro";
import Section from "../../components/Section.astro";
import MapEmbed from "../../components/MapEmbed.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import LocalIntroWithForm from "../../components/LocalIntroWithForm.astro";

import { site, nap, booqableStore } from "../../data/site";
import { services, type Service } from "../../data/services";
import { cities } from "../../data/cities";
import { howItWorksSteps, testimonials, galleryImages } from "../../data/homepage";
import TestimonialCarousel from "../../components/TestimonialCarousel.astro";
import ImageGallery from "../../components/ImageGallery.astro";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

const heroImage = service.heroImage;

const cityCards = cities
  .filter((c) => c.services.includes(service.slug))
  .map((c) => ({
    name: c.name,
    description: `${service.shortName} in ${c.name}.`,
    href: `/${c.slug}/${service.slug}/`,
  }));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.name,
    provider: { "@id": `${site.domain}/#localbusiness` },
    areaServed: site.schema.areaServed,
    description: service.meta.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: service.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: service.meta.title,
    url: `${site.domain}/services/${service.slug}/`,
    description: service.meta.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: site.domain,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Services",
        item: `${site.domain}/services/`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: service.name,
        item: `${site.domain}/services/${service.slug}/`,
      },
    ],
  },
];
---

<BaseLayout
  title={service.meta.title}
  description={service.meta.description}
  canonical={`${site.domain}/services/${service.slug}/`}
  schema={schema}
  robots={service.hidden ? "noindex, nofollow" : "index, follow"}
>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title={service.headline}
    subtitle={service.subheadline}
    image={heroImage?.image}
    focalPoint={heroImage?.focalPoint}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Services", href: "/services/" },
      { label: service.name, href: `/services/${service.slug}/` },
    ]}
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 2b · Occasion Strip ─────────────────── -->
  <OccasionStrip heading="We Specialize In" />

  <!-- 3 · Intro + Mini Form ───────────────────── -->
  <LocalIntroWithForm
    heading={service.headline}
    body={service.intro}
    service={service.slug}
  />

  <!-- 4 · What's Included — light ──────────────── -->
  <WhatsIncluded
    eyebrow="FULL-SERVICE RENTALS"
    title={`What's Included with ${service.name}`}
    items={service.whatsIncluded}
    columns={3}
    bg="light"
  />

  <!-- 5 · How It Works — white ─────────────────── -->
  <HowItWorks
    eyebrow="HOW IT WORKS"
    title={`How ${service.shortName} Works`}
    subtitle={`From your first quote to post-event pickup — we handle every step so you can focus on celebrating.`}
    steps={howItWorksSteps}
  />

  <!-- 6 · Gallery — white ─────────────────────── -->
  <ImageGallery
    eyebrow="RECENT DELIVERIES"
    title={`Real ${service.shortName} Setups`}
    subtitle={`A look at events we've delivered across North County San Diego.`}
    images={galleryImages.slice(0, 8)}
    columns={4}
    bg="white"
  />

  <!-- 7 · Testimonials — light ─────────────────── -->
  <TestimonialCarousel
    eyebrow="REVIEWS"
    title={`What Families Say About Our ${service.shortName}`}
    subtitle="Hundreds of events served across Carlsbad, Encinitas, Oceanside, and San Marcos."
    testimonials={testimonials}
    bg="light"
  />

  <!-- 9 · Service Areas + Map — white ────────────── -->
  <Section bg="white">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <p class="font-body uppercase tracking-[0.18em] text-[0.68rem] font-bold mb-4 text-brand-pink">
          WHERE WE DELIVER
        </p>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-neutral-900 leading-tight mb-4">
          {service.name} Across North County San Diego
        </h2>
        <p class="text-base text-neutral-600 leading-relaxed mb-8">
          Professional {service.shortName.toLowerCase()} available throughout North County — or pick up free at our Carlsbad warehouse on El Camino Real.
        </p>
        <div class="grid grid-cols-2 gap-3">
          {cityCards.map((city) => (
            <a
              href={city.href}
              class="group flex items-center justify-between px-4 py-3 rounded-xl bg-neutral-50 border border-neutral-200 border-l-[3px] border-l-brand-pink hover:bg-white hover:border-brand-pink/30 hover:shadow-sm transition-all duration-200"
            >
              <span class="text-sm font-semibold text-neutral-800 group-hover:text-brand-pink transition-colors">{city.name}</span>
              <span class="text-brand-pink/60 group-hover:text-brand-pink text-sm transition-colors" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        <a href="/service-area/" class="inline-flex items-center gap-2 mt-6 text-sm font-semibold text-brand-pink hover:underline">
          See full service area →
        </a>
      </div>
      <div>
        <MapEmbed />
      </div>
    </div>
  </Section>

  <!-- 8 · FAQ — light ──────────────────────────── -->
  <FAQAccordion
    eyebrow="FAQ"
    title={`${service.name} — Frequently Asked Questions`}
    faqs={service.faqs}
    bg="light"
  />

  <!-- 9 · Related Blog Posts — white ───────────── -->
  <RelatedPosts
    tags={[service.slug]}
    heading="Party Planning Resources"
    bg="white"
  />

  <!-- 10 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title={`Ready to Book ${service.shortName}?`}
    subtitle="Professional delivery available across North County San Diego. Complimentary warehouse pickup always available."
    primaryCta={{ label: "Book Now", href: booqableStore }}
    secondaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    tertiaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 11 · Quote Form — dark ────────────────────── -->
  <QuoteForm
    heading={`Get a ${service.shortName} Quote`}
    subheading={`Tell us about your event and we'll put together a custom ${service.name.toLowerCase()} package.`}
    service={service.slug}
  />

</BaseLayout>

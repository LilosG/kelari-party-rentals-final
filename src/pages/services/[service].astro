---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocalHero from "../../components/LocalHero.astro";
import TrustBar from "../../components/TrustBar.astro";
import OccasionStrip from "../../components/OccasionStrip.astro";
import Section from "../../components/Section.astro";
import WhatsIncluded from "../../components/WhatsIncluded.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import CtaBand from "../../components/CtaBand.astro";
import CityCards from "../../components/CityCards.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";

import { site, nap, booqableStore } from "../../data/site";
import { services, type Service } from "../../data/services";
import { cities } from "../../data/cities";
import { howItWorksSteps, testimonials, galleryImages } from "../../data/homepage";
import TestimonialCarousel from "../../components/TestimonialCarousel.astro";
import ImageGallery from "../../components/ImageGallery.astro";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

const serviceImages: Record<string, string> = {
  "party-rentals": "/images/hero-party.jpg",
  "birthday-party-rentals": "/images/birthday-party.jpg",
  "backyard-party-rentals": "/images/backyard-party.jpg",
  "baby-shower-rentals": "/images/baby-shower.jpg",
  "graduation-party-rentals": "/images/graduation-party.jpg",
  "engagement-party-rentals": "/images/engagement-party.jpg",
  "park-party-rentals": "/images/park-party.jpg",
  "delivery-setup-pickup": "/images/backyard-party.jpg",
};
const bgImage = serviceImages[service.slug] ?? "/images/hero-party.jpg";

const cityCards = cities
  .filter((c) => c.services.includes(service.slug))
  .map((c) => ({
    name: c.name,
    description: `${service.shortName} in ${c.name}.`,
    href: `/${c.slug}/${service.slug}/`,
  }));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.name,
    provider: { "@id": `${site.domain}/#localbusiness` },
    areaServed: site.schema.areaServed,
    description: service.meta.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: service.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: service.meta.title,
    url: `${site.domain}/services/${service.slug}/`,
    description: service.meta.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: site.domain,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Services",
        item: `${site.domain}/services/`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: service.name,
        item: `${site.domain}/services/${service.slug}/`,
      },
    ],
  },
];
---

<BaseLayout
  title={service.meta.title}
  description={service.meta.description}
  canonical={`${site.domain}/services/${service.slug}/`}
  schema={schema}
>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title={service.headline}
    subtitle={service.subheadline}
    bgImage={bgImage}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Services", href: "/services/" },
      { label: service.name, href: `/services/${service.slug}/` },
    ]}
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 2b · Occasion Strip ─────────────────── -->
  <OccasionStrip heading="We Specialize In" />

  <!-- 3 · Intro — white ────────────────────────── -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <p class="font-body uppercase tracking-[0.18em] text-[0.68rem] font-bold mb-5 text-brand-pink">
        ABOUT THIS SERVICE
      </p>
      <div class="border-t border-neutral-200 pt-6">
        <p class="text-lg md:text-xl text-neutral-600 leading-relaxed">
          {service.intro}
        </p>
      </div>
    </div>
  </Section>

  <!-- 4 · What's Included — light ──────────────── -->
  <WhatsIncluded
    eyebrow="FULL-SERVICE RENTALS"
    title={`What's Included with ${service.name}`}
    items={service.whatsIncluded}
    columns={3}
    bg="light"
  />

  <!-- 5 · How It Works — white ─────────────────── -->
  <HowItWorks
    eyebrow="HOW IT WORKS"
    title={`How ${service.shortName} Works`}
    subtitle={`From your first quote to post-event pickup — we handle every step so you can focus on celebrating.`}
    steps={howItWorksSteps}
  />

  <!-- 6 · Gallery — white ─────────────────────── -->
  <ImageGallery
    eyebrow="RECENT SETUPS"
    title={`Real ${service.shortName} Setups`}
    subtitle={`A look at events we've delivered and set up across North County San Diego.`}
    images={galleryImages.slice(0, 8)}
    columns={4}
    bg="white"
  />

  <!-- 7 · Testimonials — light ─────────────────── -->
  <TestimonialCarousel
    eyebrow="REVIEWS"
    title={`What Families Say About Our ${service.shortName}`}
    subtitle="Hundreds of events served across Carlsbad, Encinitas, Oceanside, and San Marcos."
    testimonials={testimonials}
    bg="light"
  />

  <!-- 9 · City Cards — white ───────────────────── -->
  <CityCards
    eyebrow="SERVICE AREAS"
    title={`${service.name} by City`}
    subtitle={`${service.shortName} available across North County San Diego. Choose your city for local details.`}
    cities={cityCards}
    bg="white"
  />

  <!-- 8 · FAQ — light ──────────────────────────── -->
  <FAQAccordion
    eyebrow="FAQ"
    title={`${service.name} — Frequently Asked Questions`}
    faqs={service.faqs}
    bg="light"
  />

  <!-- 9 · Related Blog Posts — white ───────────── -->
  <RelatedPosts
    tags={[service.slug]}
    heading="Party Planning Resources"
    bg="white"
  />

  <!-- 10 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title={`Ready to Book ${service.shortName}?`}
    subtitle="Professional delivery available across North County San Diego. Complimentary warehouse pickup always available."
    primaryCta={{ label: "Book Now", href: booqableStore }}
    secondaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    tertiaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 11 · Quote Form — dark ────────────────────── -->
  <QuoteForm
    heading={`Get a ${service.shortName} Quote`}
    subheading={`Tell us about your event and we'll put together a custom ${service.name.toLowerCase()} package.`}
    service={service.slug}
  />

</BaseLayout>

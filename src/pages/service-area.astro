---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalHero from "../components/LocalHero.astro";
import TrustBar from "../components/TrustBar.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CtaBand from "../components/CtaBand.astro";
import QuoteForm from "../components/QuoteForm.astro";
import MapEmbed from "../components/MapEmbed.astro";

import { site, nap, booqableStore } from "../data/site";
import { cities } from "../data/cities";

const title = "Party Rental Delivery Area | North County San Diego | Kelari Party Rentals";
const description =
  "Kelari Party Rentals delivers tables, chairs, tents & décor across Carlsbad, Encinitas, Oceanside, San Marcos, and surrounding North County San Diego communities.";

const allZips = [...new Set(cities.flatMap((c) => c.zip))].sort();

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    url: `${site.domain}/service-area/`,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      {
        "@type": "ListItem",
        position: 2,
        name: "Service Area",
        item: `${site.domain}/service-area/`,
      },
    ],
  },
];

const deliverySteps = [
  {
    title: "We Deliver",
    text: "Our team arrives 1–2 hours before your event with all rental items and brings everything to your exact delivery location.",
  },
  {
    title: "You Set Up",
    text: "Tables, chairs, tents, linens — you arrange everything to your layout. We walk you through any setup questions on-site before we go.",
  },
  {
    title: "We Pick Up",
    text: "After your event, we return to collect everything. Same-day pickup, no cleanup hassle for you.",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${site.domain}/service-area/`}
  schema={schema}
>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title="Our Service Area"
    subtitle="Professional delivery available across North County San Diego — Carlsbad, Encinitas, Oceanside, San Marcos & beyond."
    bgImage="/images/park-party.jpg"
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 3 · Intro — white ────────────────────────── -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-lg md:text-xl text-neutral-600 leading-relaxed">
        Based in Carlsbad, Kelari Party Rentals provides professional delivery throughout North County San Diego. Whether your event is at a private home, park, community center, or venue — we bring everything to you. Complimentary warehouse pickup is always available at our Carlsbad location.
      </p>
    </div>
  </Section>

  <!-- 4 · City Cards — light ───────────────────── -->
  <Section bg="light">
    <div class="mb-10 md:mb-14">
      <SectionHeader
        eyebrow="SERVICE AREAS"
        title="Cities We Serve"
        subtitle="Click any city to see neighborhoods, parks, and local delivery details."
      />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {cities.map((city) => (
        <a
          href={`/${city.slug}/`}
          class="bg-white rounded-2xl border border-neutral-200 p-6 md:p-8 hover:border-brand-pink hover:shadow-[0_8px_40px_rgba(200,80,122,0.15)] transition-all duration-300 group"
        >
          <h3 class="font-display text-2xl font-bold text-neutral-800 group-hover:text-brand-pink transition-colors">
            {city.name}, {city.state}
          </h3>
          <p class="mt-3 text-neutral-600 leading-relaxed text-sm">
            {city.intro}
          </p>
          <div class="mt-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-1.5">Neighborhoods</p>
            <p class="text-sm text-neutral-700">
              {city.neighborhoods.join(", ")}
            </p>
          </div>
          <div class="mt-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-1.5">ZIP Codes</p>
            <div class="flex flex-wrap gap-1.5">
              {city.zip.map((z) => (
                <span class="text-xs px-2.5 py-1 bg-brand-pink-light text-brand-pink rounded-full font-medium border border-brand-pink/20">
                  {z}
                </span>
              ))}
            </div>
          </div>
          <span class="inline-block mt-4 text-sm font-semibold text-brand-pink group-hover:underline">
            View {city.name} rentals &rarr;
          </span>
        </a>
      ))}
    </div>
  </Section>

  <!-- 5 · ZIP Codes — white (compact) ──────────── -->
  <Section bg="white" padding="compact">
    <div class="max-w-3xl mx-auto text-center">
      <SectionHeader
        eyebrow="DELIVERY COVERAGE"
        title="ZIP Codes We Deliver To"
        subtitle="Delivery available to all of these ZIP codes — complimentary warehouse pickup always available."
      />
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        {allZips.map((z) => (
          <span class="px-3 py-1.5 bg-neutral-50 border border-neutral-200 rounded-full text-sm font-medium text-neutral-700">
            {z}
          </span>
        ))}
      </div>
    </div>
  </Section>

  <!-- 6 · How Delivery Works — light ───────────── -->
  <Section bg="light">
    <div class="mb-10 md:mb-14">
      <SectionHeader
        eyebrow="OUR PROCESS"
        title="How Delivery Works"
        subtitle="Full-service means we handle every step — from the truck to your venue and back."
      />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8 max-w-4xl mx-auto">
      {deliverySteps.map((step, i) => (
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-brand-pink flex items-center justify-center shadow-[0_4px_20px_rgba(200,80,122,0.35)]">
            <span class="text-white font-display font-bold text-lg">0{i + 1}</span>
          </div>
          <h3 class="font-display text-lg font-bold text-neutral-800">{step.title}</h3>
          <p class="mt-2 text-sm text-neutral-600 leading-relaxed">{step.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- 7 · Location Map — white ─────────────────── -->
  <Section bg="white">
    <div class="mb-10 md:mb-14">
      <SectionHeader
        eyebrow="OUR LOCATION"
        title="Our Carlsbad Location"
        subtitle={nap.address.full}
      />
    </div>
    <div class="max-w-2xl mx-auto">
      <MapEmbed />
    </div>
  </Section>

  <!-- 8 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title="In Our Service Area?"
    subtitle="Get a quote for your next event. Delivery available across North County SD — complimentary warehouse pickup always available."
    primaryCta={{ label: "Book Now", href: booqableStore }}
    secondaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    tertiaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 9 · Quote Form — dark ────────────────────── -->
  <QuoteForm
    heading="Request a Quote"
    subheading="Tell us where your event is and we'll confirm delivery availability and put together a custom package."
  />

</BaseLayout>

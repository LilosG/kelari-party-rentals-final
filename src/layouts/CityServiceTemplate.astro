---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalHero from "../components/LocalHero.astro";
import TrustBar from "../components/TrustBar.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import WhatsIncluded from "../components/WhatsIncluded.astro";
import NeighborhoodTags from "../components/NeighborhoodTags.astro";
import ParksList from "../components/ParksList.astro";
import CtaBand from "../components/CtaBand.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import MapEmbed from "../components/MapEmbed.astro";
import QuoteForm from "../components/QuoteForm.astro";

import { site, nap, booqableStore } from "../data/site";
import { cities, type City } from "../data/cities";
import {
  services,
  type Service,
  getServiceBySlug,
  renderCityTemplate,
} from "../data/services";
import { testimonials, galleryImages } from "../data/homepage";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import ImageGallery from "../components/ImageGallery.astro";
import OccasionStrip from "../components/OccasionStrip.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import LocalIntroWithForm from "../components/LocalIntroWithForm.astro";

interface Props {
  city: City;
  service: Service;
}

const { city, service } = Astro.props;

const cityContent = city.cityServiceContent?.[service.slug];

const heroImage = service.heroImage;

const pageTitle = renderCityTemplate(service.cityMeta.title, city.name);
const pageDescription = renderCityTemplate(service.cityMeta.description, city.name);
const headline = renderCityTemplate(service.cityHeadline, city.name);
const subheadline = renderCityTemplate(service.citySubheadline, city.name);
const intro = renderCityTemplate(service.cityIntro, city.name);
const canonical = `${site.domain}/${city.slug}/${service.slug}/`;

const combinedFaqs = [
  ...service.faqs.map((f) => ({
    question: renderCityTemplate(f.question, city.name),
    answer: renderCityTemplate(f.answer, city.name),
  })),
  ...city.faqs,
];

const schemaFaqs = service.faqs.map((f) => ({
  question: renderCityTemplate(f.question, city.name),
  answer: renderCityTemplate(f.answer, city.name),
}));

const nearbyAreas = cities
  .filter((c) => c.slug !== city.slug)
  .map((c) => ({
    name: c.name,
    tagline: `${service.shortName} in ${c.name}.`,
    href: `/${c.slug}/${service.slug}/`,
  }));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${site.domain}/#localbusiness`,
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: `${service.name} in ${city.name}`,
    provider: { "@id": `${site.domain}/#localbusiness` },
    areaServed: {
      "@type": "City",
      name: `${city.name}, ${city.state}`,
    },
    description: pageDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: schemaFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: pageTitle,
    url: canonical,
    description: pageDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      {
        "@type": "ListItem",
        position: 2,
        name: city.name,
        item: `${site.domain}/${city.slug}/`,
      },
      { "@type": "ListItem", position: 3, name: service.name, item: canonical },
    ],
  },
];
---


<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  schema={schema}
  robots={service.hidden ? "noindex, nofollow" : "index, follow"}
>

  <!-- 1 · Hero ─────────────────────────────────── -->
  <LocalHero
    title={headline}
    subtitle={subheadline}
    image={heroImage?.image}
    focalPoint={heroImage?.focalPoint}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: city.name, href: `/${city.slug}/` },
      { label: service.name, href: `/${city.slug}/${service.slug}/` },
    ]}
  />

  <!-- 2 · Trust Bar ────────────────────────────── -->
  <TrustBar />

  <!-- 2b · Occasion Strip ─────────────────────── -->
  <OccasionStrip heading="We Specialize In" />

  <!-- 3 · Intro + Mini Form ───────────────────── -->
  <LocalIntroWithForm
    heading={headline}
    body={cityContent?.intro ?? intro}
    city={city.slug}
    service={service.slug}
  />

  <!-- 3b · Local Venue Callout — white (conditional) ── -->
  {cityContent?.localVenue && (
    <Section bg="white" spacing="compact">
      <div class="max-w-3xl mx-auto">
        <div class="border-l-4 border-brand-pink bg-neutral-50 pl-5 py-4 rounded-r">
          <p class="font-body uppercase tracking-[0.18em] text-[0.68rem] font-bold mb-2 text-brand-pink">LOCAL VENUE</p>
          <p class="text-base text-neutral-700 italic leading-relaxed">{cityContent.localVenue}</p>
        </div>
      </div>
    </Section>
  )}

  <!-- 4 · What's Included — light ──────────────── -->
  <WhatsIncluded
    eyebrow="FULL-SERVICE RENTALS"
    title={`What's Included with ${service.name} in ${city.name}`}
    items={service.whatsIncluded}
    columns={3}
    bg="light"
  />

  <!-- 5 · Local Proof — white ──────────────────── -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <SectionHeader
        eyebrow="LOCAL EXPERTS"
        title={`Trusted for ${service.shortName} in ${city.name}`}
      />
      <p class="mt-6 text-lg text-neutral-600 leading-relaxed">
        {city.localProof}
      </p>
      <p class="mt-3 text-base text-neutral-500">
        {cityContent?.deliveryNote ?? city.deliveryNote}
      </p>
    </div>
  </Section>

  <!-- 6 · Neighborhoods — light (compact) ──────── -->
  <NeighborhoodTags
    eyebrow="NEIGHBORHOODS"
    title={`${city.name} Neighborhoods We Serve`}
    neighborhoods={city.neighborhoods}
    bg="light"
    padding="compact"
  />

  <!-- 7 · Parks — white (compact) ─────────────── -->
  <ParksList
    eyebrow="POPULAR VENUES"
    title={`Popular ${city.name} Parks for ${service.shortName}`}
    parks={city.parks.map((p) => ({ name: p }))}
    bg="white"
    padding="compact"
  />

  <!-- 8 · Gallery — white ─────────────────────── -->
  <ImageGallery
    eyebrow="RECENT DELIVERIES"
    title={`${service.shortName} Setups in ${city.name}`}
    subtitle={`Real events we've delivered across ${city.name} and North County San Diego.`}
    images={galleryImages.slice(0, 8)}
    columns={4}
    bg="white"
  />

  <!-- 9 · Testimonials — light ─────────────────── -->
  <TestimonialCarousel
    eyebrow="REVIEWS"
    title={`What ${city.name} Families Say`}
    subtitle={`Hundreds of events served across ${city.name}, Carlsbad, Encinitas, Oceanside, and San Marcos.`}
    testimonials={testimonials}
    bg="light"
  />

  <!-- 10 · Related Blog Posts — white ───────────── -->
  <RelatedPosts
    tags={[service.slug, city.slug]}
    heading="Party Planning Resources"
    bg="white"
  />

  <!-- 11 · Nearby Cities + Map — white ──────────── -->
  <Section bg="white">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <p class="font-body uppercase tracking-[0.18em] text-[0.68rem] font-bold mb-4 text-brand-pink">
          NEARBY CITIES
        </p>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-neutral-900 leading-tight mb-4">
          {service.shortName} Across North County San Diego
        </h2>
        <p class="text-base text-neutral-600 leading-relaxed mb-8">
          We also deliver {service.shortName.toLowerCase()} throughout North County — or pick up free at our Carlsbad warehouse.
        </p>
        <div class="grid grid-cols-2 gap-3">
          {nearbyAreas.map((area) => (
            <a
              href={area.href}
              class="group flex items-center justify-between px-4 py-3 rounded-xl bg-neutral-50 border border-neutral-200 border-l-[3px] border-l-brand-pink hover:bg-white hover:border-brand-pink/30 hover:shadow-sm transition-all duration-200"
            >
              <span class="text-sm font-semibold text-neutral-800 group-hover:text-brand-pink transition-colors">{area.name}</span>
              <span class="text-brand-pink/60 group-hover:text-brand-pink text-sm transition-colors" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        <a href="/service-area/" class="inline-flex items-center gap-2 mt-6 text-sm font-semibold text-brand-pink hover:underline">
          See full service area →
        </a>
      </div>
      <div>
        <MapEmbed />
      </div>
    </div>
  </Section>

  <!-- 11 · FAQ — light ─────────────────────────── -->
  <FAQAccordion
    eyebrow="FAQ"
    title={`${service.name} in ${city.name} — FAQs`}
    faqs={combinedFaqs}
    bg="light"
  />

  <!-- 11b · City-service FAQs — white (conditional) ── -->
  {cityContent?.faqs && cityContent.faqs.length > 0 && (
    <FAQAccordion
      eyebrow="LOCAL FAQs"
      title={`Questions About ${service.name} in ${city.name}`}
      faqs={cityContent.faqs}
      bg="white"
    />
  )}

  <!-- 12 · CTA Band — dark ──────────────────────── -->
  <CtaBand
    title={`Book ${service.shortName} in ${city.name}`}
    subtitle={`Get a free quote for ${service.name.toLowerCase()} in ${city.name}. Delivery and pickup are always included.`}
    primaryCta={{ label: "Book Now", href: booqableStore }}
    secondaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    tertiaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

  <!-- 13 · Quote Form — dark ───────────────────── -->
  <QuoteForm
    heading={`Get a Free ${service.shortName} Quote in ${city.name}`}
    subheading={`Tell us about your ${city.name} event and we'll put together a custom ${service.name.toLowerCase()} package.`}
    city={city.slug}
    service={service.slug}
  />

</BaseLayout>

---
import BaseLayout from "./BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CtaBand from "../components/CtaBand.astro";
import { site, nap } from "../data/site";

export interface Props {
  title: string;
  description: string;
  publishDate: string;
  updatedDate?: string;
  author?: string;
  category: string;
  tags?: string[];
  ogImage?: string;
  slug: string;
  faqs?: { question: string; answer: string }[];
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  author = "Kelari Party Rentals",
  category,
  tags = [],
  ogImage,
  slug,
  faqs = [],
} = Astro.props;

const canonical = `${site.domain}/blog/${slug}/`;
const resolvedOgImage = ogImage ?? site.schema.image.url;

const publishDateObj = new Date(publishDate);
const updatedDateObj = updatedDate ? new Date(updatedDate) : null;

const displayDate = publishDateObj.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const schema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    author: {
      "@type": "Organization",
      name: author,
      url: site.domain,
    },
    publisher: {
      "@id": `${site.domain}/#localbusiness`,
    },
    datePublished: publishDate,
    ...(updatedDate && { dateModified: updatedDate }),
    image: { "@type": "ImageObject", url: resolvedOgImage },
    url: canonical,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonical,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${site.domain}/blog/` },
      { "@type": "ListItem", position: 3, name: title, item: canonical },
    ],
  },
];

if (faqs.length > 0) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  });
}
---

<BaseLayout
  title={`${title} | Kelari Party Rentals`}
  description={description}
  canonical={canonical}
  ogImage={resolvedOgImage}
  schema={schema}
>

  <!-- ── Article Hero ──────────────────────────────────────────────────── -->
  <div class="bg-brand-dark pt-16 pb-12 lg:pt-20 lg:pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-xs text-neutral-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-pink transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/" class="hover:text-brand-pink transition-colors">Blog</a>
        <span aria-hidden="true">/</span>
        <span class="text-neutral-300 truncate max-w-[200px]">{title}</span>
      </nav>

      <!-- Category tag -->
      <div class="mb-4">
        <span class="inline-block bg-brand-pink/20 text-brand-pink text-[0.68rem] font-bold uppercase tracking-[0.18em] px-3 py-1 rounded-full">
          {category}
        </span>
      </div>

      <!-- H1 -->
      <h1 class="font-display font-semibold text-white leading-[1.05] tracking-[-0.02em] text-[2rem] md:text-[2.6rem] lg:text-[3rem] mb-5">
        {title}
      </h1>

      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-400">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={publishDate}>{displayDate}</time>
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          {author}
        </span>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="text-neutral-500 text-xs">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- ── Article Body ───────────────────────────────────────────────────── -->
  <Section bg="white" spacing="default">
    <div class="max-w-3xl mx-auto">
      <div class="prose-blog">
        <slot />
      </div>
    </div>
  </Section>

  <!-- ── FAQ Section ───────────────────────────────────────────────────── -->
  {faqs.length > 0 && (
    <FAQAccordion
      eyebrow="FAQ"
      title="Frequently Asked Questions"
      faqs={faqs}
      bg="light"
    />
  )}

  <!-- ── CTA Band ───────────────────────────────────────────────────────── -->
  <CtaBand
    title="Ready to Plan Your Party?"
    subtitle="Professional delivery available across North County San Diego — get a quote for your event."
    primaryCta={{ label: "Book Now", href: "https://rentals.kelaripartyrentals.com" }}
    secondaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    secondaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />

</BaseLayout>

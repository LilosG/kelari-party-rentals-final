---
import BaseLayout from "./BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CtaBand from "../components/CtaBand.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";
import { site, nap, booqableStore } from "../data/site";

interface ServiceEntry {
  slug: string;
  name: string;
  href: string;
  shortDesc: string;
}
interface AreaEntry {
  slug: string;
  name: string;
  href: string;
}

const SERVICE_REGISTRY: ServiceEntry[] = [
  { slug: "backyard-party-rentals", name: "Backyard Party Rentals", href: "/services/backyard-party-rentals/", shortDesc: "Tables, chairs, linens, and accessories for backyard events of any size." },
  { slug: "birthday-party-rentals", name: "Birthday Party Rentals", href: "/services/birthday-party-rentals/", shortDesc: "Complete rental packages for birthday celebrations in North County San Diego." },
  { slug: "graduation-party-rentals", name: "Graduation Party Rentals", href: "/services/graduation-party-rentals/", shortDesc: "Graduation party rentals with delivery and pickup included." },
  { slug: "baby-shower-rentals", name: "Baby Shower Rentals", href: "/services/baby-shower-rentals/", shortDesc: "Elegant table and chair rentals for baby shower celebrations." },
  { slug: "park-party-rentals", name: "Park Party Rentals", href: "/services/park-party-rentals/", shortDesc: "USDA-permitted park event rentals across Carlsbad, Encinitas, and Oceanside." },
  { slug: "party-rentals", name: "Full Rental Inventory", href: "/rentals/", shortDesc: "Browse our complete inventory of chairs, tables, linens, and accessories." },
];

const AREA_REGISTRY: AreaEntry[] = [
  { slug: "carlsbad",   name: "Carlsbad",   href: "/carlsbad/party-rentals/" },
  { slug: "encinitas",  name: "Encinitas",  href: "/encinitas/party-rentals/" },
  { slug: "oceanside",  name: "Oceanside",  href: "/oceanside/party-rentals/" },
  { slug: "san-marcos", name: "San Marcos", href: "/service-areas/san-marcos/" },
  { slug: "vista",      name: "Vista",      href: "/service-areas/vista/" },
  { slug: "la-costa",   name: "La Costa",   href: "/carlsbad/backyard-party-rentals/" },
];

export interface Props {
  title: string;
  description: string;
  publishDate: string;
  updatedDate?: string;
  author?: string;
  category: string;
  tags?: string[];
  ogImage?: string;
  image?: string;
  imageAlt?: string;
  slug: string;
  faqs?: { question: string; answer: string }[];
  relatedServices?: string[];
  serviceAreas?: string[];
}

const {
  title, description, publishDate, updatedDate, author = "Kelari Party Rentals",
  category, tags = [], ogImage, image, imageAlt, slug, faqs = [],
  relatedServices = [], serviceAreas = [],
} = Astro.props;

const canonical = `${site.domain}/blog/${slug}/`;
const resolvedOgImage = ogImage ?? image ?? site.schema.image.url;

const displayDate = new Date(publishDate).toLocaleDateString("en-US", {
  year: "numeric", month: "long", day: "numeric",
});

const linkedServices = SERVICE_REGISTRY.filter((s) => relatedServices.includes(s.slug));
const linkedAreas = AREA_REGISTRY.filter((a) => serviceAreas.includes(a.slug));

const moneyPages = linkedAreas.flatMap((area) =>
  linkedServices.slice(0, 2).map((service) => ({
    label: `${service.name} in ${area.name}`,
    href: area.slug === "carlsbad" ? `/carlsbad/${service.slug}/` : area.href,
  }))
).slice(0, 6);

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const otherPosts = allPosts
  .filter((p) => p.id !== slug && p.id !== `${slug}.mdx` && p.id !== `${slug}.md`)
  .map((p) => {
    const overlap = (p.data.tags ?? []).filter((t) => tags.includes(t)).length;
    return { post: p, overlap };
  })
  .sort((a, b) => b.overlap - a.overlap || new Date(b.post.data.publishDate).getTime() - new Date(a.post.data.publishDate).getTime())
  .slice(0, 3)
  .map(({ post }) => post);

const schema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title, description,
    author: { "@type": "Organization", name: author, url: site.domain },
    publisher: { "@id": `${site.domain}/#localbusiness` },
    datePublished: publishDate,
    ...(updatedDate && { dateModified: updatedDate }),
    image: { "@type": "ImageObject", url: resolvedOgImage },
    url: canonical,
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.domain },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${site.domain}/blog/` },
      { "@type": "ListItem", position: 3, name: title, item: canonical },
    ],
  },
];

if (faqs.length > 0) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  });
}
---

<BaseLayout
  title={`${title} | Kelari Party Rentals`}
  description={description}
  canonical={canonical}
  ogImage={resolvedOgImage}
  schema={schema}
>
  <div class="bg-brand-dark pt-16 pb-12 lg:pt-20 lg:pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-6 flex items-center gap-2 text-xs text-neutral-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-pink transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/" class="hover:text-brand-pink transition-colors">Blog</a>
        <span aria-hidden="true">/</span>
        <span class="text-neutral-300 truncate max-w-[200px]">{title}</span>
      </nav>
      <div class="mb-4">
        <span class="inline-block bg-brand-pink/20 text-brand-pink text-[0.68rem] font-bold uppercase tracking-[0.18em] px-3 py-1 rounded-full">
          {category}
        </span>
      </div>
      <h1 class="font-display font-semibold text-white leading-[1.05] tracking-[-0.02em] text-[2rem] md:text-[2.6rem] lg:text-[3rem] mb-5">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-400">
        <span class="flex items-center gap-1.5">
          <time datetime={publishDate}>{displayDate}</time>
        </span>
        <span>{author}</span>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => <span class="text-neutral-500 text-xs">#{tag}</span>)}
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12">
      <article class="lg:col-span-8">
        {image && (
          <figure class="mb-8 overflow-hidden rounded-2xl">
            <img src={image} alt={imageAlt ?? title} class="w-full h-auto object-cover" loading="eager" width="1200" height="675" />
          </figure>
        )}
        <div class="prose-blog"><slot /></div>
        {tags.length > 0 && (
          <div class="mt-10 pt-8 border-t border-neutral-100">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-neutral-400 mb-3">Tags</p>
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => <span class="text-xs text-neutral-500 bg-neutral-50 border border-neutral-100 px-3 py-1 rounded-full">#{tag}</span>)}
            </div>
          </div>
        )}
      </article>

      <aside class="lg:col-span-4 mt-12 lg:mt-0">
        <div class="sticky top-8 space-y-6">
          <div class="bg-brand-pink/10 border border-brand-pink/20 rounded-2xl p-6">
            <h3 class="font-display font-semibold text-neutral-900 text-lg mb-2">Need rentals for your event?</h3>
            <p class="text-sm text-neutral-500 mb-4">We deliver and pick up across North County San Diego.</p>
            <a href="/quote/" class="block w-full text-center bg-brand-pink text-white font-semibold text-sm py-3 px-4 rounded-xl hover:bg-brand-pink-dark transition-colors mb-3">Get a Free Quote</a>
            <a href={`tel:${nap.contact.phone.replace(/\D/g, "")}`} class="block w-full text-center border border-brand-pink/30 text-brand-pink font-semibold text-sm py-3 px-4 rounded-xl hover:bg-brand-pink/5 transition-colors">Call {nap.contact.phone}</a>
          </div>

          {linkedServices.length > 0 && (
            <div class="bg-white border border-neutral-100 rounded-2xl p-6">
              <p class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-neutral-400 mb-3">Related Services</p>
              <ul class="space-y-2">
                {linkedServices.map((service) => (
                  <li>
                    <a href={service.href} class="flex items-start gap-2 group text-sm">
                      <svg class="w-4 h-4 mt-0.5 text-brand-pink shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                      <span>
                        <span class="font-semibold text-neutral-800 group-hover:text-brand-pink transition-colors">{service.name}</span>
                        <span class="block text-xs text-neutral-500 mt-0.5">{service.shortDesc}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {linkedAreas.length > 0 && (
            <div class="bg-white border border-neutral-100 rounded-2xl p-6">
              <p class="text-[0.65rem] font-bold uppercase tracking-[0.18em] text-neutral-400 mb-3">We Serve These Areas</p>
              <ul class="space-y-1.5">
                {linkedAreas.map((area) => (
                  <li>
                    <a href={area.href} class="flex items-center gap-2 text-sm text-neutral-600 hover:text-brand-pink transition-colors">
                      <svg class="w-3.5 h-3.5 text-brand-pink shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                      Party Rentals in {area.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>

  {moneyPages.length > 0 && (
    <Section bg="light" spacing="default" width="wide">
      <div class="text-center mb-8">
        <p class="text-[0.68rem] font-bold uppercase tracking-[0.18em] text-brand-pink mb-2">Local Service Pages</p>
        <h2 class="font-display font-semibold text-neutral-900 text-2xl md:text-3xl">Popular Rental Pages Near You</h2>
      </div>
      <div class="flex flex-wrap justify-center gap-3">
        {moneyPages.map((page) => (
          <a href={page.href} class="inline-flex items-center gap-1.5 text-sm font-semibold text-neutral-700 bg-white border border-neutral-200 px-4 py-2 rounded-full hover:border-brand-pink hover:text-brand-pink transition-colors">
            <svg class="w-3.5 h-3.5 text-brand-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            {page.label}
          </a>
        ))}
      </div>
    </Section>
  )}

  {faqs.length > 0 && (
    <FAQAccordion eyebrow="FAQ" title="Frequently Asked Questions" faqs={faqs} bg="light" />
  )}

  {otherPosts.length > 0 && (
    <Section bg="white" spacing="default" width="wide">
      <div class="mb-10 md:mb-12">
        <SectionHeader eyebrow="PARTY PLANNING RESOURCES" title="Related Articles" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {otherPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            slug={post.id}
            publishDate={post.data.publishDate}
            category={post.data.category}
            tags={post.data.tags}
            featured={post.data.featured}
            image={post.data.image}
            imageAlt={post.data.imageAlt}
          />
        ))}
      </div>
    </Section>
  )}

  <CtaBand
    title="Ready to Plan Your Party?"
    subtitle="Professional delivery available across North County San Diego — get a quote for your event."
    primaryCta={{ label: "Book Now", href: booqableStore }}
    secondaryCta={{ label: "Get a Free Quote", href: "/quote/" }}
    tertiaryCta={{ label: `Call ${nap.contact.phone}`, href: `tel:${nap.contact.phone.replace(/\D/g, "")}` }}
  />
</BaseLayout>
